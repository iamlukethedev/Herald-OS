# Maintainer: Luke The Dev <252071647+iamlukethedev@users.noreply.github.com>
#
# Herald OS from the release tarball. Not on the AUR yet: build it from the repository with makepkg -si.
# A local tarball builds too: HERALD_OS_TARBALL_URL=file:///path/herald-os-<v>-linux-x64.tar.gz makepkg -si --skipchecksums

pkgname=herald-os-bin
_version=0.1.0-alpha.5
pkgver=0.1.0alpha.5
pkgrel=1
pkgdesc='An AI-native desktop built around Hermes Agent: a niri session, or an app inside Hyprland and Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/iamlukethedev/Herald-OS'
license=('MIT')
depends=('gtk3' 'nss' 'alsa-lib' 'libsecret' 'libnotify' 'python' 'curl' 'wl-clipboard' 'wtype' 'grim' 'slurp')
optdepends=(
  'niri: the full Herald OS session (menu bar, dock, tiling)'
  'greetd: a login screen that starts the session'
  'swaybg: the wallpaper in the session'
  'swaylock: locking the session'
  'swayidle: locking and screens off when idle'
  'cliphist: clipboard history'
  'brightnessctl: the brightness keys and the display panel'
  'playerctl: the media keys'
  'networkmanager: the Wi-Fi panel'
  'bluez-utils: the Bluetooth panel'
  'libpulse: the sound panel (pactl)'
  'power-profiles-daemon: power modes in the battery panel'
  'upower: the battery panel'
  'wlsunset: night light'
  'wf-recorder: screen recording'
  'ffmpeg: converting recordings'
  'zbar: reading QR codes from the screen'
  'tesseract: copying text from the screen'
  'libheif: opening HEIC photos in Herald Canvas'
  'imagemagick: opening TIFF and camera RAW files in Herald Canvas'
  'flite: the system voice, in English, when Hermes cannot speak'
  'flatpak: installing apps from the catalog'
  'podman: the Windows VM and containers'
  'yay: AUR installs from the catalog'
)
provides=('herald-os')
conflicts=('herald-os' 'herald-os-git')
options=('!strip' '!debug')
install=herald-os.install
source=('herald-os-package.sh')
source_x86_64=("herald-os-${_version}-x64.tar.gz::${HERALD_OS_TARBALL_URL:-$url/releases/download/v${_version}/herald-os-${_version}-linux-x64.tar.gz}")
source_aarch64=("herald-os-${_version}-arm64.tar.gz::${HERALD_OS_TARBALL_URL:-$url/releases/download/v${_version}/herald-os-${_version}-linux-arm64.tar.gz}")
# From the release's .sha256 files, filled in for the tarballs once the release is built; a tarball
# of your own (HERALD_OS_TARBALL_URL) needs --skipchecksums.
sha256sums=('120a3b0922a8677c6790af4a93b04109030b5d7201bc85125b62031b152c247c')
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

# The release keys' fingerprints, those of linux/keys/herald-os-release.asc; empty until the first
# signed release (docs/RELEASE-SIGNING.md), which _version must then be at least. With them, makepkg
# checks the release's SHA256SUMS.sig, and prepare() checks it again as strictly as herald-os-tarball
# (herald-os-release-check.sh: makepkg only warns about an expired key) and then the tarball against
# SHA256SUMS. Import the key once first: gpg --import ../../../linux/keys/herald-os-release.asc
# The key file is saved as .key: makepkg takes any source named .asc, .sig or .sign for a detached
# signature of the source named without it, and would stop on the missing one.
_release_keys=()
if (( ${#_release_keys[@]} )); then
  validpgpkeys=("${_release_keys[@]}")
  source+=('herald-os-release-check.sh'
           "SHA256SUMS-${_version}::$url/releases/download/v${_version}/SHA256SUMS"
           "SHA256SUMS-${_version}.sig::$url/releases/download/v${_version}/SHA256SUMS.sig"
           "herald-os-release-key-${_version}.key::$url/releases/download/v${_version}/herald-os-release-key.asc")
  sha256sums+=('9483ea1dd0fc460df9204bd9905c213c5fdb3c7025e830f2d67c0ea49ea1a0fd' 'SKIP' 'SKIP' 'SKIP')
fi

prepare() {
  # A tarball of your own is not in the release's SHA256SUMS.
  (( ${#_release_keys[@]} )) && [[ -z ${HERALD_OS_TARBALL_URL:-} ]] || return 0
  source "$srcdir/herald-os-release-check.sh"
  _herald_os_check_release "$srcdir/SHA256SUMS-${_version}" "$srcdir/SHA256SUMS-${_version}.sig" \
    "$srcdir/herald-os-release-key-${_version}.key" "${_release_keys[@]}" || return 1
  local build=x64 expected actual
  [[ $CARCH == aarch64 ]] && build=arm64
  expected="$(awk -v name="herald-os-${_version}-linux-$build.tar.gz" '$2 == name || $2 == "*" name { print $1 }' "$srcdir/SHA256SUMS-${_version}")"
  actual="$(sha256sum "$srcdir/herald-os-${_version}-$build.tar.gz" | cut -d ' ' -f 1)"
  if [[ ! $expected =~ ^[0-9a-f]{64}$ || $expected != "$actual" ]]; then
    echo "herald-os-${_version}-linux-$build.tar.gz does not match the release's signed SHA256SUMS" >&2
    return 1
  fi
}

package() {
  source "$srcdir/herald-os-package.sh"
  _herald_os_package "$(_herald_os_appdir "$srcdir")"
}
