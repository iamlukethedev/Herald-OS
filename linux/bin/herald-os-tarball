#!/usr/bin/env python3
"""Herald OS from the release tarball (herald-os-<version>-linux-<arch>.tar.gz) unpacked in /opt/herald-os:
the pieces the Arch package lays out, and updates from the project's GitHub releases.

  sudo herald-os-tarball install    the commands and session scripts in /usr/local/bin, Herald OS on the
                                    login screen (when niri is installed) and in the application menu, the
                                    update-check user units, chrome-sandbox setuid root; safe to re-run
  sudo herald-os-tarball remove     take all of that out again (/opt/herald-os itself stays)
  herald-os-tarball status          the version in /opt/herald-os and what is in place
  herald-os-tarball check [--channel stable|edge]
                                    print the version of a newer release and exit 0; exit 1 when up to
                                    date, 2 when this is not a tarball install, 3 when GitHub cannot be asked
  sudo herald-os-tarball update [<version>]
                                    install that release (by default the newest stable one) once its
                                    signature and checksum check out; the version it replaces stays in
                                    /opt/herald-os.previous
  sudo herald-os-tarball rollback   swap /opt/herald-os and /opt/herald-os.previous

A Herald OS in /opt/herald-os that a package installed (herald-os-bin on Arch) is the package's: this
leaves it alone. HERALD_OS_DESTDIR puts everything under another folder instead of / (a staged install).

A version that carries the release key (resources/herald-os-linux/keys/herald-os-release.asc) installs
only releases whose SHA256SUMS is signed with it, or with a key it has certified (docs/RELEASE-SIGNING.md).
"""

from __future__ import annotations

import ctypes
import errno
import hashlib
import json
import os
import platform
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import time
from pathlib import Path

RELEASES_API = "https://api.github.com/repos/iamlukethedev/Herald-OS/releases?per_page=30"
SESSION_SCRIPTS = ("herald-os-session", "herald-os-compositor", "herald-os-niri-nested")
UNITS = ("herald-os-update-check.service", "herald-os-update-check.timer")
APP_ENTRY = """[Desktop Entry]
Name=Herald OS
Comment=The AI-native desktop built around Hermes Agent
Exec=herald-os-app
Icon=herald-os
Type=Application
Categories=System;Utility;
StartupWMClass=herald-os
Terminal=false
"""
# A release's .sha256 is sha256sum's line for the file as it is named on the release; its SHA256SUMS
# has one such line for every download, and SHA256SUMS.sig is a detached OpenPGP signature over it.
CHECKSUM_LINE = re.compile(r"^([0-9a-f]{64}) [ *](\S+)$")
SUMS, SUMS_SIG, KEY_ASSET = "SHA256SUMS", "SHA256SUMS.sig", "herald-os-release-key.asc"
# The release's own copy of the keys: newer subkeys and expiry dates, and a new key certified by one
# this version has. Never trusted by itself, so it only needs to be small.
KEY_ASSET_LIMIT = 1 << 20
GPG_TIMEOUT = 60
# How far check and update look back for a release that checks out, past newer ones that do not.
VERIFY_LIMIT = 5
VERIFY_BUDGET = 180
# OpenPGP certification classes (0x10 to 0x13): a key vouching for another key's user ID.
CERTIFICATION = re.compile(r"^1[0-3]x$")
# A key's validity in gpg's listing: revoked, expired, invalid or disabled.
UNUSABLE = frozenset("reid")
SEMVER = re.compile(r"^(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z.-]+))?(?:\+[0-9A-Za-z.-]+)?$")
# Every request goes over HTTPS, redirects included: GitHub sends release files on to its CDN, and
# a redirect to plain http would let anyone on the way swap the tarball and its checksum together.
CURL = ("curl", "--proto", "=https", "--proto-redir", "=https", "--fail", "--location", "--retry", "2", "--connect-timeout", "15")
# Every request has an end, so a server that stalls cannot hold check or update. The signing files
# are small: a minute and 1 MiB each, retries included. A tarball may take long on a slow line, so
# it is cut off when it stalls (under 1 KB/s for a minute) and after an hour at most.
SMALL_TIME = 60
SMALL_LIMIT = KEY_ASSET_LIMIT
TARBALL_TIME = 3600
STALL = ("--speed-limit", "1024", "--speed-time", "60")
AT_FDCWD = -100
RENAME_EXCHANGE = 2
# What renameat2 answers where the kernel, the C library or the filesystem cannot exchange two paths.
EXCHANGE_UNSUPPORTED = frozenset({errno.ENOSYS, errno.EINVAL, errno.ENOTSUP, errno.EOPNOTSUPP})


class ReleaseError(Exception):
    """A release that cannot be fetched or trusted, in one line for the person."""


def die(message: str, code: int = 1) -> "None":
    print(f"herald-os-tarball: {message}", file=sys.stderr)
    sys.exit(code)


class Layout:
    """Where a tarball install lives, under `root` (/, or HERALD_OS_DESTDIR)."""

    def __init__(self, root: Path):
        self.root = root
        self.app = root / "opt" / "herald-os"
        self.previous = root / "opt" / "herald-os.previous"
        self.linux = self.app / "resources" / "herald-os-linux"
        # The keys the version in use trusts; none in the versions from before signed releases.
        self.release_keys = self.linux / "keys" / "herald-os-release.asc"
        self.bin = root / "usr" / "local" / "bin"
        local_share = root / "usr" / "local" / "share"
        # Login screens look in /usr/share/wayland-sessions (LightDM only there); on Silverblue and other
        # ostree systems /usr is read-only, and GDM and SDDM also read /usr/local/share.
        self.session_entries = [root / "usr" / "share" / "wayland-sessions" / "herald-os.desktop", local_share / "wayland-sessions" / "herald-os.desktop"]
        self.session_entry = self.session_entries[1 if (root / "run" / "ostree-booted").exists() else 0]
        self.app_entry = local_share / "applications" / "herald-os.desktop"
        self.icon = local_share / "icons" / "hicolor" / "512x512" / "apps" / "herald-os.png"
        self.units = root / "usr" / "local" / "lib" / "systemd" / "user"


# ---------------------------------------------------------------------------------------------
# What is installed.
def read_version(app: Path) -> str | None:
    """The version in the app's package.json, inside resources/app.asar."""
    # An asar archive starts with two pickled sizes (4, then the header's), then the header: a pickled
    # JSON string (its pickle size, its length, the text). File contents follow the header.
    resources = app / "resources"
    try:
        with (resources / "app.asar").open("rb") as archive:
            _, header_size, _, text_size = struct.unpack("<4I", archive.read(16))
            entry = json.loads(archive.read(text_size))["files"]["package.json"]
            if entry.get("unpacked"):
                manifest = (resources / "app.asar.unpacked" / "package.json").read_bytes()
            else:
                archive.seek(8 + header_size + int(entry["offset"]))
                manifest = archive.read(int(entry["size"]))
        version = json.loads(manifest).get("version")
    except (OSError, ValueError, KeyError, TypeError, struct.error):
        return None
    return version if isinstance(version, str) and version else None


def owner(path: Path) -> str | None:
    """The package that owns `path` (pacman, rpm or dpkg), or None when no package does."""
    for argv in (["pacman", "-Qqo", str(path)], ["rpm", "-qf", "--qf", "%{NAME}\n", str(path)], ["dpkg-query", "-S", str(path)]):
        if not shutil.which(argv[0]):
            continue
        found = subprocess.run(argv, capture_output=True, text=True, check=False)
        if found.returncode == 0 and found.stdout.strip():
            name = found.stdout.strip().splitlines()[0]
            return name.split(":", 1)[0] if argv[0] == "dpkg-query" else name
    return None


def not_a_tarball(layout: Layout) -> str | None:
    """Why /opt/herald-os is not a release tarball this can manage, or None when it is."""
    if not (layout.app / "resources" / "app.asar").is_file() or not (layout.linux / "bin").is_dir():
        return f"there is no Herald OS release tarball unpacked in {layout.app} (docs/LINUX.md)"
    if layout.app.is_symlink():
        return f"{layout.app} is a link; update the folder it points to by hand"
    package = owner(layout.app / "herald-os")
    if package:
        return f"Herald OS in {layout.app} comes from the {package} package; update or remove it with the package (on Arch, makepkg -si in packaging/arch/herald-os-bin)"
    return None


def wanted_links(layout: Layout) -> dict[str, Path]:
    """Name in /usr/local/bin -> what it links to: every command, and the session scripts."""
    targets = {path.name: path for path in sorted((layout.linux / "bin").iterdir()) if path.is_file()}
    for name in SESSION_SCRIPTS:
        targets[name] = layout.linux / "session" / name
    return targets


def points_into(path: Path, folder: Path) -> bool:
    return path.is_symlink() and os.readlink(path).startswith(f"{folder}/")


# ---------------------------------------------------------------------------------------------
# Installing and removing the system pieces.
def link(path: Path, target: Path) -> None:
    staging = path.with_name(f".{path.name}.herald-os-new")
    staging.unlink(missing_ok=True)
    staging.symlink_to(target)
    staging.replace(path)


def put(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    staging = path.with_name(f".{path.name}.herald-os-new")
    staging.write_bytes(data)
    staging.chmod(0o644)
    staging.replace(path)


def setuid_sandbox(app: Path) -> None:
    """Chromium's sandbox helper must be setuid root where unprivileged user namespaces are off."""
    sandbox = app / "chrome-sandbox"
    if sandbox.is_file():
        if os.geteuid() == 0:
            os.chown(sandbox, 0, 0)
        sandbox.chmod(0o4755)


def install(layout: Layout) -> int:
    targets = wanted_links(layout)
    taken = [layout.bin / name for name in targets if (layout.bin / name).is_symlink() or (layout.bin / name).exists()]
    foreign = [path for path in taken if not points_into(path, layout.app)]
    if foreign:
        die("these are not links into " + str(layout.app) + ", so nothing was changed; move them aside and run this again:\n  " + "\n  ".join(map(str, foreign)))
    layout.bin.mkdir(parents=True, exist_ok=True)
    for name, target in targets.items():
        link(layout.bin / name, target)
    # Commands this version no longer has.
    for path in layout.bin.glob("herald-os*"):
        if points_into(path, layout.app) and not path.exists():
            path.unlink()

    niri = shutil.which("niri")
    if niri:
        put(layout.session_entry, (layout.linux / "session" / "herald-os.desktop").read_bytes())
    else:
        for entry in layout.session_entries:
            entry.unlink(missing_ok=True)
    put(layout.app_entry, APP_ENTRY.encode())
    icon = layout.app / "resources" / "icons" / "herald-os.png"
    if icon.is_file():
        put(layout.icon, icon.read_bytes())
    for unit in UNITS:
        put(layout.units / unit, (layout.linux / "session" / unit).read_bytes())
    setuid_sandbox(layout.app)

    print(f"Herald OS {read_version(layout.app) or '(unknown version)'} is set up from {layout.app}:")
    print(f"  commands      {len(targets)} links in {layout.bin}")
    if niri:
        print(f"  login screen  {layout.session_entry}")
    else:
        print("  login screen  not added: the full session needs niri (docs/LINUX.md lists what else it uses);")
        print("                install it, then run sudo herald-os-tarball install again")
    print(f"  app menu      {layout.app_entry} (herald-os-app)")
    print("Next, once for every account that uses it: herald-os setup")
    return 0


def remove(layout: Layout) -> int:
    gone = [path for path in sorted(layout.bin.glob("herald-os*")) if points_into(path, layout.app)] if layout.bin.is_dir() else []
    gone += [path for path in (*layout.session_entries, layout.app_entry, layout.icon, *(layout.units / unit for unit in UNITS)) if path.exists()]
    for path in gone:
        path.unlink()
    print(f"Removed {len(gone)} files: the commands in {layout.bin}, the login-screen and application-menu entries, the user units.")
    print(f"Herald OS itself is still in {layout.app}; `sudo rm -rf {layout.app} {layout.previous}` deletes it.")
    print("Each account keeps its settings in ~/.config/herald-os and ~/.local/state/herald-os.")
    return 0


def status(layout: Layout) -> int:
    problem = not_a_tarball(layout)
    if problem:
        print(problem)
        return 2
    print(f"Herald OS {read_version(layout.app) or '(unknown version)'}, from the release tarball in {layout.app}")
    targets = wanted_links(layout)
    linked = sum(points_into(layout.bin / name, layout.app) for name in targets)
    print(f"  commands      {linked} of {len(targets)} linked in {layout.bin}")
    entry = next((path for path in layout.session_entries if path.exists()), None)
    print(f"  login screen  {entry or 'not added (needs niri, then sudo herald-os-tarball install)'}")
    print(f"  app menu      {layout.app_entry if layout.app_entry.exists() else 'not added'}")
    if (layout.previous / "resources" / "app.asar").is_file():
        print(f"  previous      {read_version(layout.previous) or '(unknown version)'} in {layout.previous} (herald-os rollback)")
    return 0


# ---------------------------------------------------------------------------------------------
# Releases.
def version_key(version: str) -> tuple | None:
    """SemVer precedence: a release sorts after its pre-releases, numeric identifiers before words."""
    match = SEMVER.match(version)
    if not match:
        return None
    major, minor, patch, pre = match.groups()
    identifiers = tuple((0, int(part), "") if part.isdigit() else (1, 0, part) for part in pre.split(".")) if pre else ()
    return (int(major), int(minor), int(patch), 0 if pre else 1, identifiers)


def is_newer(candidate: str, installed: str | None) -> bool:
    new = version_key(candidate)
    old = version_key(installed) if installed else None
    return new is not None and (old is None or new > old)


def machine_arch() -> str | None:
    """This machine in the release's file names (electron-builder's x64 and arm64)."""
    return {"x86_64": "x64", "amd64": "x64", "aarch64": "arm64", "arm64": "arm64"}.get(platform.machine().lower())


def releases() -> list[dict]:
    """The repository's published releases, newest first (GitHub's API lists drafts only to the owner)."""
    found = subprocess.run([*CURL, "-sS", "--max-time", "60", "-H", "Accept: application/vnd.github+json", RELEASES_API], capture_output=True, text=True, check=False)
    if found.returncode != 0:
        raise ReleaseError(found.stderr.strip() or f"curl exited with {found.returncode}")
    try:
        listing = json.loads(found.stdout)
    except ValueError as exc:
        raise ReleaseError(f"GitHub's answer is not JSON ({exc})") from exc
    if not isinstance(listing, list):
        raise ReleaseError("GitHub's answer is not a list of releases")
    return listing


def candidates(listing: list[dict], arch: str, channel: str = "stable", version: str | None = None, signed: bool = False) -> list[dict]:
    """The releases that could be installed, newest first: `version` exactly, or any with a tarball for
    `arch` (pre-releases only on the edge channel). Without the release key a release also needs the
    tarball's .sha256, as it always has; with it, whether a release is signed is judged by checking
    its signature (`verified`), so a release without one is refused by name rather than passed over."""
    found: list[dict] = []
    for release in listing:
        tag = str(release.get("tag_name") or "")
        number = tag[1:] if tag.startswith("v") else tag
        if release.get("draft") or version_key(number) is None:
            continue
        if version is not None and number != version:
            continue
        if version is None and release.get("prerelease") and channel != "edge":
            continue
        name = f"herald-os-{number}-linux-{arch}.tar.gz"
        assets = {asset.get("name"): asset for asset in release.get("assets") or [] if isinstance(asset, dict)}
        if name not in assets or (not signed and f"{name}.sha256" not in assets):
            continue
        url = lambda asset: str(assets[asset].get("browser_download_url") or "") if asset in assets else ""
        found.append({
            "version": number,
            "name": name,
            "url": url(name),
            "checksum_url": url(f"{name}.sha256"),
            "sums_url": url(SUMS),
            "sig_url": url(SUMS_SIG),
            "key_url": url(KEY_ASSET),
            "size": int(assets[name].get("size") or 0),
        })
    return sorted(found, key=lambda release: version_key(release["version"]), reverse=True)


def pick_release(listing: list[dict], arch: str, channel: str = "stable", version: str | None = None, signed: bool = False) -> dict | None:
    """The newest of `candidates`, unchecked."""
    found = candidates(listing, arch, channel, version, signed)
    return found[0] if found else None


def verified(layout: Layout, found: list[dict], installed: str | None) -> tuple[dict | None, list[str]]:
    """The newest release in `found` newer than `installed` whose SHA256SUMS is signed with a key the
    version in use trusts and lists its tarball, and why each newer one before it was passed over. Only
    the small signing files are downloaded, into a folder that is deleted; the release comes back with
    the SHA256SUMS that was checked ("checked_sums") and its signer, for the update to use as they are.
    At most VERIFY_LIMIT releases are tried, and none is started after VERIFY_BUDGET seconds."""
    skipped: list[str] = []
    newer = [release for release in found if is_newer(release["version"], installed)]
    started = time.monotonic()
    for tried, release in enumerate(newer):
        if tried == VERIFY_LIMIT or time.monotonic() - started > VERIFY_BUDGET:
            skipped.append(f"{len(newer) - tried} more newer releases were not tried (at most {VERIFY_LIMIT}, within {VERIFY_BUDGET} s)")
            break
        with tempfile.TemporaryDirectory(prefix="herald-os-check-") as folder:
            sums = Path(folder) / SUMS
            try:
                signer = checked_signature(layout, release, Path(folder), sums, quiet=True, deadline=started + VERIFY_BUDGET)
                listed_checksum(sums, release["name"])
            except ReleaseError as exc:
                skipped.append(f"{release['version']}: {exc}")
                continue
            return {**release, "checked_sums": sums.read_bytes(), "signer": signer}, skipped
    return None, skipped


def download(url: str, target: Path, small: bool = False, deadline: float | None = None) -> None:
    """Fetch `url` into `target` over HTTPS only. A small file (SHA256SUMS, its signature, the key file)
    gets SMALL_TIME and SMALL_LIMIT, and no more time than is left before `deadline` (time.monotonic())."""
    if not url.startswith("https://"):
        raise ReleaseError(f"could not download {url} over HTTPS")
    if small:
        seconds = SMALL_TIME if deadline is None else min(SMALL_TIME, int(deadline - time.monotonic()))
        if seconds < 1:
            raise ReleaseError("ran out of time checking releases; nothing was changed")
        limits = ["--max-time", str(seconds), "--retry-max-time", str(seconds), "--max-filesize", str(SMALL_LIMIT)]
    else:
        limits = ["--max-time", str(TARBALL_TIME), *STALL]
    progress = ["--progress-bar"] if sys.stderr.isatty() and not small else ["-sS"]
    if subprocess.call([*CURL, *progress, *limits, "-o", str(target), url]) != 0:
        raise ReleaseError(f"could not download {url} over HTTPS")
    # --max-filesize cannot stop a transfer that does not say its size up front.
    if small and target.stat().st_size > SMALL_LIMIT:
        raise ReleaseError(f"{url} is too big to be a signing file; nothing was changed")


def listed_checksum(checksum: Path, name: str) -> str:
    """The SHA-256 that `checksum` (a .sha256 or a SHA256SUMS) gives for `name`: exactly one line for it,
    and every line in sha256sum's format."""
    found: set[str] = set()
    for line in checksum.read_text(errors="replace").splitlines():
        if not line.strip():
            continue
        match = CHECKSUM_LINE.match(line.strip())
        if not match:
            raise ReleaseError(f"{checksum.name} is not a list of checksums; nothing was changed")
        if match.group(2) == name:
            found.add(match.group(1))
    if len(found) != 1:
        raise ReleaseError(f"{checksum.name} does not give one checksum for {name}; nothing was changed")
    return found.pop()


def verify(tarball: Path, checksum: Path) -> None:
    """The tarball is the one the release's .sha256 or SHA256SUMS names, byte for byte."""
    expected = listed_checksum(checksum, tarball.name)
    digest = hashlib.sha256()
    with tarball.open("rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    if digest.hexdigest() != expected:
        raise ReleaseError(f"{tarball.name} does not match its published checksum; nothing was changed")


def gpg_records(output: str, kind: str) -> list[list[str]]:
    return [line.split(":") for line in output.splitlines() if line.startswith(f"{kind}:")]


def primary_keys(listing: str) -> dict[str, list[list[str]]]:
    """Each primary key's fingerprint in a --with-colons listing, with the records of its block."""
    keys: dict[str, list[list[str]]] = {}
    block: list[list[str]] | None = None
    for line in listing.splitlines():
        fields = line.split(":")
        if fields[0] == "pub":
            block = [fields]
        elif block is not None and fields[0] == "fpr" and block[-1][0] == "pub":
            keys[fields[9]] = block
        elif block is not None:
            block.append(fields)
    return keys


def verify_signature(sums: Path, signature: Path, pinned: Path, offered: Path | None = None, deadline: float | None = None) -> str:
    """Check that `signature` is a good OpenPGP signature over `sums` by a key in `pinned` (the release
    keys of the version in use), or by a key in `offered` (the release's own key file) that one of them
    has certified. Returns the signing key's primary fingerprint. Works in a keyring of its own, which
    it deletes, so neither the person's keys nor their trust settings come into it."""
    gpg = shutil.which("gpg")
    if not gpg:
        raise ReleaseError("checking the release's signature needs gpg (the gnupg package; gpg on Debian and Ubuntu); install it and run this again. Nothing was changed")
    home = Path(tempfile.mkdtemp(prefix="herald-os-gpg-"))

    def run(*args: str) -> subprocess.CompletedProcess:
        argv = [gpg, "--batch", "--no-options", "--no-autostart", "--no-auto-key-retrieve", "--homedir", str(home), *args]
        seconds = GPG_TIMEOUT if deadline is None else min(GPG_TIMEOUT, deadline - time.monotonic())
        if seconds <= 0:
            raise ReleaseError("ran out of time checking releases; nothing was changed")
        try:
            return subprocess.run(argv, capture_output=True, text=True, timeout=seconds, check=False)
        except subprocess.TimeoutExpired as exc:
            raise ReleaseError(f"gpg did not finish in {seconds:.0f} s; nothing was changed") from exc

    try:
        if run("--import", str(pinned)).returncode != 0:
            raise ReleaseError(f"the release keys in {pinned} cannot be read; nothing was changed")
        pinned_keys = frozenset(primary_keys(run("--with-colons", "--fixed-list-mode", "--list-keys").stdout))
        if not pinned_keys:
            raise ReleaseError(f"{pinned} holds no key; nothing was changed")
        if offered is not None:
            # Whatever does not import cleanly is simply not there for the checks below.
            run("--import", str(offered))
        # Judged after both files are in: a revocation or expiry in either one counts.
        keys = primary_keys(run("--with-colons", "--fixed-list-mode", "--check-signatures").stdout)
        usable = frozenset(key for key in pinned_keys if key in keys and keys[key][0][1] not in UNUSABLE)
        if not usable:
            raise ReleaseError("every release key this version trusts has been revoked or has expired, so it installs nothing until a release brings a new key it can check; nothing was changed")
        trusted = set(usable)
        for fingerprint, block in keys.items():
            if fingerprint in pinned_keys or block[0][1] in UNUSABLE:
                continue
            # Only a usable pinned key vouches, by its full fingerprint (a 64-bit key ID in a key file
            # anyone can write could belong to a key made to collide with one of ours), and not once
            # it has revoked that certification. A key it certified does not pass that on.
            revoked = {fields[12] for fields in block if fields[0] == "rev" and fields[1] == "!" and len(fields) > 12 and fields[10].startswith("30")}
            if any(
                fields[0] == "sig" and fields[1] == "!" and len(fields) > 12 and CERTIFICATION.match(fields[10])
                and fields[12] in usable and fields[12] not in revoked
                for fields in block
            ):
                trusted.add(fingerprint)
        # Counted in the file itself, to name the refusal: gpg's report stops early at a bad signature,
        # which is refused anyway, so only the message depends on it.
        packets = sum(line.startswith(":signature packet:") for line in run("--list-packets", str(signature)).stdout.splitlines())
        checked = run("--status-fd", "1", "--verify", str(signature), str(sums))
        status = [fields[1:] for fields in (line.split() for line in checked.stdout.splitlines()) if len(fields) > 1 and fields[0] == "[GNUPG:]"]
        kinds = [fields[0] for fields in status]
        valid = [fields for fields in status if fields[0] == "VALIDSIG"]
        signer = valid[0][10] if valid and len(valid[0]) > 10 else ""
        # One signature only: with several, which of gpg's lines belong to which is not ours to guess.
        single = kinds.count("NEWSIG") == 1 and kinds.count("GOODSIG") == 1 and len(valid) == 1
        if checked.returncode == 0 and single and signer in trusted:
            return signer
        if packets > 1 or kinds.count("NEWSIG") > 1:
            reason = "carries more than one signature"
        elif "BADSIG" in kinds:
            reason = "does not match its signature: it was changed after it was signed"
        elif "EXPKEYSIG" in kinds or "REVKEYSIG" in kinds:
            reason = f"is signed with a release key that has {'expired' if 'EXPKEYSIG' in kinds else 'been revoked'}"
        elif "NO_PUBKEY" in kinds or "ERRSIG" in kinds or (signer and signer not in trusted):
            reason = "is signed with a key this version does not trust"
        else:
            reason = "has no signature that gpg can check"
        raise ReleaseError(f"the release's {SUMS} {reason}; nothing was changed")
    finally:
        shutil.rmtree(home, ignore_errors=True)


def spaced(fingerprint: str) -> str:
    return " ".join(fingerprint[i:i + 4] for i in range(0, len(fingerprint), 4))


def tree_size(folder: Path) -> int:
    return sum(path.stat().st_size for path in folder.rglob("*") if path.is_file() and not path.is_symlink()) if folder.is_dir() else 0


def exchange(first: Path, second: Path) -> None:
    """Swap two paths in one step (Linux's renameat2 with RENAME_EXCHANGE), so neither is ever missing.
    Raises OSError with an errno in EXCHANGE_UNSUPPORTED where this system cannot."""
    renameat2 = getattr(ctypes.CDLL(None, use_errno=True), "renameat2", None)
    if renameat2 is None:
        raise OSError(errno.ENOSYS, "renameat2 is not available")
    renameat2.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint)
    if renameat2(AT_FDCWD, os.fsencode(first), AT_FDCWD, os.fsencode(second), RENAME_EXCHANGE) != 0:
        code = ctypes.get_errno()
        raise OSError(code, os.strerror(code), str(first), None, str(second))


def swap_by_renames(first: Path, second: Path, parked: Path) -> None:
    """``exchange`` where it is unsupported: three renames through ``parked``, each undone when a later
    one fails. ``first`` is missing between the first two."""
    shutil.rmtree(parked, ignore_errors=True)
    first.rename(parked)
    try:
        second.rename(first)
    except OSError:
        parked.rename(first)
        raise
    try:
        parked.rename(second)
    except OSError:
        first.rename(second)
        parked.rename(first)
        raise


def put_in_place(layout: Layout, new: Path) -> Path:
    """``new`` becomes /opt/herald-os and the version it replaces /opt/herald-os.previous, which must not
    exist. One exchange where the system allows it, otherwise two renames (the first undone if the
    second fails). Returns where the replaced version ended up: ``new`` when it could not be moved on."""
    try:
        exchange(new, layout.app)
    except OSError as exc:
        if exc.errno not in EXCHANGE_UNSUPPORTED:
            raise
        layout.app.rename(layout.previous)
        try:
            new.rename(layout.app)
        except OSError:
            layout.previous.rename(layout.app)
            raise
        return layout.previous
    try:
        new.rename(layout.previous)
    except OSError as exc:
        print(f"  the version it replaced stays in {new} ({exc.strerror}); herald-os rollback looks for it in {layout.previous}")
        return new
    return layout.previous


def whereabouts(layout: Layout, *others: Path) -> str:
    """Where each version is now, for the message after a step failed."""
    found = [(path, read_version(path) or "an unknown version") for path in (layout.app, layout.previous, *others) if (path / "resources" / "app.asar").is_file()]
    if not found:
        return f"no Herald OS is left in {layout.app.parent}"
    text = "Herald OS " + ", ".join(f"{version} is in {path}" for path, version in found)
    if found[0][0] != layout.app:
        text += f", and nothing is in {layout.app}: sudo mv {found[0][0]} {layout.app} puts it back"
    return text


def reinstall(layout: Layout) -> int:
    """The install step of the version now in place (its own commands and entries), or this one's when
    that version has no herald-os-tarball."""
    tool = layout.linux / "bin" / "herald-os-tarball"
    if tool.is_file():
        return subprocess.call([sys.executable, str(tool), "install"], env={**os.environ, "HERALD_OS_DESTDIR": str(layout.root)})
    return install(layout)


def check(layout: Layout, channel: str) -> int:
    problem = not_a_tarball(layout)
    if problem:
        if (layout.app / "resources" / "app.asar").is_file():
            print(f"herald-os-tarball: {problem}", file=sys.stderr)
        return 2
    arch = machine_arch()
    if not arch:
        print(f"herald-os-tarball: Herald OS releases are built for x86_64 and aarch64, not {platform.machine()}", file=sys.stderr)
        return 3
    signed = layout.release_keys.is_file()
    if signed and not shutil.which("gpg"):
        print("herald-os-tarball: checking release signatures needs gpg (the gnupg package; gpg on Debian and Ubuntu)", file=sys.stderr)
        return 3
    try:
        found = candidates(releases(), arch, channel, signed=signed)
    except ReleaseError as exc:
        print(f"herald-os-tarball: could not ask GitHub for releases: {exc}", file=sys.stderr)
        return 3
    installed = read_version(layout.app)
    if signed:
        # The newest release this version would install, so the update that follows can succeed.
        release, skipped = verified(layout, found, installed)
        for note in skipped:
            print(f"herald-os-tarball: passed over {note}", file=sys.stderr)
    else:
        release = found[0] if found else None
    if release and is_newer(release["version"], installed):
        print(release["version"])
        return 0
    return 1


def checked_signature(layout: Layout, release: dict, staging: Path, sums: Path, quiet: bool = False, deadline: float | None = None) -> str:
    """Download the release's SHA256SUMS into `sums` and check its signature, before anything else of
    the release is trusted or downloaded."""
    if not release["sums_url"] or not release["sig_url"]:
        missing = SUMS if not release["sums_url"] else SUMS_SIG
        raise ReleaseError(f"Herald OS {release['version']} is not signed (the release has no {missing}), and this version only installs signed releases; nothing was changed")
    signature = staging / SUMS_SIG
    download(release["sums_url"], sums, small=True, deadline=deadline)
    download(release["sig_url"], signature, small=True, deadline=deadline)
    offered = None
    if release["key_url"]:
        offered = staging / KEY_ASSET
        download(release["key_url"], offered, small=True, deadline=deadline)
        if offered.stat().st_size > KEY_ASSET_LIMIT:
            raise ReleaseError(f"the release's {KEY_ASSET} is too big to be a key file; nothing was changed")
    signer = verify_signature(sums, signature, layout.release_keys, offered, deadline=deadline)
    if not quiet:
        print(f"  {SUMS} is signed with the release key {spaced(signer)}")
    return signer


def update(layout: Layout, version: str | None = None) -> int:
    arch = machine_arch()
    if not arch:
        die(f"Herald OS releases are built for x86_64 and aarch64, not {platform.machine()}")
    signed = layout.release_keys.is_file()
    try:
        found = candidates(releases(), arch, version=version, signed=signed)
    except ReleaseError as exc:
        die(f"could not ask GitHub for releases: {exc}")
    if not found:
        die(f"no release {'v' + version if version else ''} has a tarball and checksum for {arch}")
    release = found[0]
    installed = read_version(layout.app)
    if signed and version is None and is_newer(release["version"], installed):
        # The newest release whose signature checks out, not merely the newest, with the SHA256SUMS
        # that was checked, which the tarball is then checked against.
        release, skipped = verified(layout, found, installed)
        if release is None:
            die("no newer release could be checked against the release key, so nothing was changed:\n  " + "\n  ".join(skipped))
    if version is None and not is_newer(release["version"], installed):
        print(f"Herald OS {installed} is up to date")
        return 0
    print(f"==> Herald OS {release['version']} ({release['name']}), replacing {installed or 'an unknown version'}")
    # The download and the new version need room beside the version in use; the version before it
    # (the rollback) goes early only when that room is short.
    need = max(release["size"], 150 << 20) * 5
    free = shutil.disk_usage(layout.app.parent).free
    if free < need:
        if free + tree_size(layout.previous) < need:
            die(f"the update needs about {need >> 20} MB free in {layout.app.parent}, and there are {free >> 20} MB")
        shutil.rmtree(layout.previous, ignore_errors=True)
    # Unpacked next to /opt/herald-os: the same filesystem, so the swap moves nothing, and the same
    # SELinux labels as a tarball unpacked there by hand.
    staging = Path(tempfile.mkdtemp(prefix=".herald-os-update-", dir=layout.app.parent))
    tarball, unpacked = staging / release["name"], staging / "herald-os"
    checksum = staging / (SUMS if layout.release_keys.is_file() else f"{release['name']}.sha256")
    replaced: Path | None = None
    try:
        if "checked_sums" in release:
            # Exactly the SHA256SUMS whose signature was checked: fetching it again could bring another.
            checksum.write_bytes(release["checked_sums"])
            print(f"  {SUMS} is signed with the release key {spaced(release['signer'])}")
        elif layout.release_keys.is_file():
            checked_signature(layout, release, staging, checksum)
        else:
            # Versions from before signed releases carry no key, so they check what they always did.
            download(release["checksum_url"], checksum, small=True)
        download(release["url"], tarball)
        verify(tarball, checksum)
        print("  the checksum matches; unpacking")
        unpacked.mkdir()
        unpacked.chmod(0o755)
        if subprocess.call(["tar", "-xzf", str(tarball), "-C", str(unpacked), "--strip-components=1", "--no-same-owner"]) != 0:
            raise ReleaseError(f"could not unpack {tarball.name}")
        if read_version(unpacked) != release["version"] or not (unpacked / "herald-os").is_file() or not (unpacked / "resources" / "herald-os-linux" / "bin").is_dir():
            raise ReleaseError(f"{tarball.name} does not hold Herald OS {release['version']}")
        setuid_sandbox(unpacked)
        shutil.rmtree(layout.previous, ignore_errors=True)
        if layout.previous.exists():
            raise ReleaseError(f"could not clear {layout.previous} for the version in use")
        replaced = put_in_place(layout, unpacked)
    except (ReleaseError, OSError) as exc:
        die(f"{exc}; {whereabouts(layout)}")
    finally:
        if replaced == unpacked:
            for path in (tarball, checksum, staging / SUMS_SIG, staging / KEY_ASSET):
                path.unlink(missing_ok=True)
        else:
            shutil.rmtree(staging, ignore_errors=True)
    reinstall(layout)
    note = " (herald-os rollback goes back)" if replaced == layout.previous else ""
    print(f"Herald OS {release['version']} is in {layout.app}; {installed or 'the version before'} stays in {replaced}{note}.")
    print("Log out and back in, or restart herald-os-app, to use it.")
    return 0


def rollback(layout: Layout) -> int:
    if not (layout.previous / "resources" / "app.asar").is_file():
        die(f"there is no earlier version in {layout.previous} to go back to")
    current, previous = read_version(layout.app), read_version(layout.previous)
    parked = layout.app.with_name(".herald-os.rollback")
    try:
        try:
            exchange(layout.app, layout.previous)
        except OSError as exc:
            if exc.errno not in EXCHANGE_UNSUPPORTED:
                raise
            swap_by_renames(layout.app, layout.previous, parked)
    except OSError as exc:
        die(f"could not swap the versions ({exc.strerror or exc}); {whereabouts(layout, parked)}")
    reinstall(layout)
    print(f"Herald OS {previous or '(unknown version)'} is back in {layout.app}; {current or 'the newer one'} is in {layout.previous}.")
    newer_tool = layout.previous / "resources" / "herald-os-linux" / "bin" / "herald-os-tarball"
    if not (layout.linux / "bin" / "herald-os-tarball").is_file() and newer_tool.is_file():
        print(f"That version has no herald-os-tarball: to return, run sudo {newer_tool} rollback")
    print("Log out and back in, or restart herald-os-app, to use it.")
    return 0


# ---------------------------------------------------------------------------------------------
def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, args = argv[0], argv[1:]
    layout = Layout(Path(os.environ.get("HERALD_OS_DESTDIR") or "/"))
    if cmd == "status":
        return status(layout)
    if cmd == "check":
        channel = args[1] if args[:1] == ["--channel"] and len(args) > 1 else "stable"
        if channel not in ("stable", "edge") or args not in ([], ["--channel", channel]):
            die("check [--channel stable|edge]", 2)
        return check(layout, channel)
    if cmd not in ("install", "remove", "update", "rollback"):
        die(f"unknown command {cmd!r} (see herald-os-tarball --help)", 2)
    if layout.root == Path("/") and os.geteuid() != 0:
        die(f"{cmd} changes {layout.app} and /usr/local: run it with sudo", 2)
    problem = not_a_tarball(layout)
    if problem:
        die(problem, 2)
    if cmd == "install":
        return install(layout)
    if cmd == "remove":
        return remove(layout)
    if cmd == "update":
        if len(args) > 1 or (args and version_key(args[0]) is None):
            die("update [<version>], e.g. update 0.1.0-alpha.2", 2)
        return update(layout, args[0] if args else None)
    return rollback(layout)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
