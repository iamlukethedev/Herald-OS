# ---------------------------------------------------------------------------------------------
def die(message: str, code: int = 1) -> "None":
    print(f"herald-os: {message}", file=sys.stderr)
    sys.exit(code)


def sh(argv: list[str], *, timeout: float = 60, check: bool = False, input_: str | None = None, capture: bool = True) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(argv, capture_output=capture, text=True, timeout=timeout, check=check, input=input_)
    except FileNotFoundError:
        die(f"{argv[0]} is not installed", 127)
    except subprocess.TimeoutExpired:
        die(f"{argv[0]} timed out after {timeout:.0f}s", 124)
    return subprocess.CompletedProcess(argv, 1)  # unreachable, keeps type checkers calm


def relay(cmd: str, args: list[str], extra: dict | None = None, *, quiet: bool = False, timeout: float = 15) -> dict:
    """Send one JSON line to the shell and return its JSON reply."""
    if not SOCKET.exists():
        if quiet:
            return {"ok": False, "error": "shell not running"}
        die(f"the Herald OS shell is not running (no {SOCKET})", 3)
    payload = {"cmd": cmd, "args": args, **(extra or {})}
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(timeout)
            s.connect(str(SOCKET))
            s.sendall((json.dumps(payload) + "\n").encode())
            buf = b""
            while not buf.endswith(b"\n"):
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
    except OSError as exc:
        if quiet:
            return {"ok": False, "error": str(exc)}
        die(f"cannot talk to the shell: {exc}", 3)
    try:
        return json.loads(buf.decode() or "{}")
    except json.JSONDecodeError:
        return {"ok": False, "error": f"bad reply: {buf[:200]!r}"}


def notify(title: str, body: str = "") -> None:
    """Notification through the shell; falls back to notify-send when the shell is down."""
    reply = relay("notify", [title, body], quiet=True)
    if not reply.get("ok") and shutil.which("notify-send"):
        subprocess.run(["notify-send", title, body], check=False)


def niri(*action: str) -> int:
    if not shutil.which("niri"):
        die("niri is not installed", 2)
    return subprocess.call(["niri", "msg", "action", *action])


def compositor() -> str | None:
    """The compositor this session runs under, from the socket each one advertises."""
    if os.environ.get("NIRI_SOCKET"):
        return "niri"
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return "hyprland"
    return None


# The niri actions Herald's own binds and docs use, as Hyprland dispatchers.
HYPR_ACTIONS = {
    "close-window": ["killactive"],
    "fullscreen-window": ["fullscreen", "0"],
    "maximize-column": ["fullscreen", "1"],
    "toggle-window-floating": ["togglefloating"],
    "focus-column-left": ["movefocus", "l"],
    "focus-column-right": ["movefocus", "r"],
    "focus-window-up": ["movefocus", "u"],
    "focus-window-down": ["movefocus", "d"],
    "close-focused-window": ["killactive"],
}

# The same, for a Lua config (Hyprland 0.55+, Omarchy 4), which takes only Lua dispatchers.
HYPR_LUA = {
    "close-window": "hl.dsp.window.close()",
    "fullscreen-window": 'hl.dsp.window.fullscreen({ mode = "fullscreen" })',
    "maximize-column": 'hl.dsp.window.fullscreen({ mode = "maximized" })',
    "toggle-window-floating": 'hl.dsp.window.float({ action = "toggle" })',
    "focus-column-left": 'hl.dsp.focus({ direction = "l" })',
    "focus-column-right": 'hl.dsp.focus({ direction = "r" })',
    "focus-window-up": 'hl.dsp.focus({ direction = "u" })',
    "focus-window-down": 'hl.dsp.focus({ direction = "d" })',
    "close-focused-window": "hl.dsp.window.close()",
}


def lua_string(text: str) -> str:
    """A Lua string literal (pure; tested)."""
    escaped = text.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
    return '"' + re.sub(r"[\x00-\x1f]", "", escaped) + '"'


def hypr_dispatches(name: str, rest: list[str]) -> tuple[str | None, list[str]]:
    """The Lua and the classic dispatcher for a `wm` action (pure; tested)."""
    if name in ("focus-workspace", "workspace") and rest:
        ref = rest[0] if rest[0].lstrip("+-").isdigit() or name == "workspace" else f"name:{rest[0]}"
        return f"hl.dsp.focus({{ workspace = {lua_string(ref)} }})", ["workspace", ref]
    if name == "exec" and rest:
        return f"hl.dsp.exec_cmd({lua_string(' '.join(rest))})", ["exec", *rest]
    if name in HYPR_ACTIONS:
        return HYPR_LUA[name], HYPR_ACTIONS[name]
    # Anything else goes as given: a classic dispatcher, or a Lua one (`hl.dsp.…`).
    raw = [name, *rest]
    return (" ".join(raw) if name.startswith("hl.") else None), raw


def wm(*action: str) -> int:
    """`herald-os wm <action>`: niri actions on niri; on Hyprland, the same names mapped to dispatchers
    (or a raw dispatcher, e.g. `wm workspace 3`)."""
    if compositor() == "hyprland":
        if not shutil.which("hyprctl"):
            die("hyprctl is not installed", 2)
        lua, classic = hypr_dispatches(action[0], list(action[1:]))
        # Lua first: under hyprland.conf it is an unknown dispatcher, so nothing happens twice.
        first = ""
        for args in ([[lua]] if lua else []) + [classic]:
            done = subprocess.run(["hyprctl", "dispatch", *args], capture_output=True, text=True)
            if done.returncode == 0 and done.stdout.strip() == "ok":
                return 0
            first = first or (done.stdout.strip() or done.stderr.strip())
        print(first or "hyprctl failed", file=sys.stderr)
        return 1
    return niri(*action)


def slugify(name: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "webapp"


# ---------------------------------------------------------------------------------------------
# Software.
def looks_like_flatpak_id(name: str) -> bool:
    return name.count(".") >= 2 and " " not in name


def flatpak_ready() -> bool:
    if not shutil.which("flatpak"):
        return False
    remotes = sh(["flatpak", "remotes", "--columns=name"], timeout=20).stdout.split()
    if "flathub" not in remotes:
        sh(["flatpak", "remote-add", "--user", "--if-not-exists", "flathub", "https://dl.flathub.org/repo/flathub.flatpakrepo"], timeout=120)
    return True


def flatpak_search(name: str) -> list[tuple[str, str]]:
    """Flathub matches for a human name, as (app id, name) pairs."""
    if not flatpak_ready():
        return []
    result = sh(["flatpak", "search", "--columns=application,name", name], timeout=120)
    rows = [line.split("\t") for line in result.stdout.splitlines() if "\t" in line]
    return [(row[0].strip(), row[1].strip()) for row in rows]


def flatpak_resolve(name: str) -> str:
    """The Flathub app id a name clearly means: an exact name match or the only result. A loose search
    also returns themes and plugins ("obsidian" lists GTK themes first), so anything else is refused
    with the candidates, for the caller to pick one by id."""
    if looks_like_flatpak_id(name):
        return name
    matches = flatpak_search(name)
    exact = [app_id for app_id, app_name in matches if app_name.lower() == name.lower()]
    if exact:
        return exact[0]
    if len(matches) == 1:
        return matches[0][0]
    if not matches:
        die(f"no package or Flatpak found for {name!r}", 1)
    options = ", ".join(f"{app_name} ({app_id})" for app_id, app_name in matches[:5])
    die(f"{name!r} matches several Flatpaks; install one by id: {options}", 1)


def pkg(*args: str, quiet: bool = False) -> int:
    """The system package layer (dnf, pacman, or none on the image) in herald-os-catalog."""
    tool = shutil.which("herald-os-catalog") or str(Path(__file__).resolve().with_name("herald-os-catalog"))
    if not Path(tool).exists():
        return 127
    return subprocess.call([sys.executable, tool, "pkg", *args], stdout=subprocess.DEVNULL if quiet else None, stderr=subprocess.DEVNULL if quiet else None)


def install_app(name: str) -> int:
    if not name:
        die("install app needs a name", 2)
    if not looks_like_flatpak_id(name) and pkg("available", name, quiet=True) == 0:
        print(f"==> system package {name}")
        code = pkg("install", name)
        notify("Installed" if code == 0 else "Install failed", name)
        return code
    app_id = flatpak_resolve(name)
    print(f"==> flatpak install {app_id}")
    code = subprocess.call(["flatpak", "install", "-y", "--noninteractive", "--user", "flathub", app_id])
    notify("Installed" if code == 0 else "Install failed", app_id)
    return code


def remove_app(name: str) -> int:
    if not name:
        die("remove app needs a name", 2)
    if not looks_like_flatpak_id(name) and pkg("has", name, quiet=True) == 0:
        code = pkg("remove", name)
    else:
        app_id = name if looks_like_flatpak_id(name) else None
        if app_id is None and shutil.which("flatpak"):
            for line in sh(["flatpak", "list", "--app", "--columns=application,name"], timeout=60).stdout.splitlines():
                parts = line.split("\t")
                if len(parts) == 2 and parts[1].strip().lower() == name.lower():
                    app_id = parts[0].strip()
        if not app_id:
            die(f"{name!r} is not an installed package or Flatpak", 1)
        code = subprocess.call(["flatpak", "uninstall", "-y", "--noninteractive", app_id])
    notify("Removed" if code == 0 else "Remove failed", name)
    return code


def install_webapp(name: str, url: str, icon_url: str | None = None) -> int:
    if not name or not url.startswith(("http://", "https://")):
        die("install webapp needs a name and an http(s) url", 2)
    slug = slugify(name)
    APPS_DIR.mkdir(parents=True, exist_ok=True)
    ICONS_DIR.mkdir(parents=True, exist_ok=True)
    icon_path = ICONS_DIR / f"{slug}.png"
    host = urllib.parse.urlparse(url).netloc
    for candidate in filter(None, [icon_url, f"https://www.google.com/s2/favicons?domain={host}&sz=256"]):
        if sh(["curl", "-fsSL", "--max-time", "20", "-o", str(icon_path), candidate], timeout=30).returncode == 0 and icon_path.stat().st_size > 0:
            break
    else:
        icon_path = Path("web-browser")
    desktop = APPS_DIR / f"hermes-webapp-{slug}.desktop"
    desktop.write_text(
        "[Desktop Entry]\n"
        f"Name={name}\n"
        f"Comment=Herald OS web app for {host}\n"
        f"Exec=herald-os webapp-open {shell_quote(url)} {shell_quote(name)}\n"
        f"Icon={icon_path}\n"
        "Type=Application\n"
        "Categories=Network;WebApp;\n"
        f"StartupWMClass=hermes-webapp-{slug}\n"
        "Terminal=false\n"
    )
    if shutil.which("update-desktop-database"):
        subprocess.run(["update-desktop-database", str(APPS_DIR)], check=False, capture_output=True)
    notify("Web app added", f"{name} is in Applications")
    print(str(desktop))
    return 0


def shell_quote(value: str) -> str:
    return '"' + value.replace('"', '\\"') + '"'


def remove_webapp(name: str) -> int:
    slug = slugify(name)
    removed = False
    for path in (APPS_DIR / f"hermes-webapp-{slug}.desktop", ICONS_DIR / f"{slug}.png"):
        if path.exists():
            path.unlink()
            removed = True
    if not removed:
        die(f"no web app named {name!r}", 1)
    notify("Web app removed", name)
    return 0


def catalog(args: list[str]) -> int:
    """The install catalog lives in herald-os-catalog (linux/catalog/*.json)."""
    tool = shutil.which("herald-os-catalog") or str(Path(__file__).resolve().with_name("herald-os-catalog"))
    if not Path(tool).exists():
        die("herald-os-catalog is not installed", 127)
    return subprocess.call([sys.executable, tool, *args])


def webapp_open(url: str, name: str) -> int:
    reply = relay("webapp", [url, name, slugify(name)])
    if not reply.get("ok"):
        # Shell not running: fall back to the browser.
        return subprocess.call(["xdg-open", url])
    return 0


# ---------------------------------------------------------------------------------------------
# Style. The theme engine itself lives in Phase 3; this is its stable CLI.
def theme_dirs() -> list[Path]:
    return [d for d in THEME_DIRS if d.is_dir()]


def theme_list() -> int:
    seen: set[str] = set()
    for base in theme_dirs():
        for entry in sorted(base.iterdir()):
            if entry.is_dir() and (entry / "theme.json").exists() and entry.name not in seen:
                seen.add(entry.name)
                print(entry.name)
    if not seen:
        print("herald-ocean")
    return 0


def theme_current() -> int:
    marker = CONFIG_DIR / "theme"
    print(marker.read_text().strip() if marker.exists() else "herald-ocean")
    return 0


def theme_set(name: str) -> int:
    if not name:
        die("theme set needs a name", 2)
    applier = shutil.which("herald-os-theme")
    if applier:
        return subprocess.call([applier, "set", name])
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    (CONFIG_DIR / "theme").write_text(name + "\n")
    relay("theme", [name], quiet=True)
    return 0


THEME_COLOR_KEYS = ("bg", "bg2", "surface", "fg", "fg_dim", "accent", "accent_strong", "border_active", "border_inactive", "urgent", "ok", "warn")
HEX_COLOR = re.compile(r"^#[0-9a-fA-F]{6}$")
THEME_NAME = re.compile(r"^[a-z0-9][a-z0-9-]{0,39}$")
IMAGE_EXTENSIONS = {".png", ".jpg", ".jpeg", ".webp", ".avif"}
MAX_THEME_IMAGE = 25 * 1024 * 1024


def theme_problem(spec: object) -> str | None:
    if not isinstance(spec, dict):
        return "theme.json must be a JSON object"
    if not THEME_NAME.match(str(spec.get("name") or "")):
        return 'theme.json needs a "name" of lowercase letters, digits and dashes'
    colors = spec.get("colors")
    if not isinstance(colors, dict):
        return 'theme.json needs "colors"'
    bad = [key for key in THEME_COLOR_KEYS if not HEX_COLOR.match(str(colors.get(key) or ""))]
    return f"theme.json colours must be #rrggbb; check {', '.join(bad)}" if bad else None


def theme_install(url: str) -> int:
    """Install the themes in a git repository, keeping only colours and images: a theme cannot run code."""
    if not re.match(r"^https://[\w.-]+/[\w./-]+$", url):
        die("theme install needs the https address of a git repository", 2)
    if not shutil.which("git"):
        die("git is not installed", 127)
    user_dir = CONFIG_DIR / "themes"
    builtin_dirs = [d for d in THEME_DIRS if d != user_dir]
    installed: list[str] = []
    with tempfile.TemporaryDirectory(prefix="herald-theme-") as scratch:
        result = sh(["git", "clone", "--depth", "1", "--quiet", url, scratch], timeout=180)
        if result.returncode != 0:
            die(result.stderr.strip() or "git clone failed", 1)
        root = Path(scratch)
        folders = [root] if (root / "theme.json").exists() else [d for d in sorted(root.iterdir()) if d.is_dir() and not d.name.startswith(".") and (d / "theme.json").exists()]
        if not folders:
            die("the repository has no theme.json", 1)
        for folder in folders:
            try:
                spec = json.loads((folder / "theme.json").read_text())
            except json.JSONDecodeError as exc:
                die(f"{folder.name}: theme.json is not valid JSON ({exc})", 1)
            problem = theme_problem(spec)
            if problem:
                die(f"{folder.name}: {problem}", 1)
            name = spec["name"]
            if any((base / name / "theme.json").exists() for base in builtin_dirs):
                die(f"{name!r} is a built-in theme name", 1)
            target = user_dir / name
            shutil.rmtree(target, ignore_errors=True)
            target.mkdir(parents=True)
            for entry in folder.iterdir():
                if entry.is_file() and not entry.is_symlink() and entry.suffix.lower() in IMAGE_EXTENSIONS and entry.stat().st_size <= MAX_THEME_IMAGE:
                    shutil.copy2(entry, target / entry.name)
            wallpaper_name = Path(str(spec.get("wallpaper") or "default")).name
            clean = {key: spec[key] for key in ("name", "label", "description", "colors", "gtk", "terminal") if key in spec}
            clean["wallpaper"] = wallpaper_name if (target / wallpaper_name).is_file() else "default"
            scheme = (spec.get("shell") or {}).get("scheme") if isinstance(spec.get("shell"), dict) else None
            if scheme in ("dark", "light"):
                clean["shell"] = {"scheme": scheme}
            (target / "theme.json").write_text(json.dumps(clean, indent=2) + "\n")
            installed.append(name)
    notify("Themes installed", ", ".join(installed))
    print("\n".join(installed))
    return 0


def font(args: list[str]) -> int:
    sub = args[0] if args else "list"
    if sub == "list":
        if not shutil.which("fc-list"):
            die("fc-list is not installed (fontconfig)", 127)
        families = sorted({line.split(",")[0].strip() for line in sh(["fc-list", ":", "family"], timeout=30).stdout.splitlines() if line.strip()})
        print("\n".join(families))
        return 0
    if sub == "set":
        mono = "--mono" in args
        family = " ".join(a for a in args[1:] if a != "--mono").strip()
        if not family:
            die("font set <family> [--mono]  (default puts the built-in font back)", 2)
        reset = family.lower() in ("default", "reset", "system")
        if mono:
            # The foot rescue terminal follows the code font; the theme engine reads this file.
            marker = CONFIG_DIR / "font-mono"
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            if reset:
                marker.unlink(missing_ok=True)
            else:
                marker.write_text(family + "\n")
            if shutil.which("herald-os-theme"):
                subprocess.run(["herald-os-theme", "set", theme_name_current()], check=False, capture_output=True)
        return run_os("font.set", {"family": family, "kind": "mono" if mono else "ui"})
    die("font list | font set <family> [--mono]", 2)
    return 2


def theme_name_current() -> str:
    marker = CONFIG_DIR / "theme"
    return marker.read_text().strip() if marker.exists() else "herald-ocean"


def wallpaper(path: str) -> int:
    value = "" if path in ("default", "") else str(Path(path).expanduser().resolve())
    if value and not Path(value).is_file():
        die(f"no such image: {path}", 1)
    reply = relay("wallpaper", [value])
    return 0 if reply.get("ok") else 1


# ---------------------------------------------------------------------------------------------
# Trigger.
DURATION_RE = re.compile(r"^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?$")


def parse_duration(text: str) -> int:
    if text.isdigit():
        return int(text) * 60
    match = DURATION_RE.match(text)
    if not match or not any(match.groups()):
        die(f"bad duration {text!r} (use 20m, 1h30m, 90s or plain minutes)", 2)
    h, m, s = (int(x) if x else 0 for x in match.groups())
    return h * 3600 + m * 60 + s


def reminder(args: list[str]) -> int:
    if not args or args[0] == "list":
        result = sh(["systemctl", "--user", "list-timers", "--all", "--no-pager", "--output=json", "hermes-reminder-*"], timeout=15)
        try:
            timers = json.loads(result.stdout or "[]")
        except json.JSONDecodeError:
            timers = []
        if not timers:
            print("No reminders set.")
            return 0
        for timer in sorted(timers, key=lambda t: t.get("next") or 0):
            desc = sh(["systemctl", "--user", "show", "-p", "Description", "--value", timer["unit"]], timeout=10).stdout.strip()
            when = datetime.fromtimestamp(timer["next"] / 1_000_000).strftime("%a %H:%M") if timer.get("next") else "now"
            print(f"{when:<9} {desc.removeprefix('Reminder: ')}")
        return 0
    if args[0] == "clear":
        result = sh(["systemctl", "--user", "list-units", "--all", "--no-legend", "--no-pager", "hermes-reminder-*"], timeout=15)
        units = [tok for line in result.stdout.splitlines() for tok in line.split() if tok.startswith("hermes-reminder-")]
        for unit in units:
            subprocess.run(["systemctl", "--user", "stop", unit], check=False, capture_output=True)
        notify("Reminders cleared", f"{len(units)} cancelled" if units else "None were set")
        return 0
    if len(args) < 2:
        die("reminder <duration> <message>", 2)
    seconds = parse_duration(args[0])
    message = " ".join(args[1:])
    unit = f"hermes-reminder-{time.time_ns()}"
    result = sh([
        "systemd-run", "--user", "--quiet", f"--on-active={seconds}", f"--unit={unit}",
        f"--description=Reminder: {message}", "--timer-property=AccuracySec=1s",
        "herald-os", "notify", "Reminder", message,
    ], timeout=15)
    if result.returncode != 0:
        die(result.stderr.strip() or "systemd-run failed", 1)
    when = datetime.fromtimestamp(time.time() + seconds).strftime("%H:%M")
    notify("Reminder set", f"{message} at {when}")
    print(f"{unit} fires at {when}")
    return 0


def notice(kind: str) -> int:
    if kind == "time":
        now = datetime.now()
        notify(now.strftime("%A, %-d %B"), now.strftime("%H:%M"))
    elif kind == "battery":
        bats = sorted(Path("/sys/class/power_supply").glob("BAT*"))
        if not bats:
            notify("Battery", "No battery in this machine")
        else:
            cap = (bats[0] / "capacity").read_text().strip()
            status = (bats[0] / "status").read_text().strip()
            notify(f"Battery {cap}%", status)
    elif kind == "weather":
        result = sh(["curl", "-fsS", "--max-time", "8", weather_url(weather_location())], timeout=12)
        notify("Weather", result.stdout.strip() if result.returncode == 0 else "Weather is unavailable right now")
    else:
        die("notice time|battery|weather", 2)
    return 0


WEATHER_FILE = CONFIG_DIR / "weather-location"


def weather_location() -> str:
    try:
        return WEATHER_FILE.read_text().strip()
    except OSError:
        return ""


def weather_url(location: str) -> str:
    """wttr.in for a place (a city, an airport code, ~a landmark), or for the network's location when empty."""
    from urllib.parse import quote

    place = quote(" ".join(location.split()).replace(" ", "+"), safe="+~@,") if location else ""
    return f"https://wttr.in/{place}?format=%l:+%c+%t+(%C),+wind+%w"


def weather_cmd(args: list[str]) -> int:
    if not args:
        return notice("weather")
    if args[0] != "location":
        die("weather | weather location [--set <place> | --clear]", 2)
    if len(args) > 1 and args[1] == "--set":
        place = " ".join(args[2:]).strip()
        if not place:
            die("weather location --set <city, airport code or ~landmark>", 2)
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        WEATHER_FILE.write_text(place + "\n")
    elif len(args) > 1 and args[1] == "--clear":
        WEATHER_FILE.unlink(missing_ok=True)
    elif len(args) > 1:
        die("weather location [--set <place> | --clear]", 2)
    print(weather_location() or "automatic (from your network)")
    return 0


def screenshot() -> int:
    out_dir = HOME / "Pictures" / "Screenshots"
    out_dir.mkdir(parents=True, exist_ok=True)
    path = out_dir / f"Screenshot {datetime.now():%Y-%m-%d %H-%M-%S}.png"
    code = subprocess.call(["grim", str(path)]) if shutil.which("grim") else niri("screenshot-screen")
    if code != 0 or not path.exists():
        die("screenshot failed", code or 1)
    reply = relay("ask", ["Here is a screenshot I just took. What do you see?"], {"attachments": [str(path)]}, quiet=True)
    if not reply.get("ok"):
        print(str(path))
    return 0


CAPTURES = Path(tempfile.gettempdir()) / "herald-os-captures"


def capture(args: list[str]) -> int:
    sub = args[0] if args else ""
    if sub == "region":
        for tool in ("grim", "slurp"):
            if not shutil.which(tool):
                die(f"{tool} is not installed (dnf install grim slurp)", 127)
        region = sh(["slurp"], timeout=300)
        if region.returncode != 0 or not region.stdout.strip():
            return 1
        ask = "--ask" in args
        out_dir = CAPTURES if ask else HOME / "Pictures" / "Screenshots"
        out_dir.mkdir(parents=True, exist_ok=True)
        path = out_dir / f"Screenshot {datetime.now():%Y-%m-%d %H-%M-%S}.png"
        if subprocess.call(["grim", "-g", region.stdout.strip(), str(path)]) != 0 or not path.exists():
            die("the screenshot failed", 1)
        if ask:
            # The command overlay opens with the picture attached; the person types the question.
            reply = relay("ask", [], {"attachments": [str(path)]}, quiet=True)
            if not reply.get("ok"):
                print(str(path))
            return 0
        print(str(path))
        return 0
    if sub == "screenshot":
        mode = next((a for a in args[1:] if a in ("region", "window", "screen")), "region")
        return run_os("capture.screenshot", {"mode": mode, **({"edit": True} if "--edit" in args else {})})
    if sub == "record":
        return run_os("capture.record", {"action": "toggle", "region": "region" in args, "audio": "audio" in args or "--audio" in args})
    if sub == "stop":
        return run_os("capture.record", {"action": "stop"})
    if sub == "color":
        return capture_color()
    if sub == "qr":
        return capture_qr(args[1:])
    if sub == "text":
        return ocr()
    if sub == "transcode" and len(args) >= 2:
        return transcode(Path(args[1]).expanduser(), args[2] if len(args) > 2 else "gif")
    if sub == "share" and len(args) >= 2:
        return share(Path(args[1]).expanduser())
    die("capture region [--ask] | screenshot [region|window|screen] [--edit] | record [region] [audio] | stop | color | qr [--print|--json] | text | transcode <file> [gif|mp4|webm] | share <file>", 2)
    return 2


def need(*tools: str) -> None:
    for tool in tools:
        if not shutil.which(tool):
            die(f"{tool} is not installed (dnf install {tool if tool != 'zbarimg' else 'zbar'})", 127)


def capture_color() -> int:
    """Click a point; its colour goes on the clipboard as #rrggbb."""
    need("slurp", "grim", "wl-copy")
    point = sh(["slurp", "-p"], timeout=300)
    if point.returncode != 0 or not point.stdout.strip():
        return 1
    grab = subprocess.run(["grim", "-g", point.stdout.strip(), "-t", "ppm", "-"], capture_output=True, timeout=30)
    data = grab.stdout
    # Binary PPM: "P6", width, height and max value, each followed by whitespace, then RGB bytes.
    fields, index = [], 0
    while len(fields) < 4 and index < len(data):
        while index < len(data) and data[index:index + 1].isspace():
            index += 1
        start = index
        while index < len(data) and not data[index:index + 1].isspace():
            index += 1
        fields.append(data[start:index])
    pixel = data[index + 1:index + 4]
    if fields[:1] != [b"P6"] or len(pixel) < 3:
        die("could not read the colour", 1)
    hex_colour = "#{:02x}{:02x}{:02x}".format(*pixel)
    subprocess.run(["wl-copy"], input=hex_colour.encode(), check=False)
    notify("Colour copied", hex_colour)
    print(hex_colour)
    return 0


# What a QR code says, described without giving it away: the same rules as
# apps/desktop/shared/qr.ts, written to match it line for line, and both are checked against
# apps/desktop/shared/qr-cases.json. When in doubt it hides.
QR_COPIED = "QR code copied"
QR_SECRET_DESCRIPTION = "something that looks like a password, key or recovery phrase"
QR_SECRET_WORDS = re.compile(r"(?<![a-z0-9])(pass(word|wd|code|phrase)s?|pwd|secret|token|api[ _-]?key|private[ _-]?key|recovery phrase|seed phrase|mnemonic)(?![a-z])", re.I | re.A)
QR_SECRET_LABELS = re.compile(r"\b(pass|pin|key|seed|code|otp)\b\s*[:=]", re.I | re.A)
QR_SECRET_NAME_WORDS = {"token", "key", "apikey", "secret", "pass", "passcode", "password", "passwd", "pwd", "sig", "signature", "auth", "session", "sessionid", "otp", "code", "credential", "credentials", "jwt", "bearer"}
QR_DIGIT_RUN = re.compile(r"(?<![A-Za-z0-9_-])[0-9](?:[ -]?[0-9])*(?![A-Za-z0-9_-])")
QR_LONG_DIGITS_MIN = 16
QR_LUHN_DIGITS_MIN = 13
QR_CARD_LEAD = re.compile(r"4|5[1-5]|222[1-9]|22[3-9][0-9]|2[3-6][0-9]{2}|27[01][0-9]|2720|3[47]|30[0-5]|3[68]|352[89]|35[3-8][0-9]|6011|64[4-9]|65|62")
QR_KNOWN_TOKEN = re.compile(r"^(xox[bpa]-|glpat-|sk_(live|test)_|gh[po]_|github_pat_|sk-|AKIA)[A-Za-z0-9_-]{8,}")
QR_AWS_SECRET_KEY = re.compile(r"[A-Za-z0-9/+]{38,42}")
QR_AWS = re.compile(r"(?<![a-z])aws(?![a-z])", re.I)
QR_SCHEME = re.compile(r"^[a-z][a-z0-9+.-]*:", re.I)
QR_JWT = re.compile(r"^eyJ[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}")
QR_SEED_WORD = re.compile(r"[a-z]{3,8}")
QR_TEXT_TOKEN_MIN = 12
QR_URL_TOKEN_MIN = 8
QR_ENCODED_TOKEN_MIN = 16
QR_RANDOM_CHUNK_MIN = 8
QR_LETTER_DIGIT_SWITCHES_MIN = 2
QR_IRREGULAR_SWITCHES_MIN = 3
QR_ACRONYM_RUNS_MIN = 2
QR_CASE_SWITCHES_MIN = 4
QR_MIXED_CASE_MIN = 16
QR_WORD_RUN_MIN = 4
QR_NAME_SWITCHES_MAX = 4
QR_NAME_PART_MIN = 2
QR_MANY_SWITCHES_MIN = 4
QR_WORD_PART_MIN = 3
QR_AWS_SINGLE_RUNS_MIN = 4
QR_VOWEL = re.compile(r"[aeiouy]", re.I)
QR_PARTS = re.compile(r"[A-Z]+(?![a-z])|[A-Z][a-z]+|[a-z]+|[0-9]+")
QR_RANDOM_WORD_MIN = 6
QR_WORD_CASE_SWITCHES_MIN = 2
QR_CAMEL_WORD_MIN = 10
QR_KEY_GROUPS_MIN = 2
QR_KEY_GROUP_MIN = 3
QR_CAMEL_WORD = re.compile(r"[A-Z][a-z]{2,}")
QR_RECOVERY_WORDS = (11, 24)
QR_SHOWN_LINK_MAX = 100
QR_EXTEND = re.compile("[\u0300-\u036f\u1ab0-\u1aff\u1dc0-\u1dff\u200c\u200d\u20d0-\u20ff\ufe00-\ufe0f\ufe20-\ufe2f\U0001F3FB-\U0001F3FF\U000E0020-\U000E007F]")


def qr_label(value: str) -> str:
    clean = re.sub(r"[\x00-\x1f\x7f]", "", value).strip()
    return f"{clean[:39]}…" if len(clean) > 40 else clean


def qr_percent_bytes(value: str) -> str:
    """%xx as single bytes (Latin-1), the same in both implementations whatever the input."""
    return re.sub(r"%([0-9a-fA-F]{2})", lambda match: chr(int(match.group(1), 16)), value)


def qr_decode_deep(value: str) -> str:
    for _ in range(3):
        value = qr_percent_bytes(value)
    return value


def qr_decode_label(value: str) -> str:
    try:
        return urllib.parse.unquote(value.replace("+", " "), errors="strict")
    except UnicodeDecodeError:
        return value


def qr_detect(value: str) -> str:
    return qr_percent_bytes(value.replace("+", " "))


def qr_params(query: str, decode) -> list[tuple[str, str]]:
    out = []
    for pair in query.split("&"):
        if pair:
            name, _, value = pair.partition("=")
            out.append((decode(name), decode(value)))
    return out


def qr_switches(value: str) -> int:
    """How often a string switches between letters and digits, ignoring everything else."""
    last, switches = "", 0
    for char in value:
        kind = "letter" if re.fullmatch(r"[A-Za-z]", char) else "digit" if re.fullmatch(r"[0-9]", char) else ""
        if kind:
            switches += 1 if last and kind != last else 0
            last = kind
    return switches


def qr_case_switches(value: str) -> int:
    """How often the letters in a string switch between upper and lower case."""
    last, switches = "", 0
    for char in value:
        kind = "upper" if re.fullmatch(r"[A-Z]", char) else "lower" if re.fullmatch(r"[a-z]", char) else ""
        if kind:
            switches += 1 if last and kind != last else 0
            last = kind
    return switches


def qr_runs(chunk: str) -> list[list]:
    """A chunk as [kind, length] runs of upper case, lower case and digits: "iPhone15" is i, P, hone, 15."""
    out: list[list] = []
    for char in chunk:
        kind = "upper" if re.fullmatch(r"[A-Z]", char) else "lower" if re.fullmatch(r"[a-z]", char) else "digit"
        if out and out[-1][0] == kind:
            out[-1][1] += 1
        else:
            out.append([kind, 1])
    return out


def qr_irregular_switches(chunk: str) -> int:
    """The longest stretch of switches out of one-character runs; a capital starting a CamelCase word is skipped."""
    parts, current, longest = qr_runs(chunk), 0, 0
    for here, after in zip(parts, parts[1:]):
        if here == ["upper", 1] and after[0] == "lower":
            continue
        current = current + 1 if here[1] == 1 else 0
        longest = max(longest, current)
    return longest


def qr_acronym_runs(chunk: str) -> int:
    """Upper-case runs of 2+ glued to 2+ lower-case letters ("DEFghi")."""
    parts = qr_runs(chunk)
    return sum(1 for here, after in zip(parts, parts[1:]) if here[0] == "upper" and here[1] >= 2 and after[0] == "lower" and after[1] >= 2)


def qr_short_lower_runs(chunk: str) -> bool:
    """Lower-case runs averaging under QR_WORD_RUN_MIN letters: random, where names are made of words."""
    lower = [length for kind, length in qr_runs(chunk) if kind == "lower"]
    return sum(lower) < QR_WORD_RUN_MIN * len(lower)


def qr_name_like(value: str) -> bool:
    """Letters and digits that read as a name ("Mp3Player": Mp, 3, Player); see NAME_SWITCHES_MAX in qr.ts."""
    parts = QR_PARTS.findall(value)
    letters = [part for part in parts if not part[0].isdigit()]
    named = sum(len(part) for part in letters if len(part) >= QR_NAME_PART_MIN and QR_VOWEL.search(part))
    return len(letters) < len(parts) and qr_switches(value) <= QR_NAME_SWITCHES_MAX and 2 * named >= sum(len(part) for part in letters)


def qr_random_chunk(chunk: str) -> bool:
    if len(chunk) >= QR_RANDOM_CHUNK_MIN:
        if qr_switches(chunk) >= QR_LETTER_DIGIT_SWITCHES_MIN and not (QR_CAMEL_WORD.search(chunk) and qr_name_like(chunk)):
            return True
        if qr_irregular_switches(chunk) >= QR_IRREGULAR_SWITCHES_MIN and not qr_name_like(chunk):
            return True
    return len(chunk) >= QR_MIXED_CASE_MIN and qr_case_switches(chunk) >= QR_CASE_SWITCHES_MIN and qr_acronym_runs(chunk) >= QR_ACRONYM_RUNS_MIN and qr_short_lower_runs(chunk)


def qr_random_word(value: str) -> bool:
    """A whole word, its letters and digits taken together, that looks random; see RANDOM_WORD_MIN in qr.ts."""
    word = re.sub(r"[^A-Za-z0-9]", "", value)
    if len(word) < QR_RANDOM_WORD_MIN:
        return False
    switches = qr_switches(word)
    mixed = (
        switches >= QR_LETTER_DIGIT_SWITCHES_MIN
        and qr_case_switches(word) >= QR_WORD_CASE_SWITCHES_MIN
        and not qr_name_like(value)
        and not (len(word) >= QR_CAMEL_WORD_MIN and QR_CAMEL_WORD.search(word))
    )
    words = any(len(part) >= QR_WORD_PART_MIN and QR_VOWEL.search(part) for part in QR_PARTS.findall(value))
    return mixed or (switches >= QR_MANY_SWITCHES_MIN and not words)


def qr_aws_key(word: str) -> bool:
    """Shaped like an AWS secret access key: about 40 characters of base64, mixing upper case, lower case and digits."""
    return bool(QR_AWS_SECRET_KEY.fullmatch(word) and re.search(r"[A-Z]", word) and re.search(r"[a-z]", word) and re.search(r"[0-9]", word))


def qr_single_runs(chunk: str) -> int:
    """One-character runs that don't start a CamelCase word: a lone lower-case letter, or a capital not followed by 2+ lower case."""
    parts = qr_runs(chunk)
    return sum(
        1
        for i, (kind, length) in enumerate(parts)
        if length == 1 and (kind == "lower" or (kind == "upper" and not (i + 1 < len(parts) and parts[i + 1][0] == "lower" and parts[i + 1][1] >= 2)))
    )


def qr_looks_like_token(value: str, minimum: int) -> bool:
    """A known key format, an AWS secret key, a grouped key, a random word, a JWT, base32, hex, or a random chunk (qr_random_chunk)."""
    if QR_KNOWN_TOKEN.match(value) or (qr_aws_key(value) and (re.search(r"[/+]", value) or qr_single_runs(value) >= QR_AWS_SINGLE_RUNS_MIN)):
        return True
    chunks = [chunk for chunk in re.split(r"[^A-Za-z0-9]+", value) if chunk]
    key_groups = len(chunks) >= QR_KEY_GROUPS_MIN and all(len(chunk) >= QR_KEY_GROUP_MIN and re.search(r"[A-Za-z]", chunk) and re.search(r"[0-9]", chunk) for chunk in chunks)
    if key_groups or qr_random_word(value):
        return True
    if len(value) < minimum:
        return False
    if QR_JWT.match(value):
        return True
    if len(value) >= QR_ENCODED_TOKEN_MIN and (re.fullmatch(r"[A-Z2-7]+=*", value) or (re.fullmatch(r"[0-9a-fA-F]+", value) and re.search(r"[a-fA-F]", value))):
        return True
    return any(qr_random_chunk(chunk) for chunk in chunks)


def qr_uri_parts(uri: str) -> tuple[str | None, str, str, str]:
    """(authority, path, query, fragment), split by hand to match qr.ts."""
    rest, authority = QR_SCHEME.sub("", uri, count=1), None
    if rest.startswith("//"):
        end = re.search(r"[/?#]", rest[2:])
        authority = rest[2:] if not end else rest[2:end.start() + 2]
        rest = "" if not end else rest[end.start() + 2:]
    before_hash, _, fragment = rest.partition("#")
    path, _, query = before_hash.partition("?")
    return authority, path, query, fragment


def qr_luhn(digits: str) -> bool:
    """The Luhn checksum card numbers carry."""
    total = 0
    for i, char in enumerate(reversed(digits)):
        digit = int(char)
        if i % 2 == 1:
            digit *= 2
            digit -= 9 if digit > 9 else 0
        total += digit
    return total % 10 == 0


def qr_ean13(digits: str) -> bool:
    """An EAN-13 barcode's own checksum."""
    if len(digits) != 13:
        return False
    return (sum(int(digits[i]) * (3 if i % 2 == 1 else 1) for i in range(12)) + int(digits[12])) % 10 == 0


def qr_digits_look_secret(text: str) -> bool:
    """16+ digits in a row or grouped, or 13 to 15 that start like a card (QR_CARD_LEAD: issuer ranges) and pass Luhn; an unbroken valid EAN-13 is a barcode."""
    for run in QR_DIGIT_RUN.findall(text):
        digits = re.sub(r"[ -]", "", run)
        if len(digits) >= QR_LONG_DIGITS_MIN:
            return True
        if len(digits) >= QR_LUHN_DIGITS_MIN and QR_CARD_LEAD.match(digits) and qr_luhn(digits) and not (run == digits and qr_ean13(digits)):
            return True
    return False


def qr_name_words(name: str) -> list[str]:
    """A parameter name's words, lower case: "AWSAccessKeyId" is aws, access, key, id."""
    spaced = re.sub(r"([A-Z]+)([A-Z][a-z])", r"\1 \2", re.sub(r"([a-z0-9])([A-Z])", r"\1 \2", name))
    return [word.lower() for word in re.split(r"[^A-Za-z0-9]+", spaced) if word]


def qr_secret_name(name: str) -> bool:
    return any(word in QR_SECRET_NAME_WORDS for word in qr_name_words(name))


# Sites whose links carry public ids that look like tokens (see PUBLIC_IDS in qr.ts).
QR_PUBLIC_IDS = [
    {"host": re.compile(r"(^|\.)youtube\.com$"), "after": ["shorts", "embed", "live"], "params": ["v", "list", "si"]},
    {"host": re.compile(r"^youtu\.be$"), "first": True, "params": ["si"]},
    {"host": re.compile(r"^(www\.)?github\.com$"), "after": ["commit", "commits", "blob", "tree"], "segment": re.compile(r"^[0-9a-f]{7,40}$")},
    {"host": re.compile(r"(^|\.)amazon(\.[a-z]{2,3}){1,2}$"), "after": ["dp", "product"]},
    {"host": re.compile(r"(^|\.)instagram\.com$"), "after": ["p", "reel"], "params": ["igsh"]},
    {"host": re.compile(r"^open\.spotify\.com$"), "after": ["track", "album", "playlist", "artist", "episode", "show"], "params": ["si"]},
    {"host": re.compile(r"^(drive|docs)\.google\.com$"), "after": ["d", "folders"], "params": ["id"]},
]


def qr_public_segment(rule: dict | None, segments: list[str], index: int) -> bool:
    if not rule:
        return False
    placed = (rule.get("first") is True and index == 0) or (index > 0 and segments[index - 1] in rule.get("after", []))
    return placed and ("segment" not in rule or bool(rule["segment"].search(segments[index])))


def qr_strong_secret(value: str) -> bool:
    """Signs of a secret that count even in a site's public ids."""
    return bool(QR_KNOWN_TOKEN.match(value) or QR_JWT.match(value) or qr_digits_look_secret(value) or re.search(r"otpauth", qr_decode_deep(value), re.I))


def qr_host_of(authority: str | None) -> str:
    """The host of scheme://[user@]host[:port]/…, lower case; '' when it is not a plain host name short enough to show."""
    host = re.sub(r":\d*$", "", (authority or "").split("@")[-1]).lower()
    return host if re.fullmatch(r"[a-z0-9.-]+", host) and re.search(r"[a-z0-9]", host) and len(host) < QR_SHOWN_LINK_MAX else ""


def qr_check_link(uri: str, depth: int = 0) -> dict:
    """{host_only, removed, link}: credentials and secret parameters are cut out; a secret path segment leaves only the host."""
    authority, path, query, fragment = qr_uri_parts(uri)
    host = qr_host_of(authority)
    rule = next((entry for entry in QR_PUBLIC_IDS if entry["host"].search(host)), None)
    userinfo, at, hostport = (authority or "").rpartition("@")
    # user:password@, with the colon written out or URL-encoded.
    credentials = bool(at) and ":" in qr_decode_deep(userinfo)

    def secret_part(value: str, is_public: bool) -> bool:
        return qr_strong_secret(value) or (not is_public and bool(qr_looks_like_token(value, QR_URL_TOKEN_MIN) or (depth < 3 and QR_SCHEME.match(value) and qr_uri_looks_secret(value, depth + 1))))

    def keep_pair(pair: str) -> bool:
        name, _, value = pair.partition("=")
        is_public = qr_detect(name) in (rule or {}).get("params", [])
        return not qr_secret_name(qr_detect(name)) and not secret_part(qr_detect(value), is_public)

    segments = [segment for segment in path.split("/") if segment]
    pairs = [pair for pair in query.split("&") if pair]
    kept = [pair for pair in pairs if keep_pair(pair)]
    if "=" in fragment:
        kept_fragment = "&".join(pair for pair in fragment.split("&") if pair and keep_pair(pair))
    else:
        kept_fragment = "" if any(part and secret_part(qr_detect(part), False) for part in fragment.split("/")) else fragment
    removed = credentials or len(kept) != len(pairs) or kept_fragment != fragment
    if removed:
        scheme = QR_SCHEME.match(uri).group(0) if QR_SCHEME.match(uri) else ""
        link = f"{scheme}{'' if authority is None else '//' + hostport}{path}{'?' + '&'.join(kept) if kept else ''}{'#' + kept_fragment if kept_fragment else ''}"
    else:
        link = uri
    host_only = any(secret_part(qr_detect(segment), qr_public_segment(rule, segments, index)) for index, segment in enumerate(segments)) or bool(re.search(r"otpauth", qr_decode_deep(link), re.I))
    return {"host_only": host_only, "removed": removed, "link": link}


def qr_uri_looks_secret(uri: str, depth: int = 0) -> bool:
    """Whether a link (any scheme) carries something secret: credentials, a token, a 2FA code."""
    check = qr_check_link(uri, depth)
    return check["host_only"] or check["removed"]


def qr_looks_secret(text: str) -> bool:
    """A password, key, recovery phrase or credentialled link, as far as one can tell from the text."""
    if re.search(r"private key", text, re.I) or QR_SECRET_WORDS.search(text) or QR_SECRET_LABELS.search(text) or re.search(r"otpauth", qr_decode_deep(text), re.I) or qr_digits_look_secret(text):
        return True
    words = [word for word in re.split(r"[\s,]+", text) if word]
    if QR_RECOVERY_WORDS[0] <= len(words) <= QR_RECOVERY_WORDS[1] and all(QR_SEED_WORD.fullmatch(word.lower()) for word in words):
        return True
    if QR_AWS.search(text) and any(qr_aws_key(part) for word in text.split() for part in [word, *qr_label_parts(word)]):
        return True
    return any(
        (qr_uri_looks_secret(word) if QR_SCHEME.match(word) else "@" not in word and qr_looks_like_token(word, QR_TEXT_TOKEN_MIN))
        or ("@" not in word and any(qr_looks_like_token(part, QR_TEXT_TOKEN_MIN) for part in qr_label_parts(word)))
        for word in text.split()
    )


def qr_label_parts(word: str) -> list[str]:
    """A name=value or name:value word in its parts (AWS_SECRET_ACCESS_KEY=…); none for scheme://… links."""
    if QR_SCHEME.match(word) and QR_SCHEME.sub("", word, count=1).startswith("//"):
        return []
    return [part for part in re.split(r"[=:]", word) if part] if re.search(r"[=:]", word) else []


def wifi_fields(text: str) -> dict[str, str]:
    """WIFI:S:<name>;T:<WPA|WEP|nopass>;P:<password>;H:<true|false>;; with backslash escapes."""
    fields: dict[str, str] = {}
    current, escaped = "", False

    def flush() -> None:
        key, sep, value = current.partition(":")
        if sep and key:
            fields[key.upper()] = value

    for char in re.sub(r"^WIFI:", "", text, flags=re.I):
        if escaped:
            current, escaped = current + char, False
        elif char == "\\":
            escaped = True
        elif char == ";":
            flush()
            current = ""
        else:
            current += char
    flush()
    return fields


def qr_describe_otp(text: str) -> dict:
    if re.match(r"^otpauth-migration:", text, re.I):
        return {"kind": "otp", "caption": "2FA codes copied", "description": "a 2FA export from an authenticator app"}
    rest = re.sub(r"^otpauth://[^/?#]*/?", "", text, flags=re.I)
    path, _, query = rest.partition("?")
    name = qr_decode_label(path)
    issuer_param = next((value for key, value in qr_params(query.split("#")[0], qr_decode_label) if key.lower() == "issuer"), None)
    issuer = qr_label(issuer_param if issuer_param is not None else name.split(":")[0] if ":" in name else "")
    return {"kind": "otp", "caption": "2FA setup code copied", "description": f"a 2FA setup code for {issuer}" if issuer else "a 2FA setup code"}


def qr_shown_link(link: str, host: str) -> str:
    """A link for the caption: at most QR_SHOWN_LINK_MAX characters, cut with … after scheme://host at the earliest."""
    if len(link) <= QR_SHOWN_LINK_MAX:
        return link
    authority = re.match(r"[^:]*://[^/?#]*", link)
    if authority and len(authority.group(0)) >= QR_SHOWN_LINK_MAX:
        return f"{host}…"
    return f"{link[:qr_grapheme_cut(link, QR_SHOWN_LINK_MAX - 1)]}…"


def qr_regional(char: str) -> bool:
    return "\U0001F1E6" <= char <= "\U0001F1FF"


def qr_grapheme_cut(text: str, cut: int) -> int:
    """cut, moved back so it doesn't split a combining mark, ZWJ sequence, skin tone, tag or flag (see QR_EXTEND)."""
    while cut > 0 and (QR_EXTEND.match(text[cut]) or text[cut - 1] == "\u200d"):
        cut -= 1
    flags = 0
    while flags < cut and qr_regional(text[cut - 1 - flags]):
        flags += 1
    return cut - 1 if flags % 2 == 1 and qr_regional(text[cut]) else cut


def qr_link(text: str) -> dict | None:
    """Ordinary links in full; a secret cut out when it can be, else the host alone. Captions stay short."""
    host = qr_host_of(qr_uri_parts(text)[0]) if re.fullmatch(r"https?://\S+", text, re.I) else ""
    if not host:
        return None
    check = qr_check_link(text)
    if check["host_only"]:
        return {"kind": "link", "caption": f"Link copied: {host}", "description": f"a link to {host} that carries what looks like a password, key or sign-in token"}
    if check["removed"]:
        return {"kind": "link", "caption": f"Link copied: {qr_shown_link(check['link'], host)}", "description": f"a link to {host}, with the parts that looked secret removed", "link": check["link"]}
    return {"kind": "link", "caption": f"Link copied: {qr_shown_link(text, host)}", "description": f"a link to {host}", "text": text}


def qr_describe_lines(text: str) -> dict:
    """A code with several lines is hidden whole when any line, or the whole, would be."""
    if qr_looks_secret(text):
        return {"kind": "secret", "caption": QR_COPIED, "description": QR_SECRET_DESCRIPTION}
    for line in (part.strip() for part in re.split(r"\r?\n", text)):
        if line:
            reading = describe_qr(line)
            if "text" not in reading:
                return {"kind": reading["kind"], "caption": QR_COPIED, "description": f"text that includes {reading['description']}"}
    return {"kind": "text", "caption": QR_COPIED, "description": "text", "text": text}


def describe_qr(raw: str) -> dict:
    """One code's contents as {kind, caption, description, text?}: text only for ordinary links and text."""
    text = raw.strip()
    if re.search(r"[\r\n]", text):
        return qr_describe_lines(text)
    if re.match(r"^otpauth(-migration)?:", text, re.I):
        return qr_describe_otp(text)
    if re.match(r"^WIFI:", text, re.I):
        network = qr_label(wifi_fields(text).get("S", ""))
        return {"kind": "wifi", "caption": "Wi-Fi details copied", "description": f'a Wi-Fi network called "{network}"' if network else "Wi-Fi details"}
    link = qr_link(text)
    if link:
        return link
    if qr_looks_secret(text):
        return {"kind": "secret", "caption": QR_COPIED, "description": QR_SECRET_DESCRIPTION}
    return {"kind": "text", "caption": QR_COPIED, "description": "text", "text": text}


def xml_children(element, name: str) -> list:
    return [child for child in element if child.tag.rsplit("}", 1)[-1] == name]


def zbar_codes(xml: bytes) -> list[str]:
    """Each code zbarimg --xml found, once, in order. --raw would run several codes into one text.

    Only barcodes > source > index > symbol > data counts, and only a symbol with exactly one
    <data> holding text alone, so anything nested inside a code is not read as another. zbarimg never writes a DTD, and ElementTree would expand
    the entities one declares, so output with markup declarations before the root is refused.
    """
    prolog, root_tag, _ = xml.partition(b"<barcodes")
    if not root_tag or b"<!" in prolog:
        return []
    try:
        root = ElementTree.fromstring(xml)
    except ElementTree.ParseError:
        return []
    if root.tag.rsplit("}", 1)[-1] != "barcodes":
        return []
    codes: list[str] = []
    symbols = [symbol for source in xml_children(root, "source") for index in xml_children(source, "index") for symbol in xml_children(index, "symbol")]
    for symbol in symbols:
        found = xml_children(symbol, "data")
        # zbarimg writes one <data> of text per symbol; anything else is not trusted as a code.
        if len(found) != 1 or len(found[0]):
            continue
        element = found[0]
        data = element.text or ""
        if element.get("format") == "base64":
            try:
                data = base64.b64decode(data.strip()).decode(errors="replace")
            except ValueError:
                continue
        code = data.strip()
        if code and code not in codes:
            codes.append(code)
    return codes


def copy_sensitive(text: str, *, plain_fallback: bool) -> bool:
    """On the clipboard, marked as a secret so clipboard history (cliphist) skips it; False if not copied.

    wl-clipboard before 2.2 has no --sensitive. There, with plain_fallback (ordinary links and text),
    it is copied plainly so pasting still works; a secret is not copied at all, since a plain copy
    would stay in clipboard history.
    """
    quiet = {"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL, "check": False}
    if subprocess.run(["wl-copy", "--sensitive"], input=text.encode(), **quiet).returncode == 0:
        return True
    return plain_fallback and subprocess.run(["wl-copy"], input=text.encode(), **quiet).returncode == 0


QR_USAGE = "capture qr [--json | --print]"


def capture_qr(args: list[str]) -> int:
    """Select a QR code or barcode; what it says goes on the clipboard and nowhere else.

    The notification and the output say what kind of thing it is (a link's host, at most). --json
    prints {kind, caption, description, text?} for the shell; --print prints the contents, for scripts.
    A selection with several codes is refused: nothing is copied. So is a secret that cannot be
    marked sensitive (wl-clipboard before 2.2), rather than copied where clipboard history keeps it.
    """
    if len(args) > 1 or (args and args[0] not in ("--json", "--print")):
        die(f"{QR_USAGE} (one option at most)" if set(args) == {"--json", "--print"} else QR_USAGE, 2)
    need("slurp", "grim", "zbarimg", "wl-copy")
    region = sh(["slurp"], timeout=300)
    if region.returncode != 0 or not region.stdout.strip():
        return 1
    grab = subprocess.run(["grim", "-g", region.stdout.strip(), "-t", "png", "-"], capture_output=True, timeout=30)
    decoded = subprocess.run(["zbarimg", "--xml", "-q", "-"], input=grab.stdout, capture_output=True, timeout=30)
    codes = zbar_codes(decoded.stdout)
    if not codes:
        notify("No code found", "The selection had no QR code or barcode")
        return 1
    if len(codes) > 1:
        notify("Several codes found", "Nothing was copied; select just one code")
        die("several codes in that selection; select just one", 1)
    text = codes[0]
    reading = describe_qr(text)
    if not copy_sensitive(text, plain_fallback="text" in reading):
        if "text" in reading:
            notify("Code not copied", "The clipboard did not take it")
            die("not copied: wl-copy failed", 1)
        notify("Code not copied", "It looks secret, and this clipboard cannot keep it out of clipboard history")
        die("not copied: the code looks secret and wl-copy --sensitive failed (it needs wl-clipboard 2.2 or later); a plain copy would stay in clipboard history", 1)
    notify(reading["caption"])
    if args == ["--print"]:
        print(text)
    elif args == ["--json"]:
        print(json.dumps(reading, ensure_ascii=False))
    else:
        print(reading["caption"])
    return 0


def transcode(source: Path, target: str) -> int:
    """A recording as a GIF, a smaller MP4 or a WebM, next to the original."""
    need("ffmpeg")
    if not source.is_file():
        die(f"no such file: {source}", 1)
    if target not in ("gif", "mp4", "webm"):
        die("transcode <file> gif|mp4|webm", 2)
    out = source.with_name(f"{source.stem}{' (small)' if target == source.suffix.lstrip('.') else ''}.{target}")
    base = ["ffmpeg", "-y", "-loglevel", "error", "-i", str(source)]
    if target == "gif":
        attempts = [base + ["-vf", "fps=12,scale='min(960,iw)':-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse", str(out)]]
    elif target == "webm":
        attempts = [base + ["-c:v", "libvpx-vp9", "-crf", "36", "-b:v", "0", "-c:a", "libopus", str(out)]]
    else:
        # Fedora's ffmpeg-free has no x264; OpenH264 is the fallback encoder there.
        attempts = [
            base + ["-c:v", "libx264", "-crf", "28", "-preset", "veryfast", "-movflags", "+faststart", "-c:a", "aac", str(out)],
            base + ["-c:v", "libopenh264", "-b:v", "2M", "-movflags", "+faststart", "-c:a", "aac", str(out)],
        ]
    notify("Converting", f"{source.name} to {target.upper()}")
    for argv in attempts:
        if subprocess.run(argv, check=False, timeout=3600).returncode == 0 and out.exists():
            notify("Converted", out.name)
            print(out)
            return 0
    die(f"ffmpeg could not make a {target.upper()} of {source.name}", 1)
    return 1


def share(target: Path) -> int:
    """The file goes on the clipboard (paste it into a chat or a folder); LocalSend opens when installed."""
    if not target.exists():
        die(f"no such file: {target}", 1)
    need("wl-copy")
    subprocess.run(["wl-copy", "--type", "text/uri-list"], input=f"{target.resolve().as_uri()}\n".encode(), check=False)
    localsend = shutil.which("flatpak") and subprocess.run(["flatpak", "info", "org.localsend.localsend_app"], capture_output=True, check=False).returncode == 0
    if localsend:
        subprocess.Popen(["flatpak", "run", "org.localsend.localsend_app"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    notify("Ready to share", f"{target.name} is on the clipboard" + (" and LocalSend is open" if localsend else ""))
    return 0


def ocr() -> int:
    for tool in ("grim", "slurp", "tesseract", "wl-copy"):
        if not shutil.which(tool):
            die(f"{tool} is not installed (dnf install grim slurp tesseract tesseract-langpack-eng wl-clipboard)", 127)
    region = sh(["slurp"], timeout=120)
    if region.returncode != 0 or not region.stdout.strip():
        return 1
    grab = subprocess.run(["grim", "-g", region.stdout.strip(), "-"], capture_output=True, timeout=30)
    text = subprocess.run(["tesseract", "stdin", "stdout", "--psm", "6"], input=grab.stdout, capture_output=True, timeout=60).stdout.decode().strip()
    if not text:
        notify("No text found", "The selection had no readable text")
        return 1
    subprocess.run(["wl-copy"], input=text.encode(), check=False)
    preview = text.replace("\n", " ")
    notify("Text copied", preview[:120] + ("…" if len(preview) > 120 else ""))
    print(text)
    return 0


# ---------------------------------------------------------------------------------------------
# Switches. Night light and staying awake are system units the shell's menu bar reflects; do not
# disturb and the screensaver are shell settings.
STAY_AWAKE = STATE_DIR / "stay-awake"
NIGHTLIGHT_UNIT = "herald-os-nightlight"


def unit_active(unit: str) -> bool:
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", unit], check=False).returncode == 0


IDLE_CONF = CONFIG_DIR / "idle.conf"
IDLE_KEYS = {"lock": "lock", "screen_off": "screenOff", "suspend": "suspend"}


def idle_cmd(args: list[str]) -> int:
    sub = args[0] if args else "show"
    if sub == "show":
        print(IDLE_CONF.read_text().strip() if IDLE_CONF.exists() else "defaults: lock=600 screen_off=900 suspend=0 (seconds)")
        return 0
    if sub != "set" or len(args) < 2:
        die("idle show | idle set lock=<min> screen_off=<min> suspend=<min>", 2)
    minutes: dict[str, int] = {}
    for pair in args[1:]:
        key, _, value = pair.partition("=")
        if key not in IDLE_KEYS or not value.isdigit():
            die(f"bad setting {pair!r}: use lock=, screen_off= or suspend= with minutes", 2)
        minutes[key] = int(value)
    reply = relay("os", ["idle.set", json.dumps({IDLE_KEYS[key]: value for key, value in minutes.items()})], quiet=True)
    if reply.get("ok"):
        return 0
    # No shell: edit the timings swayidle reads directly.
    current = {line.split("=", 1)[0]: line.split("=", 1)[1] for line in (IDLE_CONF.read_text().splitlines() if IDLE_CONF.exists() else []) if "=" in line and not line.startswith("#")}
    current.update({key: str(value * 60) for key, value in minutes.items()})
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    IDLE_CONF.write_text("".join(f"{key}={value}\n" for key, value in current.items()))
    if not STAY_AWAKE.exists():
        subprocess.run(["herald-os-idle", "restart"], check=False)
    return 0


def toggle(args: list[str]) -> int:
    if not args or args[0] not in ("nightlight", "dnd", "idle", "screensaver"):
        die("toggle nightlight|dnd|idle|screensaver [on|off]", 2)
    name, wanted = args[0], (args[1] if len(args) > 1 else "")
    if wanted not in ("", "on", "off"):
        die("toggle <name> [on|off]", 2)
    if name == "nightlight":
        on = (not unit_active(NIGHTLIGHT_UNIT)) if not wanted else wanted == "on"
        if on:
            if not shutil.which("wlsunset"):
                die("wlsunset is not installed (dnf install wlsunset)", 127)
            subprocess.run(["systemctl", "--user", "stop", NIGHTLIGHT_UNIT], check=False, capture_output=True)
            # Warm all day from now (sunset at midnight, sunrise a minute before the next one).
            temperature = (CONFIG_DIR / "nightlight-temperature").read_text().strip() if (CONFIG_DIR / "nightlight-temperature").exists() else "4000"
            sh(["systemd-run", "--user", "--quiet", "--collect", f"--unit={NIGHTLIGHT_UNIT}", f"--setenv=WAYLAND_DISPLAY={os.environ.get('WAYLAND_DISPLAY', '')}",
                "wlsunset", "-t", temperature, "-T", "6500", "-s", "00:00", "-S", "23:59", "-d", "1"], timeout=15)
        else:
            subprocess.run(["systemctl", "--user", "stop", NIGHTLIGHT_UNIT], check=False, capture_output=True)
        relay("switches", [], quiet=True)
        print(f"night light {'on' if on else 'off'}")
        return 0
    if name == "idle":
        on = (not STAY_AWAKE.exists()) if not wanted else wanted == "on"
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        if on:
            STAY_AWAKE.touch()
            subprocess.run(["herald-os-idle", "stop"], check=False, capture_output=True)
        else:
            STAY_AWAKE.unlink(missing_ok=True)
            subprocess.run(["herald-os-idle", "start"], check=False, capture_output=True)
        relay("switches", [], quiet=True)
        print(f"stay awake {'on' if on else 'off'}")
        return 0
    # Do not disturb and the screensaver live in the shell's preferences; no on/off flips them.
    command = {"dnd": "dnd.set", "screensaver": "screensaver.set"}[name]
    return run_os(command, {"enabled": wanted == "on"} if wanted else {})


# ---------------------------------------------------------------------------------------------
# Restarting a device that stopped working, the step before a reboot. Wi-Fi, Bluetooth and sound are
# this account's to restart; the touchpad's driver needs administrator rights.
RESTART_TARGETS = ("wifi", "bluetooth", "sound", "touchpad")
RESTART_ALIASES = {"wi-fi": "wifi", "audio": "sound", "trackpad": "touchpad"}
RESTART_LABELS = {"wifi": "Wi-Fi", "bluetooth": "Bluetooth", "sound": "Sound", "touchpad": "The touchpad"}
RESTART_STEP_TIMEOUT = 15
SOUND_UNITS = ("wireplumber.service", "pipewire.service", "pipewire-pulse.service")
SOUND_START_ORDER = ("pipewire.service", "pipewire-pulse.service", "wireplumber.service")
SYSTEM_BUS_SOCKET = Path("/run/dbus/system_bus_socket")
SOUND_TIMEOUT = 25
I2C_HID_DRIVER = Path("/sys/bus/i2c/drivers/i2c_hid_acpi")
QUICKI2C_MODULE = Path("/sys/module/intel_quicki2c")
# pkexec's exit codes when nobody could be asked (no authentication agent) or the person said no.
PKEXEC_NO_AGENT, PKEXEC_REFUSED = 127, 126


def restart_target(name: str) -> str | None:
    key = name.strip().lower()
    key = RESTART_ALIASES.get(key, key)
    return key if key in RESTART_TARGETS else None


def restart_steps(target: str) -> list[tuple[list[str], bool]]:
    """Omarchy's steps for Wi-Fi and Bluetooth, in order, each with whether the restart fails without it."""
    if target == "wifi":
        return [(["rfkill", "unblock", "wifi"], False), (["nmcli", "networking", "on"], True),
                (["nmcli", "radio", "wifi", "on"], True), (["nmcli", "device", "wifi", "rescan"], False)]
    if target == "bluetooth":
        return [(["rfkill", "unblock", "bluetooth"], False), (["bluetoothctl", "power", "on"], True)]
    raise ValueError(f"no steps for {target}")


def restart_output(argv: list[str], timeout: float = RESTART_STEP_TIMEOUT) -> tuple[str | None, str]:
    """Run one step: (None, its output) when it worked, otherwise (why not, its output)."""
    try:
        result = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)
    except FileNotFoundError:
        return f"{argv[0]} is not installed", ""
    except subprocess.TimeoutExpired:
        return f"{' '.join(argv)} did not finish in {timeout:.0f}s", ""
    if result.returncode == 0:
        return None, result.stdout or ""
    return (result.stderr or result.stdout or "").strip() or f"{' '.join(argv)} exited {result.returncode}", result.stdout or ""


def restart_step(argv: list[str], timeout: float = RESTART_STEP_TIMEOUT) -> str | None:
    return restart_output(argv, timeout)[0]


def system_bus_available() -> bool:
    """Whether the system D-Bus bluez talks through is there; bluetoothctl aborts on an assertion without it."""
    address = os.environ.get("DBUS_SYSTEM_BUS_ADDRESS", "")
    path = re.search(r"(?:^|[;,])unix:(?:[^;]*,)?path=([^,;]+)", address)
    if address and not path:
        return True
    return Path(path.group(1)).exists() if path else SYSTEM_BUS_SOCKET.exists()


NO_SYSTEM_BUS = "the system D-Bus is not running, and Bluetooth needs it (sudo systemctl start dbus)"


def restart_radio(target: str) -> int:
    for argv, required in restart_steps(target):
        if argv[0] == "bluetoothctl" and not system_bus_available():
            die(f"could not restart Bluetooth: {NO_SYSTEM_BUS}", 1)
        problem = restart_step(argv)
        if problem and argv[0] == "bluetoothctl" and re.search(r"assertion|dbus_connection|Failed to connect to (the )?(system )?bus", problem, re.I):
            problem = NO_SYSTEM_BUS
        if problem and required:
            die(f"could not restart {RESTART_LABELS[target]}: {problem}", 1)
        if problem:
            print(f"{' '.join(argv[:2])}: {problem}", file=sys.stderr)
    print(f"{RESTART_LABELS[target]} restarted")
    return 0


def sound_units() -> list[str]:
    """The sound units this account has: pipewire-pulse (or WirePlumber) is not installed everywhere."""
    present = []
    for unit in SOUND_UNITS:
        problem, state = restart_output(["systemctl", "--user", "show", "--property=LoadState", "--value", unit])
        if problem:
            die(f"could not reach this account's services: {problem}", 1)
        if state.strip() == "loaded":
            present.append(unit)
    return present


def restart_sound() -> int:
    systemctl = ["systemctl", "--user"]
    units = sound_units()
    if "pipewire.service" not in units:
        die("PipeWire is not installed for this account (no pipewire.service), so there is no sound service to restart", 1)
    problem = restart_step([*systemctl, "restart", *units], timeout=SOUND_TIMEOUT)
    if problem:
        # A stuck PipeWire never finishes stopping: force the units down and start them afresh.
        print(f"The sound services did not restart cleanly ({problem}); forcing them down", file=sys.stderr)
        restart_step([*systemctl, "kill", "--kill-whom=all", "--signal=KILL", *units])
        restart_step([*systemctl, "reset-failed", *units])
        problem = restart_step([*systemctl, "start", *(unit for unit in SOUND_START_ORDER if unit in units)], timeout=SOUND_TIMEOUT)
        if problem:
            die(f"could not restart the sound services: {problem}", 1)
    for _ in range(5):
        if restart_step(["wpctl", "status"], timeout=5) is None:
            print("Sound restarted")
            return 0
        time.sleep(1)
    die("the sound services restarted but PipeWire is not answering; unplug and plug back any USB or Bluetooth headset, or restart the computer", 1)
    return 1


def touchpad_devices(driver: Path | None = None) -> list[str]:
    driver = driver or I2C_HID_DRIVER
    return sorted(device.name for device in driver.glob("i2c-*")) if driver.is_dir() else []


def touchpad_rebind(driver: Path | None = None, quicki2c: Path | None = None) -> int:
    """As root: unbind and bind each i2c_hid_acpi device, and reload intel_quicki2c where it is in use."""
    driver, quicki2c = driver or I2C_HID_DRIVER, quicki2c or QUICKI2C_MODULE
    devices = touchpad_devices(driver)
    if not devices and not quicki2c.exists():
        die("no touchpad driver to restart here (neither i2c_hid_acpi nor intel_quicki2c is in use)", 1)
    failed = []
    for device in devices:
        print(f"Rebinding {device}")
        problem = sysfs_write(driver / "unbind", device)
        if problem:
            print(f"herald-os: could not unbind {device} ({problem}); binding it anyway", file=sys.stderr)
        time.sleep(1)
        # The bind is tried whatever the unbind did: a device left unbound is a dead touchpad.
        problem = sysfs_write(driver / "bind", device)
        if problem:
            failed.append(f"could not bind {device} again ({problem})")
    if quicki2c.exists():
        print("Reloading intel_quicki2c")
        problem = restart_step(["modprobe", "-r", "intel_quicki2c"])
        if problem:
            print(f"herald-os: could not unload intel_quicki2c ({problem}); loading it anyway", file=sys.stderr)
        problem = restart_step(["modprobe", "intel_quicki2c"])
        if problem:
            failed.append(f"could not load intel_quicki2c again ({problem})")
    if failed:
        die(f"the touchpad did not restart: {'; '.join(failed)}. Restarting the computer brings it back", 1)
    print("The touchpad restarted")
    return 0


def sysfs_write(path: Path, value: str) -> str | None:
    """Write one sysfs attribute; None when it worked, otherwise the kernel's reason."""
    try:
        path.write_text(value)
    except OSError as exc:
        return exc.strerror or str(exc)
    return None


def restart_touchpad() -> int:
    if os.geteuid() == 0:
        return touchpad_rebind()
    if not touchpad_devices() and not QUICKI2C_MODULE.exists():
        die("no touchpad driver to restart here (neither i2c_hid_acpi nor intel_quicki2c is in use)", 1)
    again = [sys.executable, str(Path(__file__).resolve()), "restart", "touchpad"]
    in_terminal = "run `herald-os restart touchpad` in a terminal: it asks for your password there"
    if sys.stdin.isatty():
        return subprocess.call(["sudo", *again])
    if not shutil.which("pkexec"):
        die(f"restarting the touchpad needs administrator rights; {in_terminal}", 1)
    code = subprocess.call(["pkexec", *again])
    if code == PKEXEC_NO_AGENT:
        die(f"nothing here can ask for your password; {in_terminal}", 1)
    if code == PKEXEC_REFUSED:
        die("the touchpad was not restarted: administrator rights were not given", 1)
    return code


def restart_cmd(args: list[str]) -> int:
    target = restart_target(args[0]) if len(args) == 1 else None
    if not target:
        die("restart wifi|bluetooth|sound|touchpad", 2)
    if target == "sound":
        return restart_sound()
    if target == "touchpad":
        return restart_touchpad()
    return restart_radio(target)


# ---------------------------------------------------------------------------------------------
# Events and hooks: scripts in ~/.config/herald-os/hooks/<event>.d/ run when the event happens.
EVENT_NAMES = ("login", "wake", "sleep", "lock", "unlock", "returned", "battery-low", "network-change", "theme-set", "crash", "after-update")
HOOKS_DIR = CONFIG_DIR / "hooks"
HOOK_TIMEOUT = 120


def hook_scripts(event_name: str) -> list[Path]:
    folder = HOOKS_DIR / f"{event_name}.d"
    if not folder.is_dir():
        return []
    return [p for p in sorted(folder.iterdir()) if p.is_file() and os.access(p, os.X_OK) and not p.name.startswith(".") and not p.name.endswith((".sample", "~"))]


def run_hooks_here(event_name: str, detail: dict[str, str]) -> None:
    """The shell runs hooks itself; without it (a TTY, an update before login) they run from here."""
    env = {**os.environ, "HERALD_EVENT": event_name, "HERALD_EVENT_AT": datetime.now().astimezone().isoformat(),
           "HERALD_EVENT_JSON": json.dumps({"name": event_name, "detail": detail})}
    env.update({f"HERALD_EVENT_{re.sub(r'[^A-Z0-9]+', '_', key.upper())}": value for key, value in detail.items()})
    for script in hook_scripts(event_name):
        try:
            subprocess.run([str(script), event_name], env=env, timeout=HOOK_TIMEOUT, check=False)
        except (OSError, subprocess.TimeoutExpired) as exc:
            print(f"herald-os: hook {script.name}: {exc}", file=sys.stderr)


def event_cmd(args: list[str]) -> int:
    if not args or args[0] not in EVENT_NAMES:
        die(f"event <name> [key=value ...]; names: {', '.join(EVENT_NAMES)}", 2)
    name, pairs = args[0], args[1:]
    reply = relay("event", [name, *pairs], quiet=True)
    if not reply.get("ok"):
        run_hooks_here(name, dict(pair.split("=", 1) for pair in pairs if "=" in pair))
    return 0


def hook_cmd(args: list[str]) -> int:
    sub = args[0] if args else "list"
    if sub == "dir":
        print(HOOKS_DIR)
        return 0
    if sub == "list":
        for name in EVENT_NAMES:
            scripts = hook_scripts(name)
            print(f"{name:<15} {', '.join(s.name for s in scripts) if scripts else '-'}")
        return 0
    if sub == "install" and len(args) == 3:
        name, source = args[1], Path(args[2]).expanduser()
        if name not in EVENT_NAMES:
            die(f"no event called {name!r}; events: {', '.join(EVENT_NAMES)}", 2)
        if not source.is_file():
            die(f"no such script: {args[2]}", 1)
        target = HOOKS_DIR / f"{name}.d" / source.name
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)
        target.chmod(target.stat().st_mode | 0o755)
        print(f"installed {target}")
        return 0
    die("hook list | hook install <event> <script> | hook dir", 2)
    return 2


# ---------------------------------------------------------------------------------------------
# Crashes: core dumps from systemd-coredump; the shell turns a diagnosis into a Hermes chat.
def run_os(command: str, args: dict | None = None) -> int:
    """Run a registry command in the Hermes window (fire and forget; the shell reports the result)."""
    reply = relay("os", [command, json.dumps(args or {})])
    if not reply.get("ok"):
        die(reply.get("error") or f"the shell rejected {command}", 1)
    return 0


def run_os_wait(command: str, args: dict | None = None, timeout: float = 30) -> dict:
    """Run a registry command and return its result ({ok, summary, data}); exits on failure."""
    reply = relay("os-run", [command, json.dumps(args or {})], timeout=timeout)
    if not reply.get("ok"):
        die(reply.get("error") or reply.get("summary") or f"the shell rejected {command}", 1)
    return reply


# ---------------------------------------------------------------------------------------------
# Herald Canvas: the image editor, through the same canvas.* commands Hermes uses.
CANVAS_USAGE = (
    "canvas open [<file>] | new [<name>] [<width>x<height>] | status | layers [<project>] | history [<project>] "
    "| text <words> [--x <px>] [--y <px>] [--width <px>] [--size <px>] [--font <family>] [--color <css>] [--align left|center|right] "
    "| resize <width>x<height> [--anchor <where>] [--image] | resize --scale <n> | crop [<x> <y> <width> <height>] [--ratio <w:h>] [--angle <degrees>] "
    "| preview [<project>] [--size <px>] | export <file> [--project <project>] [--scale <n>] [--quality <0-1>] [--overwrite] | undo | redo [--steps <n>] "
    "| auto [tone|contrast|color] [--cutoff <percent>] | align <edges> [--layers <a,b>] [--to canvas|layers|selection] [--margin <px>] "
    "| distribute <horizontal|vertical|left|center|right|top|middle|bottom> --layers <a,b,c> "
    "| guides [list|clear] | guides add|remove <vertical|horizontal> <position> | guides add [--margins <m>] [--columns <n>] [--gutter <px>] [--center] "
    "| filter <kind> [--amount <n>] [--radius <px>] [--threshold <n>] [--angle <deg>] [--distance <px>] [--strength <n>] [--settings <json>] [--layer <layer>] "
    "| mask <layer> <reveal|hide|reveal-selection|hide-selection|invert|apply|enable|disable|remove|link|unlink> [--project <project>] "
    "| remove-background [<layer>] [--cutout] [--project <project>] | fill <x> <y> <width> <height> [--layer <layer>] [--new-layer] [--project <project>]"
)

# What `canvas mask` does, as canvas.mask names it.
CANVAS_MASK_ACTIONS = ("reveal", "hide", "revealSelection", "hideSelection", "invert", "apply", "enable", "disable", "remove", "link", "unlink")


def _absolute(value: str) -> str:
    return str(Path(value).expanduser().resolve())


def canvas_request(args: list[str]) -> tuple[str, dict]:
    """(command id, arguments) for `herald-os canvas ...` (pure; tested)."""
    sub, rest = (args[0], args[1:]) if args else ("open", [])
    flags: dict[str, str | bool] = {}
    words: list[str] = []
    i = 0
    while i < len(rest):
        token = rest[i]
        if token in ("--overwrite", "--json", "--image", "--cutout", "--new-layer", "--center"):
            flags[token[2:]] = True
        elif token.startswith("--") and i + 1 < len(rest):
            flags[token[2:]] = rest[i + 1]
            i += 1
        else:
            words.append(token)
        i += 1
    if sub == "open":
        return "canvas.open", ({"path": _absolute(words[0])} if words else {})
    if sub == "new":
        payload: dict = {}
        for word in words:
            size = re.fullmatch(r"(\d+)[x×](\d+)", word)
            if size:
                payload["width"], payload["height"] = int(size.group(1)), int(size.group(2))
            else:
                payload["name"] = f"{payload['name']} {word}" if "name" in payload else word
        if "background" in flags:
            payload["background"] = flags["background"]
        return "canvas.new", payload
    if sub == "status":
        return "canvas.status", {}
    if sub in ("layers", "undo", "redo", "history"):
        payload = {"project": _absolute(words[0])} if words else {}
        if sub in ("undo", "redo") and "steps" in flags:
            payload["steps"] = int(str(flags["steps"]))
        return f"canvas.{sub}", payload
    if sub == "preview":
        payload = {"project": _absolute(words[0])} if words else {}
        if "size" in flags:
            payload["size"] = int(str(flags["size"]))
        return "canvas.preview", payload
    if sub == "text":
        if not words:
            die(f"herald-os {CANVAS_USAGE}", 2)
        payload = {"content": " ".join(words)}
        for key in ("x", "y", "width", "size"):
            if key in flags:
                payload[key] = float(str(flags[key]))
        for key in ("font", "color", "align", "name"):
            if key in flags:
                payload[key] = str(flags[key])
        if "project" in flags:
            payload["project"] = _absolute(str(flags["project"]))
        return "canvas.addText", payload
    if sub == "resize":
        payload = {}
        size = re.fullmatch(r"(\d+)[x×](\d+)", words[0]) if words else None
        if size:
            payload["width"], payload["height"] = int(size.group(1)), int(size.group(2))
        if "scale" in flags:
            payload["scale"] = float(str(flags["scale"]))
        if not payload:
            die(f"herald-os {CANVAS_USAGE}", 2)
        if "anchor" in flags:
            payload["anchor"] = str(flags["anchor"])
        if flags.get("image"):
            payload["image"] = True
        if "project" in flags:
            payload["project"] = _absolute(str(flags["project"]))
        return "canvas.resize", payload
    if sub == "crop":
        # A box, a ratio, an angle to straighten by, or a box with either.
        shaped = "ratio" in flags or "angle" in flags
        if (words or not shaped) and (len(words) != 4 or not all(re.fullmatch(r"-?\d+", word) for word in words)):
            die(f"herald-os {CANVAS_USAGE}", 2)
        payload = dict(zip(("x", "y", "width", "height"), (int(word) for word in words)))
        if "ratio" in flags:
            payload["ratio"] = str(flags["ratio"])
        if "angle" in flags:
            payload["angle"] = float(str(flags["angle"]))
        if "project" in flags:
            payload["project"] = _absolute(str(flags["project"]))
        return "canvas.crop", payload
    if sub == "filter":
        if not words:
            die(f"herald-os {CANVAS_USAGE}", 2)
        payload = {"kind": " ".join(words)}
        settings = json.loads(str(flags["settings"])) if "settings" in flags else {}
        for key in ("amount", "radius", "threshold", "angle", "distance", "strength"):
            if key in flags:
                settings[key] = float(str(flags[key]))
        if settings:
            payload["settings"] = json.dumps(settings)
        if "layer" in flags:
            payload["layer"] = str(flags["layer"])
        if "project" in flags:
            payload["project"] = _absolute(str(flags["project"]))
        return "canvas.filter", payload
    if sub == "guides":
        action = words[0] if words else "list"
        if action not in ("add", "remove", "clear", "list") or (action in ("clear", "list") and len(words) > 1):
            die(f"herald-os {CANVAS_USAGE}", 2)
        payload = {"action": action}
        if len(words) == 3:
            payload["axis"], payload["position"] = words[1], words[2]
        elif len(words) > 1:
            die(f"herald-os {CANVAS_USAGE}", 2)
        for key in ("margins", "columns", "gutter"):
            if key in flags:
                payload[key] = str(flags[key]) if key == "margins" else float(str(flags[key]))
        if flags.get("center"):
            payload["center"] = True
        if "project" in flags:
            payload["project"] = _absolute(str(flags["project"]))
        return "canvas.guides", payload
    if sub == "auto":
        if len(words) > 1:
            die(f"herald-os {CANVAS_USAGE}", 2)
        payload = {"kind": words[0]} if words else {}
        if "cutoff" in flags:
            payload["cutoff"] = float(str(flags["cutoff"]))
        if "project" in flags:
            payload["project"] = _absolute(str(flags["project"]))
        return "canvas.autoAdjust", payload
    if sub in ("align", "distribute"):
        if not words:
            die(f"herald-os {CANVAS_USAGE}", 2)
        payload = {"edge" if sub == "align" else "distribute": ",".join(words)}
        for key in ("layers", "to"):
            if key in flags:
                payload[key] = str(flags[key])
        if "margin" in flags:
            payload["margin"] = float(str(flags["margin"]))
        if "project" in flags:
            payload["project"] = _absolute(str(flags["project"]))
        return "canvas.align", payload
    if sub == "export":
        if not words:
            die(f"herald-os {CANVAS_USAGE}", 2)
        payload = {"to": _absolute(words[0])}
        if "project" in flags:
            payload["project"] = _absolute(str(flags["project"]))
        for key in ("scale", "quality"):
            if key in flags:
                payload[key] = float(str(flags[key]))
        if "format" in flags:
            payload["format"] = flags["format"]
        if flags.get("overwrite"):
            payload["overwrite"] = True
        return "canvas.export", payload
    if sub == "mask":
        # "reveal-selection", "hide_selection" and "hideSelection" all mean the same.
        wanted = re.sub(r"[^a-z]", "", words[-1].lower()) if len(words) == 2 else ""
        action = next((name for name in CANVAS_MASK_ACTIONS if name.lower() == wanted), None)
        if not action:
            die(f"herald-os {CANVAS_USAGE}", 2)
        payload = {"layer": words[0], "action": action}
        if "project" in flags:
            payload["project"] = _absolute(str(flags["project"]))
        return "canvas.mask", payload
    if sub == "remove-background":
        payload = {"layer": " ".join(words)} if words else {}
        if flags.get("cutout"):
            payload["mode"] = "cutout"
        if "project" in flags:
            payload["project"] = _absolute(str(flags["project"]))
        return "canvas.removeBackground", payload
    if sub == "fill":
        if len(words) != 4 or not all(re.fullmatch(r"-?\d+", word) for word in words):
            die(f"herald-os {CANVAS_USAGE}", 2)
        payload = dict(zip(("x", "y", "width", "height"), (int(word) for word in words)))
        if "layer" in flags:
            payload["layer"] = str(flags["layer"])
        if flags.get("new-layer"):
            payload["newLayer"] = True
        if "project" in flags:
            payload["project"] = _absolute(str(flags["project"]))
        return "canvas.contentFill", payload
    die(f"herald-os {CANVAS_USAGE}", 2)
    return "", {}


def canvas_cmd(args: list[str]) -> int:
    command, payload = canvas_request(args)
    reply = run_os_wait(command, payload, timeout=120)
    data = reply.get("data") or {}
    if "--json" in args:
        print(json.dumps(data, indent=2))
        return 0
    if command == "canvas.layers":
        print(f"{data.get('name')}: {data.get('width')}×{data.get('height')}")
        for layer in data.get("layers") or []:
            marks = [str(layer.get("kind"))] + ([] if layer.get("visible", True) else ["hidden"]) + ([f"{round(layer['opacity'] * 100)}%"] if layer.get("opacity", 1) < 1 else [])
            print(f"  {layer.get('name')}  ({', '.join(marks)})")
        return 0
    if command == "canvas.guides" and payload.get("action") == "list":
        print(reply.get("summary") or "")
        for guide in data.get("guides") or []:
            print(f"  {guide.get('axis'):<10} {guide.get('position')}")
        return 0
    if command == "canvas.history":
        print(reply.get("summary") or "")
        for step in data.get("steps") or []:
            mark = "*" if step.get("step") == data.get("applied") else " "
            notes = [note for note in (step.get("by"), "undone" if step.get("undone") else None) if note]
            print(f"{mark} {step.get('step'):>3}  {step.get('label')}{'  (' + ', '.join(notes) + ')' if notes else ''}")
        return 0
    if command == "canvas.status":
        for doc in data.get("documents") or []:
            print(f"{'*' if doc.get('active') else ' '} {doc.get('name')}  {doc.get('width')}×{doc.get('height')}  {doc.get('path') or 'not saved'}{'  (edited)' if doc.get('modified') else ''}")
        if not data.get("documents"):
            print("Nothing is open in Herald Canvas.")
        return 0
    print(reply.get("summary") or "done")
    return 0


# ---------------------------------------------------------------------------------------------
# Herald Docs and Herald Sheets: documents and workbooks, through the same docs.* and sheets.*
# commands Hermes uses.
DOCS_USAGE = (
    "docs open [<file>] | new [<name>] [--template <template>] [--path <file>] [--content <markdown>|-] | list "
    "| read [<document>] [--part markdown|text|outline|selection] [--heading <heading>] | find <text> [--document <document>] "
    "| write <markdown>|- [--document <document>] [--at end|start|selection|marked|after|heading] [--heading <heading>] [--mode append|prepend|replace] "
    "| replace <find> <replacement> [--document <document>] [--first] "
    "| format [--document <document>] [--at selection|marked|all|heading|section|text] [--heading <heading>] [--text <text>] [--style <style>] "
    "[--bold|--no-bold] [--italic|--no-italic] [--underline|--no-underline] [--strike|--no-strike] [--color <css>] [--highlight <css>] [--font <family>] "
    "[--size <points>] [--align left|center|right|justify] [--line-spacing <n>] [--link <url>] [--clear] "
    "| table <json-rows>|- [--document <document>] [--at <where>] [--heading <heading>] [--no-header] "
    "| image <file> [--document <document>] [--width <px>] [--alt <text>] [--at <where>] "
    "| insert-range [<range>] [--workbook <workbook>] [--sheet <sheet>] [--document <document>] [--at <where>] [--heading <heading>] [--no-header] "
    "| save [<document>] [--to <file>] [--overwrite] | pdf [<document>] [--to <file>] [--overwrite] | undo|redo [<document>] [--steps <n>]"
)
SHEETS_USAGE = (
    "sheets open [<file>] | new [<name>] [--template budget|expenses|todo|schedule|invoice] [--path <file>] | list "
    "| read [<range>] [--workbook <workbook>] [--sheet <sheet>] | find <text> [--workbook <workbook>] [--sheet <sheet>] "
    "| write <range> <value>... | write <range> <json-rows> | fill <range> [<formula>] | format <range> <json> "
    "| sort <range> --by <column> [--descending] [--header] | filter <range> --by <column> --values <json-list> "
    "| filter <range> --by <column> --condition <json> | filter --clear | freeze <rows> [<columns>] "
    "| add-sheet [<name>] [--index <n>] | rename-sheet <sheet> <name> | remove-sheet <sheet> | replace <find> <replacement> [--range <range>] [--first] "
    "| clean <range> dedupe|trim|numbers|dates|split|case [--header] [--by <columns>] [--delimiter <d>] [--order dmy|mdy] [--date-format <format>] "
    "[--case upper|lower|title] [--overwrite] | save [<workbook>] [--to <file>] [--overwrite] | pdf [<workbook>] [--to <file>] [--overwrite] "
    "| undo|redo [<workbook>] [--steps <n>]; every command but open, new and list takes --workbook <workbook>, and the ones on cells --sheet <sheet>"
)
SLIDES_USAGE = (
    "slides open [<file>] | new [<name>] [--theme <theme>] [--size wide|standard] [--path <file>] [--slides <json>|-] | list "
    "| read [<presentation>] [--slide <slide>] "
    "| add-slide [<title>] [--layout <layout>] [--body <text>|-] [--notes <text>] [--after <slide>] "
    "| set-slide <slide> [--title <title>] [--body <text>|-] [--notes <text>] [--layout <layout>] [--hidden|--shown] [--background <colour>] "
    "| notes <slide> <text>|- | move <slide> <number|first|last> | remove <slide> | theme <theme> "
    "| from-doc [<document>] [--level <n>] [--notes] | insert-range [<range>] [--workbook <workbook>] [--sheet <sheet>] [--slide <slide>] "
    "| replace <find> <replacement> [--first] | save [<presentation>] [--to <file>] [--overwrite] | pdf [<presentation>] [--to <file>] [--overwrite] "
    "| undo|redo [<presentation>] [--steps <n>]; every command but open, new and list takes --presentation <presentation> "
    "(for from-doc, the deck the slides are added to); a slide is its number, id or title"
)

# What `sheets clean` does, as sheets.clean names it.
SHEETS_CLEAN_ACTIONS = ("dedupe", "trim", "numbers", "dates", "split", "case")
# The flags that take no value; every other flag takes the word after it.
OFFICE_SWITCHES = ("--json", "--overwrite", "--first", "--header", "--no-header", "--descending", "--clear", "--bold", "--no-bold", "--italic", "--no-italic", "--underline", "--no-underline", "--strike", "--no-strike", "--hidden", "--shown")


def _office_words(rest: list[str], usage: str, switches: tuple[str, ...] = OFFICE_SWITCHES) -> tuple[list[str], dict[str, str | bool]]:
    words: list[str] = []
    flags: dict[str, str | bool] = {}
    i = 0
    while i < len(rest):
        token = rest[i]
        if token in switches:
            flags[token[2:]] = True
        elif token.startswith("--"):
            if i + 1 == len(rest):
                die(f"herald-os {usage}", 2)
            flags[token[2:]] = rest[i + 1]
            i += 1
        else:
            words.append(token)
        i += 1
    return words, flags


def _office_ref(value: str) -> str:
    """A document or workbook as the commands take it: a file by its absolute path, or the name of an
    open one as its tab shows it."""
    return _absolute(value) if "/" in value or value.startswith("~") or Path(value).exists() else value


def _stdin_or(value: str) -> str:
    return sys.stdin.read() if value == "-" else value


def _json_text(value: str, kind: type, example: str) -> str:
    """`value` checked to be a JSON list or object, passed on as JSON text."""
    try:
        parsed = json.loads(value)
    except json.JSONDecodeError:
        parsed = None
    if not isinstance(parsed, kind):
        die(f"expected JSON like {example}, not {value[:60]!r}", 2)
    return json.dumps(parsed)


def _number(value: str | bool, usage: str) -> float:
    try:
        return float(str(value))
    except ValueError:
        die(f"herald-os {usage}", 2)
    return 0.0


def _count(value: str | bool, usage: str) -> int:
    if not re.fullmatch(r"\d+", str(value)):
        die(f"herald-os {usage}", 2)
    return int(str(value))


def docs_request(args: list[str]) -> tuple[str, dict]:
    """(command id, arguments) for `herald-os docs ...` (pure; tested)."""
    sub, rest = (args[0], args[1:]) if args else ("open", [])
    words, flags = _office_words(rest, DOCS_USAGE)
    text = " ".join(words)
    if sub == "open":
        return "docs.open", ({"path": _absolute(text)} if words else {})
    if sub == "new":
        payload: dict = {"name": text} if words else {}
        if "template" in flags:
            payload["template"] = str(flags["template"])
        if "path" in flags:
            payload["path"] = _absolute(str(flags["path"]))
        if "content" in flags:
            payload["content"] = _stdin_or(str(flags["content"]))
        return "docs.new", payload
    if sub == "list":
        return "docs.list", {}
    payload = {"document": _office_ref(str(flags["document"]))} if "document" in flags else {}
    if sub in ("read", "save", "pdf", "undo", "redo") and words:
        payload["document"] = _office_ref(text)
    placed = {key: str(flags[key]) for key in ("at", "heading", "mode") if key in flags}
    if sub == "read":
        return "docs.read", {**payload, **{key: str(flags[key]) for key in ("part", "heading") if key in flags}}
    if sub == "find":
        if not words:
            die(f"herald-os {DOCS_USAGE}", 2)
        return "docs.find", {**payload, "text": text}
    if sub == "write":
        content = _stdin_or(text)
        if not content.strip():
            die("docs write: nothing to write (give the Markdown, or - to read it from stdin)", 2)
        return "docs.write", {**payload, "content": content, **placed}
    if sub == "replace":
        if len(words) != 2:
            die(f"herald-os {DOCS_USAGE}", 2)
        payload.update({"find": words[0], "replacement": words[1]})
        if flags.get("first"):
            payload["all"] = False
        return "docs.replace", payload
    if sub == "format":
        changes: dict = {key: str(flags[key]) for key in ("style", "color", "highlight", "font", "link", "align") if key in flags}
        for key in ("bold", "italic", "underline", "strike"):
            if flags.get(key) or flags.get(f"no-{key}"):
                changes[key] = bool(flags.get(key))
        if "size" in flags:
            changes["size"] = _number(flags["size"], DOCS_USAGE)
        if "line-spacing" in flags:
            changes["lineSpacing"] = _number(flags["line-spacing"], DOCS_USAGE)
        if flags.get("clear"):
            changes["clear"] = True
        if words or not changes:
            die(f"herald-os {DOCS_USAGE}", 2)
        return "docs.format", {**payload, **{key: str(flags[key]) for key in ("at", "heading", "text") if key in flags}, **changes}
    if sub == "table":
        if len(words) != 1:
            die(f"herald-os {DOCS_USAGE}", 2)
        payload["cells"] = _json_text(_stdin_or(words[0]), list, '[["Item", "Cost"], ["Rent", "1200"]]')
        if flags.get("no-header"):
            payload["header"] = False
        return "docs.insertTable", {**payload, **placed}
    if sub == "image":
        if not words:
            die(f"herald-os {DOCS_USAGE}", 2)
        payload["source"] = _absolute(text)
        if "width" in flags:
            payload["width"] = _number(flags["width"], DOCS_USAGE)
        if "alt" in flags:
            payload["alt"] = str(flags["alt"])
        return "docs.insertImage", {**payload, **placed}
    if sub == "insert-range":
        if words:
            payload["range"] = text
        if "workbook" in flags:
            payload["workbook"] = _office_ref(str(flags["workbook"]))
        if "sheet" in flags:
            payload["sheet"] = str(flags["sheet"])
        if flags.get("no-header"):
            payload["header"] = False
        return "docs.insertRange", {**payload, **placed}
    if sub in ("save", "pdf"):
        if "to" in flags:
            payload["to"] = _absolute(str(flags["to"]))
        if flags.get("overwrite"):
            payload["overwrite"] = True
        return ("docs.save" if sub == "save" else "docs.exportPdf"), payload
    if sub in ("undo", "redo"):
        if "steps" in flags:
            payload["steps"] = _count(flags["steps"], DOCS_USAGE)
        return f"docs.{sub}", payload
    die(f"herald-os {DOCS_USAGE}", 2)
    return "", {}


def sheets_request(args: list[str]) -> tuple[str, dict]:
    """(command id, arguments) for `herald-os sheets ...` (pure; tested)."""
    sub, rest = (args[0], args[1:]) if args else ("open", [])
    words, flags = _office_words(rest, SHEETS_USAGE)
    text = " ".join(words)
    if sub == "open":
        return "sheets.open", ({"path": _absolute(text)} if words else {})
    if sub == "new":
        payload: dict = {"name": text} if words else {}
        if "template" in flags:
            payload["template"] = str(flags["template"])
        if "path" in flags:
            payload["path"] = _absolute(str(flags["path"]))
        return "sheets.new", payload
    if sub == "list":
        return "sheets.list", {}
    payload = {"workbook": _office_ref(str(flags["workbook"]))} if "workbook" in flags else {}
    if sub in ("save", "pdf", "undo", "redo") and words:
        payload["workbook"] = _office_ref(text)
    on_sheet = {"sheet": str(flags["sheet"])} if "sheet" in flags else {}
    if sub == "read":
        return "sheets.read", {**payload, **({"range": text} if words else {}), **on_sheet}
    if sub == "find":
        if not words:
            die(f"herald-os {SHEETS_USAGE}", 2)
        return "sheets.find", {**payload, "text": text, **on_sheet}
    if sub == "write":
        if len(words) < 2:
            die(f"herald-os {SHEETS_USAGE}", 2)
        rows = len(words) == 2 and words[1].lstrip().startswith("[")
        values = _json_text(words[1], list, '[["Item", "Cost"], ["Rent", 1200]]') if rows else " ".join(words[1:])
        return "sheets.write", {**payload, "range": words[0], "values": values, **on_sheet}
    if sub == "fill":
        if not words:
            die(f"herald-os {SHEETS_USAGE}", 2)
        payload["range"] = words[0]
        if len(words) > 1:
            payload["formula"] = " ".join(words[1:])
        return "sheets.fill", {**payload, **on_sheet}
    if sub == "format":
        if len(words) != 2:
            die(f"herald-os {SHEETS_USAGE}", 2)
        return "sheets.format", {**payload, "range": words[0], "format": _json_text(words[1], dict, '{"bold": true, "numberFormat": "#,##0.00"}'), **on_sheet}
    if sub == "sort":
        if len(words) != 1 or "by" not in flags:
            die(f"herald-os {SHEETS_USAGE}", 2)
        payload.update({"range": words[0], "by": str(flags["by"])})
        if flags.get("descending"):
            payload["ascending"] = False
        if flags.get("header"):
            payload["header"] = True
        return "sheets.sort", {**payload, **on_sheet}
    if sub == "filter":
        if flags.get("clear"):
            return "sheets.filter", {**payload, "clear": True, **on_sheet}
        if len(words) != 1 or "by" not in flags or ("values" not in flags and "condition" not in flags):
            die(f"herald-os {SHEETS_USAGE}", 2)
        payload.update({"range": words[0], "by": str(flags["by"])})
        if "values" in flags:
            payload["values"] = _json_text(str(flags["values"]), list, '["Paid", "Due"]')
        if "condition" in flags:
            payload["condition"] = _json_text(str(flags["condition"]), dict, '{"operator": "greaterThan", "value": 100}')
        return "sheets.filter", {**payload, **on_sheet}
    if sub == "freeze":
        if not 1 <= len(words) <= 2:
            die(f"herald-os {SHEETS_USAGE}", 2)
        payload["rows"] = _count(words[0], SHEETS_USAGE)
        if len(words) == 2:
            payload["columns"] = _count(words[1], SHEETS_USAGE)
        return "sheets.freeze", {**payload, **on_sheet}
    if sub == "add-sheet":
        if words:
            payload["name"] = text
        if "index" in flags:
            payload["index"] = _count(flags["index"], SHEETS_USAGE)
        return "sheets.addSheet", payload
    if sub == "rename-sheet":
        if len(words) != 2:
            die(f"herald-os {SHEETS_USAGE}", 2)
        return "sheets.renameSheet", {**payload, "sheet": words[0], "name": words[1]}
    if sub == "remove-sheet":
        if not words:
            die(f"herald-os {SHEETS_USAGE}", 2)
        return "sheets.removeSheet", {**payload, "sheet": text}
    if sub == "replace":
        if len(words) != 2:
            die(f"herald-os {SHEETS_USAGE}", 2)
        payload.update({"find": words[0], "replacement": words[1]})
        if "range" in flags:
            payload["range"] = str(flags["range"])
        if flags.get("first"):
            payload["all"] = False
        return "sheets.replace", {**payload, **on_sheet}
    if sub == "clean":
        if len(words) != 2 or words[1] not in SHEETS_CLEAN_ACTIONS:
            die(f"herald-os {SHEETS_USAGE}", 2)
        payload.update({"range": words[0], "action": words[1]})
        for flag, key in (("by", "by"), ("delimiter", "delimiter"), ("order", "order"), ("date-format", "dateFormat"), ("case", "case")):
            if flag in flags:
                payload[key] = str(flags[flag])
        for key in ("header", "overwrite"):
            if flags.get(key):
                payload[key] = True
        return "sheets.clean", {**payload, **on_sheet}
    if sub in ("save", "pdf"):
        if "to" in flags:
            payload["to"] = _absolute(str(flags["to"]))
        if flags.get("overwrite"):
            payload["overwrite"] = True
        return ("sheets.save" if sub == "save" else "sheets.exportPdf"), payload
    if sub in ("undo", "redo"):
        if "steps" in flags:
            payload["steps"] = _count(flags["steps"], SHEETS_USAGE)
        return f"sheets.{sub}", payload
    die(f"herald-os {SHEETS_USAGE}", 2)
    return "", {}


def _shown(value: object) -> str:
    """A cell as one field of a tab-separated line."""
    if value is None:
        return ""
    if isinstance(value, bool):
        return "TRUE" if value else "FALSE"
    return re.sub(r"[\t\r\n]+", " ", str(value))


def _office_listing(documents: list, summary: str | None, quote: bool) -> None:
    """One line per open document: * for the one in front, its file, unsaved edits and what is selected."""
    for doc in documents:
        selection = " ".join(str(doc.get("selection") or "").split())
        if selection and quote:
            selection = f"“{selection[:60]}…”" if len(selection) > 60 else f"“{selection}”"
        print(f"{'*' if doc.get('active') else ' '} {doc.get('name')}  {doc.get('path') or 'not saved'}{'  (edited)' if doc.get('modified') else ''}{'  ' + selection if selection else ''}")
    if not documents:
        print(summary or "Nothing is open.")


def docs_cmd(args: list[str]) -> int:
    command, payload = docs_request(args)
    reply = run_os_wait(command, payload, timeout=120)
    data = reply.get("data") or {}
    if "--json" in args:
        print(json.dumps(data, indent=2))
        return 0
    if command == "docs.list":
        _office_listing(data.get("documents") or [], reply.get("summary"), quote=True)
        return 0
    if command == "docs.read":
        outline = data.get("outline") or []
        for heading in outline:
            print(f"{'  ' * (int(heading.get('level') or 1) - 1)}{heading.get('text')}")
        body = data.get("content") if "content" in data else data.get("marked") or data.get("selection")
        if body:
            print(f"\n{body}" if outline else body)
        elif not outline:
            print(reply.get("summary") or "")
        return 0
    print(reply.get("summary") or "done")
    return 0


def sheets_cmd(args: list[str]) -> int:
    command, payload = sheets_request(args)
    reply = run_os_wait(command, payload, timeout=120)
    data = reply.get("data") or {}
    if "--json" in args:
        print(json.dumps(data, indent=2))
        return 0
    if command == "sheets.list":
        _office_listing(data.get("workbooks") or [], reply.get("summary"), quote=False)
        return 0
    if command == "sheets.read":
        rows = data.get("text") or data.get("values") or []
        for row in rows:
            print("\t".join(_shown(cell) for cell in row))
        if not rows:
            print(reply.get("summary") or "")
        elif data.get("truncated"):
            print(reply.get("summary") or "", file=sys.stderr)
        return 0
    print(reply.get("summary") or "done")
    return 0


def slides_request(args: list[str]) -> tuple[str, dict]:
    """(command id, arguments) for `herald-os slides ...` (pure; tested)."""
    sub, rest = (args[0], args[1:]) if args else ("open", [])
    # from-doc's --notes is a yes or no; elsewhere it takes the notes.
    words, flags = _office_words(rest, SLIDES_USAGE, (*OFFICE_SWITCHES, "--notes") if sub == "from-doc" else OFFICE_SWITCHES)
    text = " ".join(words)
    if sub == "open":
        return "slides.open", ({"path": _absolute(text)} if words else {})
    if sub == "new":
        payload: dict = {"name": text} if words else {}
        for key in ("theme", "size"):
            if key in flags:
                payload[key] = str(flags[key])
        if "path" in flags:
            payload["path"] = _absolute(str(flags["path"]))
        if "slides" in flags:
            payload["slides"] = _json_text(_stdin_or(str(flags["slides"])), list, '[{"layout": "title", "title": "Q3 review"}, {"title": "Results", "body": "Revenue up 12%"}]')
        return "slides.new", payload
    if sub == "list":
        return "slides.list", {}
    payload = {"presentation": _office_ref(str(flags["presentation"]))} if "presentation" in flags else {}
    if sub in ("read", "save", "pdf", "undo", "redo") and words:
        payload["presentation"] = _office_ref(text)
    on_slide = {"slide": str(flags["slide"])} if "slide" in flags else {}
    if sub == "read":
        return "slides.read", {**payload, **on_slide}
    if sub == "add-slide":
        payload.update({key: str(flags[key]) for key in ("layout", "notes", "after") if key in flags})
        if words:
            payload["title"] = text
        if "body" in flags:
            payload["body"] = _stdin_or(str(flags["body"]))
        return "slides.addSlide", payload
    if sub == "set-slide":
        changes: dict = {key: str(flags[key]) for key in ("title", "notes", "layout", "background") if key in flags}
        if "body" in flags:
            changes["body"] = _stdin_or(str(flags["body"]))
        if flags.get("hidden") or flags.get("shown"):
            changes["hidden"] = bool(flags.get("hidden"))
        if len(words) != 1 or not changes:
            die(f"herald-os {SLIDES_USAGE}", 2)
        return "slides.setSlide", {**payload, "slide": words[0], **changes}
    if sub == "notes":
        if len(words) < 2:
            die(f"herald-os {SLIDES_USAGE}", 2)
        return "slides.setSlide", {**payload, "slide": words[0], "notes": _stdin_or(" ".join(words[1:]))}
    if sub == "move":
        if len(words) != 2:
            die(f"herald-os {SLIDES_USAGE}", 2)
        return "slides.moveSlide", {**payload, "slide": words[0], "to": words[1]}
    if sub == "remove":
        if not words:
            die(f"herald-os {SLIDES_USAGE}", 2)
        return "slides.removeSlide", {**payload, "slide": text}
    if sub == "theme":
        if len(words) != 1:
            die(f"herald-os {SLIDES_USAGE}", 2)
        return "slides.setTheme", {**payload, "theme": words[0]}
    if sub == "from-doc":
        if words:
            payload["document"] = _office_ref(text)
        if "level" in flags:
            payload["level"] = _count(flags["level"], SLIDES_USAGE)
        if flags.get("notes"):
            payload["notes"] = True
        return "slides.fromDocument", payload
    if sub == "insert-range":
        if words:
            payload["range"] = text
        if "workbook" in flags:
            payload["workbook"] = _office_ref(str(flags["workbook"]))
        if "sheet" in flags:
            payload["sheet"] = str(flags["sheet"])
        return "slides.insertRange", {**payload, **on_slide}
    if sub == "replace":
        if len(words) != 2:
            die(f"herald-os {SLIDES_USAGE}", 2)
        payload.update({"find": words[0], "replacement": words[1]})
        if flags.get("first"):
            payload["all"] = False
        return "slides.replace", payload
    if sub in ("save", "pdf"):
        if "to" in flags:
            payload["to"] = _absolute(str(flags["to"]))
        if flags.get("overwrite"):
            payload["overwrite"] = True
        return ("slides.save" if sub == "save" else "slides.exportPdf"), payload
    if sub in ("undo", "redo"):
        if "steps" in flags:
            payload["steps"] = _count(flags["steps"], SLIDES_USAGE)
        return f"slides.{sub}", payload
    die(f"herald-os {SLIDES_USAGE}", 2)
    return "", {}


def slides_cmd(args: list[str]) -> int:
    command, payload = slides_request(args)
    reply = run_os_wait(command, payload, timeout=120)
    data = reply.get("data") or {}
    if "--json" in args:
        print(json.dumps(data, indent=2))
        return 0
    if command == "slides.list":
        _office_listing(data.get("presentations") or [], reply.get("summary"), quote=False)
        return 0
    if command == "slides.read":
        for slide in data.get("slides") or []:
            marks = [str(slide.get("layout")), *(["hidden"] if slide.get("hidden") else [])]
            print(f"{'*' if slide.get('number') == data.get('front') else ' '}{str(slide.get('number')).rjust(3)}. {slide.get('title') or '(no title)'}  ({', '.join(marks)})")
            for line in "\n".join(str(slide[key]) for key in ("body", "body2") if slide.get(key)).splitlines():
                print(f"       {line}")
            if slide.get("notes"):
                print(f"       notes: {' '.join(str(slide['notes']).split())}")
        if not data.get("slides"):
            print(reply.get("summary") or "")
        return 0
    print(reply.get("summary") or "done")
    return 0


# ---------------------------------------------------------------------------------------------
# Herald Calc: exact math, through the same calc.* commands Hermes uses.
CALC_USAGE = "calc <expression…> [--steps] [--json] | - (lines from stdin, read as a note) | convert <value> <from> <to> | history [<query>] | open [<text>]"


def calc_request(args: list[str]) -> tuple[str, dict]:
    """(command id, arguments) for `herald-os calc ...` (pure; tested)."""
    words = [word for word in args if word not in ("--steps", "--json")]
    if not words:
        die(f"herald-os {CALC_USAGE}", 2)
    sub, rest = words[0], words[1:]
    if sub == "convert":
        # "convert 5 km to miles" is "convert 5 km miles"; a quantity's own units stay in the value.
        if len(rest) >= 4 and rest[-2] in ("to", "in", "into"):
            rest = rest[:-2] + rest[-1:]
        if len(rest) < 3:
            die("herald-os calc convert <value> <from> <to>", 2)
        return "calc.convert", {"value": " ".join(rest[:-2]), "from": rest[-2], "to": rest[-1]}
    if sub == "history":
        return "calc.history", ({"query": " ".join(rest)} if rest else {})
    if sub == "open":
        return "calc.open", ({"text": " ".join(rest)} if rest else {})
    text = sys.stdin.read() if words == ["-"] else " ".join(words)
    if not text.strip():
        die("herald-os calc: nothing to work out (give the sum, or - to read it from stdin)", 2)
    return "calc.eval", {"text": text}


def calc_cmd(args: list[str]) -> int:
    command, payload = calc_request(args)
    reply = run_os_wait(command, payload, timeout=60)
    data = reply.get("data") or {}
    if "--json" in args:
        print(json.dumps({**data, "items": reply.get("items") or []} if command == "calc.history" else data, indent=2))
        return 0
    if command == "calc.history":
        items = reply.get("items") or []
        for item in items:
            print(f"{' '.join(str(item.get('input')).split())} = {item.get('result')}")
        if not items:
            print(reply.get("summary") or "No calculations yet")
        return 0
    if command == "calc.open":
        print(reply.get("summary") or "done")
        return 0
    lines = data.get("lines") or []
    for line in lines:
        print(f"{line.get('source')}\t{line['display'] if 'display' in line else '! ' + str(line.get('error') or '')}")
    if not lines:
        print(data.get("display") or reply.get("summary") or "")
    if "--steps" in args:
        for step in data.get("steps") or []:
            print(f"  {step}")
        if data.get("ratesDate"):
            print(f"  (ECB reference rates of {data['ratesDate']})")
    return 0


def signal_name(number: object) -> str:
    try:
        return signal.Signals(int(number)).name  # type: ignore[arg-type]
    except (TypeError, ValueError):
        return str(number or "?")


def coredumps() -> list[dict]:
    if not shutil.which("coredumpctl"):
        die("coredumpctl is not installed (it ships with systemd-coredump)", 127)
    result = sh(["coredumpctl", "list", "--json=short", "--no-pager", "--since=-7d"], timeout=30)
    try:
        rows = json.loads(result.stdout or "[]")
    except json.JSONDecodeError:
        rows = []
    return sorted((r for r in rows if isinstance(r, dict)), key=lambda r: r.get("time") or 0, reverse=True)


def crash(args: list[str]) -> int:
    sub = args[0] if args else "list"
    if sub == "list":
        rows = coredumps()
        if not rows:
            print("No crashes in the last 7 days.")
            return 0
        for row in rows[:30]:
            when = datetime.fromtimestamp(row["time"] / 1_000_000).strftime("%a %d %b %H:%M") if row.get("time") else "?"
            print(f"{when:<16} {str(row.get('pid', '?')):>7}  {Path(str(row.get('exe') or '?')).name:<24} {signal_name(row.get('sig'))}")
        return 0
    if sub == "diagnose":
        target = " ".join(args[1:]).strip()
        if not target.isdigit():
            return run_os("crash.diagnose", {"crash": target} if target else {})
        row = next((r for r in coredumps() if str(r.get("pid")) == target), None)
        details: dict = {"pid": int(target)}
        if row:
            details["app"] = Path(str(row.get("exe") or "")).name or None
            details["reason"] = signal_name(row.get("sig"))
            if row.get("time"):
                details["at"] = datetime.fromtimestamp(row["time"] / 1_000_000).astimezone().isoformat()
        return run_os("crash.diagnose", {k: v for k, v in details.items() if v})
    if sub == "mute":
        off = len(args) > 2 and args[-1] == "off"
        name = " ".join(args[1:-1] if off else args[1:]).strip()
        if not name:
            die("crash mute <name> [off]", 2)
        return run_os("crash.mute", {"app": name, "muted": not off})
    die("crash list | crash diagnose [pid|name] | crash mute <name> [off]", 2)
    return 2


# ---------------------------------------------------------------------------------------------
# System.
def account_has_password() -> bool | None:
    """True/False when it can be determined (needs passwordless sudo for `passwd -S`), else None."""
    result = subprocess.run(["sudo", "-n", "passwd", "-S", os.environ.get("USER") or Path.home().name], capture_output=True, text=True)
    if result.returncode != 0:
        return None
    fields = result.stdout.split()
    return len(fields) > 1 and fields[1] == "P"


def lock() -> int:
    # A lock nobody can undo is worse than no lock: an account without a password (the default in
    # the dev VM) would leave the compositor's session lock engaged with no way back in.
    if account_has_password() is False:
        notify("Lock skipped", "Set a password first: herald-os password")
        return 1
    if shutil.which("swaylock"):
        cfg = HOME / ".config" / "swaylock" / "config"
        return subprocess.call(lock_command(cfg if cfg.exists() else None, branding_lock_image()))
    return subprocess.call(["loginctl", "lock-session"])


BRANDING_DIR = CONFIG_DIR / "branding"
BRANDING_USAGE = "branding [show] | branding set [--logo <image>] [--lock <image>] [--name <text>] | branding reset [all|logo|lock|name]"


def branding_lock_image() -> Path | None:
    """The lock-screen picture `herald-os branding set --lock` chose, while it is still there."""
    try:
        stored = json.loads((BRANDING_DIR / "branding.json").read_text())
    except (OSError, json.JSONDecodeError):
        return None
    name = stored.get("lock") if isinstance(stored, dict) else None
    if not isinstance(name, str) or not name or Path(name).name != name:
        return None
    image = BRANDING_DIR / name
    return image if image.is_file() else None


def lock_command(cfg: Path | None, image: Path | None) -> list[str]:
    """swaylock's argv: the theme's config, and the branded picture behind the ring (pure; tested)."""
    args = ["swaylock", "-f"] + (["-C", str(cfg)] if cfg else ["--color", "04113f"])
    if image:
        args += ["--image", str(image), "--scaling", "fill"]
    return args


def branding_patch(args: list[str], cwd: Path) -> dict:
    """`branding set --logo <image> --lock <image> --name <text>` as a patch, paths made absolute (pure; tested)."""
    flags = {"--logo": "logo", "--lock": "lock", "--name": "name"}
    patch: dict = {}
    pairs = list(zip(args[::2], args[1::2]))
    if not args or len(args) % 2 or any(flag not in flags for flag, _ in pairs):
        die(BRANDING_USAGE, 2)
    for flag, value in pairs:
        key = flags[flag]
        patch[key] = value if key == "name" else str((cwd / Path(value).expanduser()).resolve())
    return patch


def branding_cmd(args: list[str]) -> int:
    """About's logo and name and the lock-screen picture; the shell keeps them (the same as Settings > About)."""
    action = args[0] if args else "show"
    if action == "set":
        reply = relay("branding", ["set", json.dumps(branding_patch(args[1:], Path.cwd()))])
    elif action == "reset" and len(args) <= 2:
        reply = relay("branding", ["reset", args[1] if len(args) > 1 else "all"])
    elif action == "show" and len(args) <= 1:
        reply = relay("branding", ["show"])
    else:
        die(BRANDING_USAGE, 2)
    if not reply.get("ok"):
        die(reply.get("error") or "the shell rejected the command", 1)
    view = reply.get("branding") or {}
    print(f"name:  {view.get('name') or '(none)'}")
    print(f"logo:  {'yours' if view.get('logo') else 'the Herald logo'}")
    print(f"lock:  {view.get('lock') or 'the theme colours'}")
    return 0


def password() -> int:
    """Set (or change) the login password used by the lock screen; interactive by design."""
    if not sys.stdin.isatty():
        die("run `herald-os password` in a terminal", 2)
    return subprocess.call(["passwd"])


# ---------------------------------------------------------------------------------------------
# The disk password: the LUKS passphrase typed at start-up to unlock the root filesystem. A change
# adds the new passphrase first, checks that it opens every device, and only then removes the old
# one, so whatever stops it part-way (a crash, the power) leaves a passphrase that works: the old
# one, the new one, or both. The person's side finds the devices and asks for the passphrases; the
# root side (`password --disk-root`, through sudo) takes them as JSON on stdin and runs cryptsetup.
DISK_USAGE = "password --disk [--new-owner] | password --disk --status"
DISK_MIN = 8
DISK_WRONG, DISK_NOT_ENCRYPTED, DISK_NO_ROOT, DISK_PARTLY, DISK_UNKNOWN, DISK_NOT_TAKEN_BACK, DISK_NOT_THE_PASSWORD = 3, 4, 5, 6, 7, 8, 9
DISK_NOT_ENCRYPTED_TEXT = (
    "this computer's disk is not encrypted, so there is no disk password to change. Herald OS encrypts "
    "the disk when it is installed, unless \"Encrypt my data\" was unticked; encrypting it now means "
    "installing again."
)
DISK_ASCII_TEXT = ("use only letters, digits, spaces and the symbols on the keyboard (ASCII) for the disk password: "
                   "it is typed before anything else starts, without an input method. Nothing was changed.")
# How the root side of a change can end and say so itself; any other end (it was killed) is looked
# at afterwards (disk_probe).
DISK_ENDS = {0, 1, 2, DISK_WRONG, DISK_NOT_ENCRYPTED, DISK_PARTLY, DISK_NOT_TAKEN_BACK, DISK_NOT_THE_PASSWORD, 127, 130}
# /sysroot is the real root filesystem on the image (ostree); / elsewhere.
DISK_ROOT_MOUNTS = ("/sysroot", "/")
# Made by reset-helper apply: the next account belongs to someone new, so setup asks for a disk
# password of their own. The root side removes it once they have one.
NEW_OWNER_MARK = Path("/var/lib/herald-os/new-owner")
CRYPTSETUP_TIMEOUT = 300
# Every LUKS2 key slot a header can hold; a passphrase cannot be in more slots than that.
LUKS_SLOTS = 32


def lsblk_children(node: dict) -> list[dict]:
    children = node.get("children")
    return [child for child in children if isinstance(child, dict)] if isinstance(children, list) else []


def lsblk_mounts(node: dict) -> list[str]:
    """Where lsblk says a device is mounted: MOUNTPOINTS (a list) since util-linux 2.37, MOUNTPOINT before."""
    points = node.get("mountpoints")
    if not isinstance(points, list):
        points = [node.get("mountpoint")]
    return [point for point in points if isinstance(point, str) and point]


def lsblk_root_luks(tree: list, root_uuid: str | None, mounts: tuple[str, ...] = DISK_ROOT_MOUNTS) -> list[str]:
    """The LUKS devices the root filesystem sits on, from `lsblk -J -p -o NAME,PATH,TYPE,FSTYPE,UUID,MOUNTPOINTS`
    (pure; tested). A btrfs spread over several encrypted disks has the same UUID on each, which finds
    them all although lsblk shows the mount on one; LVM or RAID inside the LUKS device is looked through."""

    def holds_root(node: dict) -> bool:
        if root_uuid and node.get("uuid") == root_uuid and node.get("fstype") != "crypto_LUKS":
            return True
        if any(point in mounts for point in lsblk_mounts(node)):
            return True
        return any(holds_root(child) for child in lsblk_children(node))

    found: list[str] = []

    def walk(node: dict) -> None:
        if node.get("fstype") == "crypto_LUKS" and any(holds_root(child) for child in lsblk_children(node)):
            path = node.get("path") or node.get("name")
            if isinstance(path, str) and path and path not in found:
                found.append(path)
        for child in lsblk_children(node):
            walk(child)

    for node in tree if isinstance(tree, list) else []:
        if isinstance(node, dict):
            walk(node)
    return found


def disk_root_uuid() -> str | None:
    for mount in DISK_ROOT_MOUNTS:
        try:
            result = subprocess.run(["findmnt", "-n", "-o", "UUID", "--mountpoint", mount], capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired):
            return None
        uuid = result.stdout.strip()
        if result.returncode == 0 and uuid:
            return uuid
    return None


class DiskUnknown(Exception):
    """Which devices hold the root filesystem cannot be told; the message says why."""


def disk_devices() -> list[str]:
    """The encrypted devices under the root filesystem, from lsblk. Without lsblk's view it fails closed
    (DiskUnknown) rather than guess: /etc/crypttab also names data and USB disks, and --new-owner removes
    every other key slot of each device it is given."""
    try:
        listing = subprocess.run(["lsblk", "-J", "-p", "-o", "NAME,PATH,TYPE,FSTYPE,UUID,MOUNTPOINTS"], capture_output=True, text=True, timeout=30)
    except FileNotFoundError:
        raise DiskUnknown("lsblk is not installed (it comes with util-linux)") from None
    except (OSError, subprocess.TimeoutExpired) as error:
        raise DiskUnknown(f"lsblk could not run ({error})") from None
    try:
        tree = json.loads(listing.stdout).get("blockdevices") if listing.returncode == 0 else None
    except (json.JSONDecodeError, AttributeError):
        tree = None
    if not isinstance(tree, list):
        said = (listing.stderr or "").strip().splitlines()
        raise DiskUnknown("lsblk could not list the disks" + (f" ({said[-1]})" if said else "") + " (util-linux 2.37 or later is needed)")
    return lsblk_root_luks(tree, disk_root_uuid())


def disk_unknown_text(error: DiskUnknown) -> str:
    return (f"{error}, so Herald OS cannot tell which encrypted devices hold the root filesystem. Nothing was "
            "changed: guessing could change the password of another disk.")


def disk_password_problem(new: str, again: str, current: str) -> str | None:
    """Why a new disk password will not do, or None (pure; tested). Only printable ASCII: at start-up there
    is no input method, and the keyboard layout may not be the one the password was typed with."""
    if new != again:
        return "the two new disk passwords are not the same. Nothing was changed."
    if len(new) < DISK_MIN:
        return f"use at least {DISK_MIN} characters for the disk password. Nothing was changed."
    if not all(" " <= char <= "~" for char in new):
        return DISK_ASCII_TEXT
    if new == current:
        return "the new disk password is the same as the current one. Nothing was changed."
    return None


def cryptsetup(args: list[str], key: str | None = None, new: str | None = None) -> subprocess.CompletedProcess:
    """cryptsetup, with a passphrase on stdin and a new one through a pipe. --key-file=- reads to the end
    of the input, newline and all, so each goes in without one: the same bytes as typed at start-up.
    External token plugins are kept out, so a TPM or FIDO2 token cannot stand in for the passphrase."""
    argv = ["cryptsetup", args[0], "--disable-external-tokens", *args[1:]]
    env = {**os.environ, "LC_ALL": "C"}
    if key is None:
        return subprocess.run(argv, capture_output=True, env=env, timeout=CRYPTSETUP_TIMEOUT)
    argv.insert(2, "--key-file=-")
    if new is None:
        return subprocess.run(argv, input=key.encode(), capture_output=True, env=env, timeout=CRYPTSETUP_TIMEOUT)
    read, write = os.pipe()
    try:
        os.write(write, new.encode())
        os.close(write)
        write = -1
        return subprocess.run([*argv, f"/dev/fd/{read}"], input=key.encode(), capture_output=True, env=env, timeout=CRYPTSETUP_TIMEOUT, pass_fds=(read,))
    finally:
        os.close(read)
        if write >= 0:
            os.close(write)


def cryptsetup_said(result: subprocess.CompletedProcess) -> str:
    text = (result.stderr or b"").decode(errors="replace").strip() or (result.stdout or b"").decode(errors="replace").strip()
    return text.splitlines()[-1] if text else f"cryptsetup exited {result.returncode}"


def luks_slot(device: str, passphrase: str) -> int | None:
    """The key slot the passphrase opens, -1 when it opens one cryptsetup did not name, None when it opens none."""
    result = cryptsetup(["open", "--test-passphrase", "-v", device], passphrase)
    if result.returncode != 0:
        return None
    match = re.search(rb"Key slot (\d+) unlocked", (result.stdout or b"") + (result.stderr or b""))
    return int(match.group(1)) if match else -1


def luks_metadata(device: str) -> dict:
    result = cryptsetup(["luksDump", "--dump-json-metadata", device])
    if result.returncode != 0:
        raise RuntimeError(f"cannot read the key slots of {device}: {cryptsetup_said(result)}")
    data = json.loads(result.stdout)
    return data if isinstance(data, dict) else {}


def luks_extra(metadata: dict, keep: int) -> tuple[list[int], list[int]]:
    """The key slots other than `keep`, and the tokens (TPM, FIDO2, recovery keys) left with no slot once
    those go, from `cryptsetup luksDump --dump-json-metadata` (pure; tested)."""
    slots = sorted(int(slot) for slot in (metadata.get("keyslots") or {}) if str(slot).isdigit() and int(slot) != keep)
    tokens = []
    for token, value in (metadata.get("tokens") or {}).items():
        used = {int(slot) for slot in (value or {}).get("keyslots") or [] if str(slot).isdigit()}
        if str(token).isdigit() and keep not in used:
            tokens.append(int(token))
    return slots, sorted(tokens)


def disk_say(*args, **kwargs) -> None:
    """print, for the root side while it changes the disk: the terminal may be gone (closed, or sudo
    stopped with it), and a write that fails then must not stop the change half-done."""
    with contextlib.suppress(OSError, ValueError):
        print(*args, **kwargs, flush=True)


def luks_slot_tokens(metadata: dict, slot: int) -> list[str]:
    """The types of the tokens that use a key slot (systemd-recovery, systemd-tpm2, systemd-fido2, …),
    from `cryptsetup luksDump --dump-json-metadata` (pure; tested)."""
    kinds = []
    for value in (metadata.get("tokens") or {}).values():
        if isinstance(value, dict) and str(slot) in {str(each) for each in value.get("keyslots") or []}:
            kinds.append(str(value.get("type") or "unknown"))
    return sorted(kinds)


def disk_not_the_password(device: str, slot: int, kinds: list[str]) -> str:
    """Why a secret that opens a slot a token uses is not taken as the disk password (pure; tested)."""
    if "systemd-recovery" in kinds:
        return ("that is the recovery key, not the disk password. Type the password the computer asks for when it "
                "starts; the recovery key stays as it is. Nothing was changed.")
    return (f"that opens key slot {slot} of {device}, which {' and '.join(kinds)} unlocking uses, not the disk password. "
            "Type the password the computer asks for when it starts. Nothing was changed.")


@contextlib.contextmanager
def disk_signals_held():
    """Ctrl+C, a closed terminal or a stop request wait until the change is done (cryptsetup inherits it)."""
    # SIG_IGN on purpose, not a Python handler: an ignored signal stays ignored across exec, so the
    # cryptsetup children (and what sudo passes on to them) cannot be stopped between writing a key slot
    # and the header that records it. That is bounded: each cryptsetup call has CRYPTSETUP_TIMEOUT
    # (300 s), after which subprocess kills it with SIGKILL, which cannot be ignored, and SIGKILL still
    # stops this process. setup ssh does it the other way round: its rollback keeps Python handlers that
    # do nothing (ssh_ignored), which exec resets to the default, because its commands may be stopped
    # (each runs in a process group of its own and is ended when its time is up), and a signal
    # arriving there must not raise in the middle of the rollback.
    held = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT, signal.SIGTSTP)
    before = {held_signal: signal.signal(held_signal, signal.SIG_IGN) for held_signal in held}
    try:
        yield
    finally:
        for held_signal, handler in before.items():
            signal.signal(held_signal, handler)


def disk_root(args: list[str]) -> int:
    """`password --disk-root check|change|probe`, as root: {"devices": [...], "current": ..., "new": ..., "newOwner": bool} on stdin."""
    try:
        return disk_root_op(args)
    except KeyboardInterrupt:
        # Only before the change: once it starts, Ctrl+C is ignored until it is done (disk_signals_held).
        die("stopped. Nothing was changed.", 130)
        return 130


def disk_probe(devices: list[str], current: str, new: str) -> dict:
    """Which of the two passwords opens each device now, for a change that ended without saying."""
    return {device: {"current": luks_slot(device, current) is not None, "new": bool(new) and luks_slot(device, new) is not None} for device in devices}


def disk_root_op(args: list[str]) -> int:
    op = args[0] if args else ""
    try:
        request = json.loads(sys.stdin.read())
        devices = [str(device) for device in request["devices"]]
        current = str(request["current"])
        new = str(request.get("new") or "")
        new_owner = request.get("newOwner") is True
    except (json.JSONDecodeError, KeyError, TypeError, AttributeError):
        die("password --disk-root check|change takes its request as JSON on stdin", 2)
    if op not in ("check", "change", "probe") or not devices:
        die("password --disk-root check|change takes its request as JSON on stdin", 2)
    if not shutil.which("cryptsetup"):
        die("cryptsetup is not installed", 127)
    if op == "probe":
        print(json.dumps(disk_probe(devices, current, new)))
        return 0
    for device in devices:
        if cryptsetup(["isLuks", device]).returncode != 0:
            die(f"{device} is not an encrypted (LUKS) device. Nothing was changed.", DISK_NOT_ENCRYPTED)
    old_slots: dict[str, int] = {}
    for device in devices:
        slot = luks_slot(device, current)
        if slot is None:
            die("that is not the disk password" + (f" (it does not open {device})" if len(devices) > 1 else "") + ". Nothing was changed.", DISK_WRONG)
        old_slots[device] = slot
    # Only a slot of its own counts as the disk password. One a token uses (the recovery key, TPM or
    # FIDO2 unlocking) would be removed in its place, leaving the owner's password working and the token
    # pointing at nothing; a slot cryptsetup did not name cannot be told apart, so it is refused too.
    for device, slot in old_slots.items():
        if slot < 0:
            die(f"cryptsetup did not say which key slot that password opens on {device}, so it cannot be told from "
                "the recovery key. Nothing was changed.", DISK_NOT_THE_PASSWORD)
        try:
            kinds = luks_slot_tokens(luks_metadata(device), slot)
        except (RuntimeError, json.JSONDecodeError) as error:
            die(f"{error}. Nothing was changed.", 1)
        if kinds:
            die(disk_not_the_password(device, slot, kinds), DISK_NOT_THE_PASSWORD)
    if op == "check":
        return 0
    problem = disk_password_problem(new, new, current)
    if problem:
        die(problem, 2)
    with disk_signals_held():
        try:
            return disk_change(devices, current, new, new_owner, old_slots)
        except subprocess.TimeoutExpired as error:
            disk_say(f"herald-os: cryptsetup did not finish in {CRYPTSETUP_TIMEOUT} s ({' '.join(map(str, error.cmd[1:2]))}) and was stopped. "
                  "The new password was added before anything was removed, so at least one of the two opens the disk: "
                  "try the new one first at the next start, then run `herald-os password --disk` again.", file=sys.stderr)
            return DISK_PARTLY


def disk_change(devices: list[str], current: str, new: str, new_owner: bool, old_slots: dict[str, int]) -> int:
    added: list[str] = []
    new_slots: dict[str, int] = {}

    def take_back(why: str) -> int:
        # Back to the old password alone: the new one goes again from the devices it went into, and
        # only a device it no longer opens counts as taken back.
        disk_say(f"herald-os: {why}", file=sys.stderr)
        left: list[str] = []
        for device in added:
            try:
                result = cryptsetup(["luksRemoveKey", device], new)
                gone = luks_slot(device, new) is None
            except (OSError, subprocess.TimeoutExpired) as error:
                result, gone = subprocess.CompletedProcess([], 1, b"", str(error).encode()), False
            if not gone:
                left.append(device)
                disk_say(f"herald-os: the new disk password could not be taken back out of {device} "
                      f"({cryptsetup_said(result) if result.returncode else 'it still opens it'}).", file=sys.stderr)
        if not left:
            disk_say("herald-os: nothing was changed; the current disk password still works.", file=sys.stderr)
            return 1
        disk_say(f"herald-os: the current disk password still opens every device, but the new one may open {' and '.join(left)} "
              "too. To take it out: " + "; ".join(f"sudo cryptsetup luksRemoveKey {shlex.quote(device)}" for device in left)
              + " (it asks for the new password), or run `herald-os password --disk` again with the same new password.", file=sys.stderr)
        return DISK_NOT_TAKEN_BACK

    for device in devices:
        disk_say(f"Adding the new disk password to {device}…")
        if luks_slot(device, new) is None:
            result = cryptsetup(["luksAddKey", device], current, new)
            if result.returncode != 0:
                return take_back(f"the new disk password could not be added to {device}: {cryptsetup_said(result)}")
            added.append(device)
        slot = luks_slot(device, new)
        if slot is None or slot == old_slots[device]:
            return take_back(f"the new disk password does not open {device} after adding it")
        new_slots[device] = slot
    disk_say("The new disk password opens the disk. Removing the old one…")

    problems: list[str] = []
    for device in devices:
        if new_owner and new_slots[device] >= 0:
            try:
                slots, tokens = luks_extra(luks_metadata(device), new_slots[device])
            except (RuntimeError, json.JSONDecodeError) as error:
                problems.append(str(error))
                continue
            for slot in slots:
                result = cryptsetup(["luksKillSlot", device, str(slot)], new)
                if result.returncode != 0:
                    problems.append(f"key slot {slot} of {device} could not be removed: {cryptsetup_said(result)}")
            for token in tokens:
                cryptsetup(["token", "remove", "--token-id", str(token), device])
        else:
            for _ in range(LUKS_SLOTS):
                if luks_slot(device, current) is None:
                    break
                result = cryptsetup(["luksRemoveKey", device], current)
                if result.returncode != 0:
                    problems.append(f"the old disk password could not be removed from {device}: {cryptsetup_said(result)}")
                    break
        if luks_slot(device, current) is not None:
            problems.append(f"the old disk password still opens {device}")
        if luks_slot(device, new) is None:
            problems.append(f"the new disk password does not open {device}")
    if problems:
        for problem in problems:
            disk_say(f"herald-os: {problem}", file=sys.stderr)
        disk_say("herald-os: the new disk password was added, but not everything above went as planned. Run "
              "`herald-os password --disk` again with the new password as the current one.", file=sys.stderr)
        return DISK_PARTLY
    if new_owner:
        with contextlib.suppress(OSError):
            NEW_OWNER_MARK.unlink(missing_ok=True)
    disk_say("Done: the disk asks for the new password at the next start; the old one no longer opens it.")
    return 0


def disk_root_argv(op: str) -> list[str]:
    argv = [sys.executable, str(Path(__file__).resolve()), "password", "--disk-root", op]
    return argv if os.geteuid() == 0 else ["sudo", "-n", *argv]


def disk_helper(op: str, request: dict) -> int:
    if op == "change":
        return disk_helper_change(request)
    return subprocess.run(disk_root_argv(op), input=json.dumps(request), text=True).returncode


def disk_helper_change(request: dict) -> int:
    """The change, which nothing here may stop part-way. subprocess.run would kill sudo on Ctrl+C, and
    the root side with it, between two devices; instead Ctrl+C, Ctrl+\\, Ctrl+Z, a closed terminal and
    SIGTERM wait here while the root side finishes or puts things back, and then say how it ended."""
    started: list[subprocess.Popen] = []
    stops: list[int] = []

    def wait_on(signum: int, frame) -> None:
        if not stops:
            disk_say("herald-os: the disk password is still changing; stopping it now could leave it half-done, "
                     "so this waits until it is finished or put back.", file=sys.stderr)
        stops.append(signum)
        # Ctrl+Z also stops sudo; it goes on, so the root side can end and be waited for.
        if signum == signal.SIGTSTP and started:
            with contextlib.suppress(OSError):
                os.kill(started[0].pid, signal.SIGCONT)

    # Python handlers, not SIG_IGN: sudo gets its own back when it starts, and passes them on to the
    # root side, which ignores them while it changes the disk.
    held = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT, signal.SIGTSTP)
    before = {held_signal: signal.signal(held_signal, wait_on) for held_signal in held}
    try:
        process = subprocess.Popen(disk_root_argv("change"), stdin=subprocess.PIPE, text=True)
        started.append(process)
        with contextlib.suppress(OSError):
            process.stdin.write(json.dumps(request))
        with contextlib.suppress(OSError):
            process.stdin.close()
        code = process.wait()
    finally:
        for held_signal, handler in before.items():
            signal.signal(held_signal, handler)
    if code in DISK_ENDS:
        return code
    return disk_report_end(request, code)


def disk_end_lines(state: dict) -> list[str]:
    """What opens each device now, from disk_probe (pure; tested)."""
    words = {(True, True): "the new disk password and the current one both open it",
             (False, True): "the new disk password opens it, the current one no longer does",
             (True, False): "the current disk password opens it, the new one does not",
             (False, False): "neither password opens it"}
    return [f"{device}: {words[(bool(opens.get('current')), bool(opens.get('new')))]}" for device, opens in state.items() if isinstance(opens, dict)]


def disk_report_end(request: dict, code: int) -> int:
    """The root side ended without saying how (it was killed): look, and say what opens what."""
    disk_say(f"herald-os: the disk password change ended before it could say how ({'signal ' + str(-code) if code < 0 else 'exit ' + str(code)}). "
             "What opens the disk now:", file=sys.stderr)
    try:
        probe = subprocess.run(disk_root_argv("probe"), input=json.dumps(request), capture_output=True, text=True, timeout=CRYPTSETUP_TIMEOUT * 2)
        state = json.loads(probe.stdout) if probe.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        state = None
    if not isinstance(state, dict):
        disk_say("herald-os: that could not be checked. The new password was added before anything was removed, so at "
                 "least one of the two opens each device: at the next start, try the new one first, then the current one.", file=sys.stderr)
        return DISK_PARTLY
    for line in disk_end_lines(state):
        disk_say(f"herald-os:   {line}", file=sys.stderr)
    disk_say("herald-os: run `herald-os password --disk` again to finish, with a password that opens every device as the current one.", file=sys.stderr)
    return DISK_PARTLY


def disk_ask(prompt: str) -> str:
    """getpass, which cannot decode a byte that is not text in the terminal's encoding: that is refused as
    anything outside ASCII is, rather than ending in a traceback."""
    try:
        return getpass.getpass(prompt)
    except UnicodeDecodeError:
        die(DISK_ASCII_TEXT, 2)
        return ""


def disk_password(args: list[str]) -> int:
    """`password --disk [--new-owner]`: in a terminal, the current disk password, then the new one twice."""
    flags = set(args)
    if not flags <= {"--new-owner", "--status"} or len(flags) != len(args) or flags == {"--new-owner", "--status"}:
        die(DISK_USAGE, 2)
    try:
        devices = disk_devices()
    except DiskUnknown as error:
        if "--status" in flags:
            # "encrypted" is null: unknown, which is neither a disk password to ask for nor a disk to call unencrypted.
            print(json.dumps({"encrypted": None, "devices": [], "newOwner": NEW_OWNER_MARK.exists(), "error": str(error)}))
            return 0
        die(disk_unknown_text(error), DISK_UNKNOWN)
    if "--status" in flags:
        print(json.dumps({"encrypted": bool(devices), "devices": devices, "newOwner": NEW_OWNER_MARK.exists(), "error": None}))
        return 0
    if not devices:
        die(DISK_NOT_ENCRYPTED_TEXT, DISK_NOT_ENCRYPTED)
    if not sys.stdin.isatty():
        die("run `herald-os password --disk` in a terminal", 2)
    print(f"The disk password unlocks {' and '.join(devices)} when the computer starts.")
    # Until the change starts, Ctrl+C (or the end of input) only stops the asking: nothing has changed.
    try:
        # sudo asks first, with a prompt of its own that stays the same in every language.
        if os.geteuid() != 0 and subprocess.call(["sudo", "-v", "-p", "[sudo] password for %p: "]) != 0:
            die("changing the disk password needs root through sudo, which did not let you in. Nothing was changed.", DISK_NO_ROOT)
        current = disk_ask("Current disk password: ")
        code = disk_helper("check", {"devices": devices, "current": current})
        if code != 0:
            return code
        new = disk_ask("New disk password: ")
        again = disk_ask("New disk password again: ")
    except (KeyboardInterrupt, EOFError):
        print(file=sys.stderr)
        die("stopped. Nothing was changed.", 130)
    problem = disk_password_problem(new, again, current)
    if problem:
        die(problem, 2)
    print("Adding the new disk password and checking it, then removing the old one. Keep the computer on until it is done.")
    return disk_helper("change", {"devices": devices, "current": current, "new": new, "newOwner": "--new-owner" in flags})


def suspend() -> int:
    lock()
    return subprocess.call(["systemctl", "suspend"])


def update(check_only: bool) -> int:
    updater = shutil.which("herald-os-update")
    if updater:
        return subprocess.call([updater] + (["--check"] if check_only else []))
    print("herald-os-update is not installed; run linux/dev/build.sh in your Herald-OS checkout to install it.")
    return 1


SESSION_ENTRIES = (Path("/usr/share/wayland-sessions/herald-os.desktop"), Path("/usr/local/share/wayland-sessions/herald-os.desktop"))


def session_hint() -> str:
    """How to start Herald OS, from what this machine has: the login-screen entry and niri."""
    listed = any(entry.exists() for entry in SESSION_ENTRIES)
    if listed and shutil.which("niri"):
        return "Start the full session from your login screen (Herald OS), or run herald-os-app inside your desktop."
    if listed:
        return "Run herald-os-app inside your desktop. The full session (Herald OS on your login screen) also needs niri."
    return "Run herald-os-app inside your desktop. For the full session, install niri; then `sudo herald-os-tarball install` puts Herald OS on your login screen (docs/LINUX.md)."


def debug() -> int:
    def line(label: str, argv: list[str]) -> None:
        try:
            out = subprocess.run(argv, capture_output=True, text=True, timeout=5).stdout.strip().splitlines()
            print(f"{label:<14} {out[0] if out else '-'}")
        except Exception:  # noqa: BLE001
            print(f"{label:<14} unavailable")

    print("Herald OS debug")
    line("os", ["sh", "-c", ". /etc/os-release && echo $PRETTY_NAME"])
    line("kernel", ["uname", "-r"])
    line("niri", ["niri", "--version"])
    line("cage", ["cage", "-h"])
    line("electron", ["sh", "-c", "pgrep -a electron | head -1"])
    hermes = hermes_command()
    line("hermes", [*hermes, "--version"] if hermes else ["echo", "missing"])
    print(f"{'shell socket':<14} {'up' if SOCKET.exists() else 'down'} ({SOCKET})")
    print(f"{'compositor':<14} {os.environ.get('HERALD_OS_COMPOSITOR', 'niri')} nested={os.environ.get('HERALD_OS_NIRI_NESTED', 'auto')}")
    for name in ("shell.log", "compositor.log"):
        path = STATE_DIR / name
        if path.exists():
            print(f"--- {name} (tail)")
            print("\n".join(path.read_text(errors="replace").splitlines()[-8:]))
    return 0


# ---------------------------------------------------------------------------------------------
# Keymaps. Herald's niri config, ~/.config/niri/herald-os.kdl (the session starts niri with it), is
# rendered from its template; a personal ~/.config/niri/config.kdl is never touched. The Omarchy keymap
# makes Super+C, X and V copy, cut and paste in every app (terminals included, through Ctrl+Insert and
# Shift+Insert), and moves the Herald binds they replace one modifier over.
KEYMAP_FILE = CONFIG_DIR / "keymap"
KEYMAPS = ("herald", "omarchy")
NIRI_CONFIG = HOME / ".config" / "niri" / "herald-os.kdl"
# The template that came with this command comes first: a checkout's, or the app's own when the
# command is a link into /opt/herald-os (the Arch package, the release tarball). Copies installed
# elsewhere (the image, the development VM) fall through to the folders after it.
NIRI_TEMPLATES = [
    Path(__file__).resolve().parent.parent / "niri" / "config.kdl",
    HOME / "Herald-OS" / "linux" / "niri" / "config.kdl",
    Path("/usr/local/share/herald-os-linux/niri/config.kdl"),
    Path("/usr/share/herald-os/niri/config.kdl"),
]
OMARCHY_BINDS = {
    "Mod+C": 'Mod+C hotkey-overlay-title="Copy" { spawn "wtype" "-M" "ctrl" "-k" "Insert" "-m" "ctrl"; }',
    "Mod+X": 'Mod+X hotkey-overlay-title="Cut" { spawn "wtype" "-M" "ctrl" "x" "-m" "ctrl"; }',
    "Mod+V": 'Mod+V hotkey-overlay-title="Paste" { spawn "wtype" "-M" "shift" "-k" "Insert" "-m" "shift"; }',
}
# Herald's own binds on those keys move here (both are free in the template).
OMARCHY_MOVES = {"Mod+C": "Mod+Ctrl+C", "Mod+V": "Mod+Shift+V"}


def current_keymap() -> str:
    try:
        name = KEYMAP_FILE.read_text().strip()
    except OSError:
        return "herald"
    return name if name in KEYMAPS else "herald"


def render_keymap(template: str, keymap: str) -> str:
    """The niri config for a keymap: the template unchanged for Herald's keys, rewritten for Omarchy's."""
    if keymap != "omarchy":
        return template
    out: list[str] = []
    for line in template.splitlines():
        stripped = line.lstrip()
        key = stripped.split(" ", 1)[0]
        indent = line[: len(line) - len(stripped)]
        if key in OMARCHY_MOVES:
            out.append(indent + OMARCHY_MOVES[key] + stripped[len(key):])
            out.append(indent + OMARCHY_BINDS[key])
            continue
        out.append(line)
        if stripped.startswith("binds {"):
            out.append("    // Omarchy keymap (herald-os keymap herald switches back).")
            out.append("    " + OMARCHY_BINDS["Mod+X"])
    return "\n".join(out) + "\n"


def keymap_cmd(args: list[str]) -> int:
    action = args[0] if args else "show"
    if action == "show":
        print(current_keymap())
        return 0
    if action in KEYMAPS:
        if action == "omarchy" and not shutil.which("wtype"):
            die("the Omarchy keymap types copy and paste with wtype; install it first (sudo dnf install wtype)", 127)
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        KEYMAP_FILE.write_text(action + "\n")
    elif action != "apply":
        die("keymap show | herald | omarchy | apply", 2)
    template = next((path for path in NIRI_TEMPLATES if path.is_file()), None)
    if not template:
        die("the niri template is missing; reinstall Herald OS or run herald-os-build")
    rendered = render_keymap(template.read_text(), current_keymap())
    # niri reloads on every write: only a changed config is written, once and atomically, so it
    # never reads half a file.
    if not NIRI_CONFIG.is_file() or NIRI_CONFIG.read_text(errors="replace") != rendered:
        NIRI_CONFIG.parent.mkdir(parents=True, exist_ok=True)
        staging = NIRI_CONFIG.with_suffix(".kdl.new")
        staging.write_text(rendered)
        staging.replace(NIRI_CONFIG)
    if action != "apply":
        print(f"keymap: {current_keymap()}" + (" (Super+C, X and V copy, cut and paste; voice moved to Super+Shift+V)" if current_keymap() == "omarchy" else ""))
    return 0


# ---------------------------------------------------------------------------------------------
# Per-user setup after installing the package: Hermes, and the bridge plugin that gives it the system.
HERMES_HOME = Path(os.environ.get("HERMES_HOME") or HOME / ".hermes")
BRIDGE_DIRS = [HOME / "Herald-OS" / "plugins" / "herald-os-bridge", Path("/usr/share/herald-os/bridge"), Path("/opt/herald-os/resources/herald-os-bridge")]
HERMES_INSTALLER = "https://hermes-agent.nousresearch.com/install.sh"
# On the Herald OS image: Hermes did not install at the first boot, and herald-os-hermes.service is
# installing it (firstboot.sh). What is in it says how that goes.
HERMES_PENDING = Path("/var/lib/herald-os/hermes-pending")


def hermes_checkout(root: Path) -> list[str] | None:
    """A Hermes Agent checkout's own command: the launcher today's installers publish in it
    (.hermes/bin/hermes, which runs the Python and dependencies kept in ~/.hermes/tools and
    ~/.hermes/installs) or the venv earlier ones made. The launcher first: an update to the new layout
    leaves the old venv behind, unused. Only beside the `serve` subcommand the shell runs."""
    if not (root / "hermes_cli" / "subcommands" / "dashboard.py").is_file():
        return None
    for command in (root / ".hermes" / "bin" / "hermes", root / "venv" / "bin" / "hermes"):
        if command.is_file() and os.access(command, os.X_OK):
            return [str(command)]
    return None


def hermes_install() -> tuple[str, list[str]] | None:
    """How this account runs Hermes Agent, looked for the way the shell does
    (apps/desktop/electron/backend/resolve.ts): HERALD_OS_HERMES_ROOT ("env"), then the checkout in
    $HERMES_HOME/hermes-agent ("managed"), then `hermes` on the PATH or in ~/.local/bin ("path"),
    where the installers put it and where the PATH of sudo and of systemd units does not look."""
    override = (os.environ.get("HERALD_OS_HERMES_ROOT") or os.environ.get("HERMES_OS_HERMES_ROOT") or "").strip()
    for kind, root in (("env", Path(override) if override else None), ("managed", HERMES_HOME / "hermes-agent")):
        command = hermes_checkout(root) if root else None
        if command:
            return kind, command
    found = shutil.which("hermes") or shutil.which("hermes", path=str(HOME / ".local" / "bin"))
    return ("path", [found]) if found else None


def hermes_command() -> list[str] | None:
    install = hermes_install()
    return install[1] if install else None


TOOL_SEARCH = "tools.tool_search.enabled"
# `hermes tools enable` reports an unknown toolset as a ✗ line and still exits 0.
HERMES_ERROR = re.compile(r"^\s*✗", re.M)
ANSI = re.compile(r"\x1b\[[0-9;]*m")


def tool_search_before() -> Path:
    """Every Herald OS setup (this command, the app's first start, scripts/bootstrap.sh) writes the value
    it found here before turning Tool Search off, and only the first time, so `setup --undo` can put it back."""
    return HERMES_HOME / "herald-os" / "tool-search-before"


def hermes_run(hermes: list[str], args: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run([*hermes, *args], stdin=subprocess.DEVNULL, capture_output=True, text=True, check=False, env={**os.environ, "NO_COLOR": "1"})


def hermes_step(hermes: list[str], args: list[str], change: str, gone: str | None = None) -> None:
    """Run one `hermes` command and say what it changes; a failure stops here with Hermes's output.
    Output matching `gone` means there was nothing left to change."""
    command = "hermes " + " ".join(args)
    print(f"==> {command}: {change}")
    result = hermes_run(hermes, args)
    output = ANSI.sub("", f"{result.stdout or ''}\n{result.stderr or ''}").strip()
    if gone and re.search(gone, output):
        print("    nothing to change")
        return
    if result.returncode != 0 or HERMES_ERROR.search(output):
        die(f"`{command}` failed (exit {result.returncode}){': ' + output if output else ''}\nRun herald-os setup again once it is fixed, or herald-os setup --undo to take back what was already changed.", 1)


def hermes_value(hermes: list[str], key: str) -> str:
    """A setting as `hermes config get` prints it, which `hermes config set` reads back unchanged."""
    result = hermes_run(hermes, ["config", "get", key])
    lines = [line.strip() for line in ANSI.sub("", result.stdout or "").splitlines() if line.strip()]
    if result.returncode != 0 or not lines:
        die(f"`hermes config get {key}` failed (exit {result.returncode}): {(result.stderr or result.stdout or '').strip()}", 1)
    return lines[-1]


def enable_bridge(hermes: list[str]) -> None:
    """User plugins are opt-in and a saved toolset list is authoritative, so both are recorded. Tool
    Search would hide plugin tools behind a lookup, and it has no per-plugin switch (ADR-010)."""
    hermes_step(hermes, ["plugins", "enable", "herald-os-bridge"], f"adds it to plugins.enabled in {HERMES_HOME / 'config.yaml'}")
    hermes_step(hermes, ["tools", "enable", "herald_os"], "saves platform_toolsets.cli with herald_os in it (Herald OS's sessions share that list with the hermes CLI; the tools run only in Herald OS sessions)")
    before, record = hermes_value(hermes, TOOL_SEARCH), tool_search_before()
    if before == "off":
        print(f"==> {TOOL_SEARCH} is off already")
        return
    if not record.exists():
        record.parent.mkdir(parents=True, exist_ok=True)
        record.write_text(before + "\n")
    hermes_step(hermes, ["config", "set", TOOL_SEARCH, "off"], f"turns Tool Search off for every Hermes session, so the system tools stay directly callable (it was {before}; saved in {record}, and Settings > Hermes & agents > Tool search turns it back on)")


def setup_undo() -> int:
    """Take back what setup changed in Hermes: the toolset, the plugin, Tool Search and the link."""
    hermes = hermes_command()
    link = HERMES_HOME / "plugins" / "herald-os-bridge"
    if hermes:
        # Hermes knows the toolset only while the plugin is linked and enabled, so it goes first.
        hermes_step(hermes, ["tools", "disable", "herald_os"], "takes herald_os out of platform_toolsets.cli", gone="Unknown toolset")
        hermes_step(hermes, ["plugins", "disable", "herald-os-bridge"], "moves it from plugins.enabled to plugins.disabled", gone="No plugin named")
        restore_tool_search(hermes)
    else:
        print("Hermes Agent is not installed, so only the plugin link is removed.")
    if link.is_symlink():
        link.unlink()
        print(f"==> removed the plugin link {link}")
    elif link.exists():
        print(f"==> {link} is a folder Herald OS did not make; left alone")
    # The app turns the bridge on at its first start unless this marker says that happened already.
    marker = HERMES_HOME / "herald-os" / "bridge-enabled"
    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.touch()
    print("Herald OS no longer changes your Hermes; `herald-os setup` makes the changes again.")
    return 0


def restore_tool_search(hermes: list[str]) -> None:
    current, record = hermes_value(hermes, TOOL_SEARCH), tool_search_before()
    if current != "off":
        print(f"==> {TOOL_SEARCH} is {current}, not off; left as it is")
    elif record.exists():
        before = record.read_text().strip()
        hermes_step(hermes, ["config", "set", TOOL_SEARCH, before], f"back to {before}, its value before Herald OS")
    else:
        # Setups before the record existed turned it off without one; Hermes's default is the likely value.
        hermes_step(hermes, ["config", "set", TOOL_SEARCH, "auto"], f"back to Hermes's default, auto (Herald OS kept no record of the value before; hermes config set {TOOL_SEARCH} off if you had it off yourself)")
    record.unlink(missing_ok=True)


def setup(args: list[str]) -> int:
    """Link the bridge plugin into Hermes, turn on its tools, and install Hermes if it is missing."""
    if args[:1] == ["--undo"]:
        return setup_undo()
    if args[:1] == ["fingerprint"]:
        return setup_sign_in("fingerprint")
    if args[:1] == ["fido2"]:
        return setup_sign_in("fido2")
    if args[:1] == ["ssh"]:
        return setup_ssh(args[1:])
    assume_yes = "--yes" in args or "-y" in args
    bridge = next((d for d in BRIDGE_DIRS if (d / "plugin.yaml").exists()), None)
    if not bridge:
        die("the herald-os-bridge plugin is missing; reinstall Herald OS", 1)
    hermes = hermes_command()
    if not hermes:
        if HERMES_PENDING.exists():
            # A second installer in the same checkout would race the one already at work.
            status = HERMES_PENDING.read_text().strip() or "pending"
            die(f"Hermes Agent is not installed yet. herald-os-hermes.service installs it once this computer is online, then sets it up ({status} now): `journalctl -u herald-os-hermes -f` follows it, `sudo systemctl restart herald-os-hermes` tries again at once", 1)
        print(f"Hermes Agent is not installed. Herald OS runs on it; the installer is {HERMES_INSTALLER}")
        if not assume_yes:
            if not sys.stdin.isatty():
                die("`herald-os setup --yes` installs it and then sets it up (in a terminal, `herald-os setup` asks first)", 1)
            if input("Install Hermes Agent now? [Y/n] ").strip().lower() not in ("", "y", "yes"):
                die("run `herald-os setup` again once Hermes is installed", 1)
        code = subprocess.call(["bash", "-c", f"curl -fsSL {HERMES_INSTALLER} | bash"])
        hermes = hermes_command()
        if code != 0 or not hermes:
            die("the Hermes installer did not finish; see its output above", 1)
    plugins = HERMES_HOME / "plugins"
    plugins.mkdir(parents=True, exist_ok=True)
    link = plugins / "herald-os-bridge"
    if link.is_symlink():
        link.unlink()
    elif link.exists():
        die(f"{link} exists and is not a link Herald OS made; move it aside and run setup again", 1)
    link.symlink_to(bridge)
    print(f"==> bridge plugin: {link} -> {bridge}")
    enable_bridge(hermes)
    print("==> Hermes can now use the system (files, apps, settings), asking before anything that changes it")
    print("    To take these changes back: herald-os setup --undo")
    if is_omarchy():
        print("Omarchy: `herald-os omarchy install` adds Herald OS to its menu, theme and keys.")
    print(session_hint())
    return 0


def setup_sign_in(kind: str) -> int:
    """Fingerprint (fprintd) or a security key (pam-u2f) for the lock screen and sudo."""
    if not sys.stdin.isatty():
        die(f"setup {kind} needs a terminal: you touch the sensor or the key while it runs", 2)
    # Omarchy has its own setup for both, which also covers its lock screen and polkit (Omarchy 4's
    # name first, then Omarchy 3's).
    if is_omarchy():
        names = ("omarchy-setup-security-fingerprint", "omarchy-setup-fingerprint") if kind == "fingerprint" else ("omarchy-setup-security-fido2", "omarchy-setup-fido2")
        tool = next((found for found in map(omarchy_tool, names) if found), None)
        if tool:
            return subprocess.call([tool])
    if kind == "fingerprint":
        if not shutil.which("fprintd-enroll"):
            die("fprintd is not installed (sudo dnf install fprintd fprintd-pam, or pacman -S fprintd)", 127)
        print("Touch the fingerprint sensor several times when asked.")
        code = subprocess.call(["fprintd-enroll"])
        feature, pam = "with-fingerprint", "auth sufficient pam_fprintd.so"
    else:
        if not shutil.which("pamu2fcfg"):
            die("pam-u2f is not installed (sudo dnf install pam-u2f pamu2fcfg, or pacman -S pam-u2f)", 127)
        keys = HOME / ".config" / "Yubico" / "u2f_keys"
        keys.parent.mkdir(parents=True, exist_ok=True)
        print("Touch your security key when it blinks.")
        registration = subprocess.run(["pamu2fcfg"], capture_output=True, text=True)
        if registration.returncode != 0 or not registration.stdout.strip():
            die(registration.stderr.strip() or "the key did not register", 1)
        # One line per user; a second key appends its credential to the same line.
        line = registration.stdout.strip()
        existing = keys.read_text().strip() if keys.exists() else ""
        keys.write_text((existing + line[line.index(":"):] if existing.startswith(line.split(":", 1)[0] + ":") else line) + "\n")
        keys.chmod(0o600)
        code = 0
        feature, pam = "with-pam-u2f", "auth sufficient pam_u2f.so cue"
    if code != 0:
        return code
    what = "fingerprint" if kind == "fingerprint" else "security key"
    if shutil.which("authselect"):
        # Fedora: one switch turns it on for the lock screen, sudo and the login screen.
        code = subprocess.call(["sudo", "authselect", "enable-feature", feature])
        if code == 0:
            print(f"Done: the lock screen and sudo accept your {what} as well as your password.")
        return code
    # Arch: the line goes into sudo and Herald's lock screen (swaylock), with a backup of every
    # file it changes. hyprlock does fingerprints itself and is left alone.
    changed = [file for file in PAM_FILES if Path(file).exists() and pam_enable(Path(file), pam)]
    if not any(Path(file).exists() for file in PAM_FILES):
        die(f"none of {', '.join(PAM_FILES)} exist; add this line to your PAM config yourself:\n  {pam}", 1)
    print(f"Done: sudo and the lock screen accept your {what} as well as your password." + (f" (changed {', '.join(changed)}; a .herald-os.bak copy sits next to each)" if changed else " (already set up)"))
    return 0


PAM_FILES = ("/etc/pam.d/sudo", "/etc/pam.d/swaylock")


def pam_with(text: str, line: str) -> str | None:
    """`text` with `line` as its first auth rule, or None when it is already there (pure; tested)."""
    rules = text.splitlines()
    if any(rule.split() == line.split() for rule in rules):
        return None
    at = next((i for i, rule in enumerate(rules) if rule.split()[:1] == ["auth"]), None)
    if at is None:
        # No auth rules of its own (only includes): after the header and comments.
        at = next((i for i, rule in enumerate(rules) if rule.strip() and not rule.lstrip().startswith("#")), len(rules))
    return "\n".join([*rules[:at], line, *rules[at:]]) + "\n"


def pam_enable(file: Path, line: str) -> bool:
    """Put `line` first in a PAM file through sudo, keeping a backup; False when it was already there."""
    updated = pam_with(file.read_text(), line)
    if updated is None:
        return False
    backup = Path(f"{file}.herald-os.bak")
    if not backup.exists():
        subprocess.run(["sudo", "cp", "-p", str(file), str(backup)], check=True)
    subprocess.run(["sudo", "tee", str(file)], input=updated, text=True, stdout=subprocess.DEVNULL, check=True)
    return True


# ---------------------------------------------------------------------------------------------
# SSH: off as the image ships it (sshd disabled, nothing in the firewall zone) until someone turns it
# on, and then for keys only unless they ask for passwords as well.
# sshd keeps the first value it reads for each setting and reads sshd_config.d in name order, so 10-
# comes before the distributions' own files (Fedora's 50-redhat.conf, cloud-init's 50-cloud-init.conf).
SSHD_DROP_IN = Path("/etc/ssh/sshd_config.d/10-herald-os.conf")
SSHD_CONFIG = Path("/etc/ssh/sshd_config")
SSH_HOST_KEYS = Path("/etc/ssh")
SSH_UNITS = ("sshd.service", "sshd.socket")
SSH_RICH_RULE = 'rule service name="ssh" accept'
# The rate limit is per source address, which firewalld cannot express: a rich rule's `limit` counts
# every source together (so anyone could use it up and lock everyone else out), and its direct
# interface is deprecated and needs iptables. It is an nftables table of Herald OS's own instead,
# hooked in before firewalld's (which leaves other tables alone): new SSH connections over the rate
# from one IPv4 address, or one IPv6 /64, are dropped there, whatever the zone. A unit loads it at boot.
SSH_LIMIT_TABLE = "herald_os_ssh"
SSH_LIMIT_RULES = Path("/etc/herald-os/ssh-limit.nft")
SSH_LIMIT_UNIT = Path("/etc/systemd/system/herald-os-ssh-limit.service")
# sshd.service and sshd.socket require the limit and start after it, so when it fails (at boot or
# later) systemd leaves sshd stopped, and stopping it stops sshd too. The socket gets one whether or not
# it is enabled now: enabling it later (or a distribution that activates sshd by socket) must not
# bring sshd up without the limit.
SSH_LIMIT_REQUIRED = (
    Path("/etc/systemd/system/sshd.service.d/10-herald-os-limit.conf"),
    Path("/etc/systemd/system/sshd.socket.d/10-herald-os-limit.conf"),
)
SSH_LIMIT_RATE = "4/minute"
# What sshd accepts today; DSA keys are gone from OpenSSH 9.8.
SSH_KEY_TYPES = (
    "ssh-ed25519", "ssh-rsa", "ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384", "ecdsa-sha2-nistp521",
    "sk-ssh-ed25519@openssh.com", "sk-ecdsa-sha2-nistp256@openssh.com",
)
# The types as `ssh-keygen -lf` names them, and the shortest RSA key taken.
SSH_KEYGEN_TYPES = ("ED25519", "ECDSA", "ED25519-SK", "ECDSA-SK", "RSA")
RSA_MIN_BITS = 2048
# What --user may name: a local account's name as useradd takes it.
ACCOUNT_NAME = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_.-]{0,31}$")
GITHUB_USER = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$")
# A GitHub key page is a few lines: https all the way, few redirects, and nothing past 1 MiB.
GITHUB_MAX_BYTES = 1 << 20
GITHUB_CURL = [
    "curl", "-fsSL", "--proto", "=https", "--proto-redir", "=https", "--max-redirs", "3",
    "--max-filesize", "1M", "--connect-timeout", "10", "--max-time", "20",
]
# Connections sshd is asked about: the default, this computer, and someone on the internet signing
# in as the account and as root, so a Match block for any of them shows.
SSH_PROBE_ADDRESS = "203.0.113.1"
SSH_USAGE = (
    "setup ssh [--key <public key>]... [--github <user>]... [--keys-file <file>] [--passwords] [--no-firewall | --offline-firewall] [--user <name>]"
    " | setup ssh --off [--end-sessions] | setup ssh --status [--json] [--user <name>]"
)


def as_root(argv: list[str]) -> list[str]:
    """`argv` as root: unchanged when this runs as root already, else through `sudo -n`. ssh_sudo() has
    asked for the password up front (interactively: `sudo -n -v` would refuse people whose rules use
    verifypw=all), so a later sudo never needs to ask. Each command runs in a process group of its
    own, in the background of the terminal, where a sudo that did ask would stop on SIGTTIN until its
    timeout; with -n, sudo whose cached password has run out fails at once instead."""
    if os.geteuid() == 0:
        return argv
    return ["sudo", "-n", *argv]


# Every command `setup ssh` runs gets this long, so a hung nft, systemctl, firewall-cmd or sshd
# raises TimeoutExpired (killing it) and `on` rolls back, rather than waiting forever.
SSH_TIMEOUT = 120


# How long a command that timed out gets to end on SIGTERM before its group is sent SIGKILL.
SSH_KILL_GRACE = 3


def ssh_limit(timeout: float | None) -> float:
    return timeout or SSH_TIMEOUT


def ssh_run(argv: list[str], timeout: float | None = None, input: str | None = None,
            grace: float | None = None) -> subprocess.CompletedProcess:
    """A command in a process group of its own, so a timeout ends all of it. A new group, not a new
    session: the terminal stays, so sudo still finds the credentials cached for it. Ending it takes at
    most twice `grace` (SSH_KILL_GRACE when not given) on top of the timeout."""
    limit = ssh_limit(timeout)
    process = subprocess.Popen(argv, stdin=subprocess.PIPE if input is not None else subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, process_group=0)
    try:
        out, err = process.communicate(input, timeout=limit)
    except BaseException as error:
        ssh_kill(process, SSH_KILL_GRACE if grace is None else grace)
        if isinstance(error, subprocess.TimeoutExpired):
            raise subprocess.TimeoutExpired(argv, limit) from None
        raise
    return subprocess.CompletedProcess(argv, process.returncode, out, err)


# Commands that were still running after ssh_kill: a root command under sudo, in a session of its
# own when sudo uses a pty, which neither the group's SIGKILL nor this account can reach. Each is the
# command and its process tree as it was when it was killed; ssh_reap ends them as root.
SSH_LEFT: list[dict] = []
# Whether this run reached loading the rate-limit table, so the rollback knows a table may be live.
SSH_LOADED: list[bool] = []


def ssh_processes() -> dict[int, tuple[int, int, int, int, str]]:
    """Every process: pid -> (parent, group, session, start time, state), from /proc/<pid>/stat, which
    anyone can read, root's processes included. Raises OSError when /proc cannot be listed."""
    found = {}
    for entry in os.scandir("/proc"):
        if not entry.name.isdigit():
            continue
        try:
            with open(f"/proc/{entry.name}/stat", "rb") as handle:
                text = handle.read().decode(errors="replace")
            # The name, in parentheses, may hold spaces and parentheses itself.
            fields = text[text.rindex(")") + 2:].split()
            found[int(entry.name)] = (int(fields[1]), int(fields[2]), int(fields[3]), int(fields[19]), fields[0])
        except (OSError, ValueError, IndexError):
            continue
    return found


def ssh_tree(pid: int) -> dict:
    """A command and every process under it (with its start time, so a reused pid is not taken for
    it), and the process groups and sessions they are in, but for this process's own. Each recorded
    process is found later by its pid even if it moves; what a process forks after this record, once it
    is outside every recorded group and session, is beyond the record. See ssh_alive for the window and
    the reach this leaves."""
    processes = ssh_processes()
    children: dict[int, list[int]] = {}
    for each, (parent, *_) in processes.items():
        children.setdefault(parent, []).append(each)
    members: dict[int, int] = {}
    todo = [pid]
    while todo:
        each = todo.pop()
        if each in processes and each not in members:
            members[each] = processes[each][3]
            todo += children.get(each, [])
    own = {os.getpgrp(), os.getsid(0)}
    return {"pids": members, "groups": {processes[each][1] for each in members} - own,
            "sessions": {processes[each][2] for each in members} - own}


def ssh_alive(tree: dict) -> list[int]:
    """What of a tree still runs: its own processes (by pid and start time), and any other in its
    groups or sessions, which is what the command started or left there (a child it orphaned keeps the
    group and session, so it is caught too). A zombie has ended. Raises OSError when /proc cannot be
    listed. A group or session no process carries any more (a zombie still does) is dropped from the
    tree for good, so a new leader later given that freed id is not taken for the tree's. That drop is
    the only guard against reuse; it needs no start time or /proc/uptime, so nothing is weakened when
    those cannot be read. Its one gap is a freed id taken by an unrelated process before any check sees
    it empty, so the id is never dropped. ssh_kill checks the id at its own end (right after the group is
    signalled, which drops any id the kill has emptied), then it is checked at the start-of-rollback reap
    and the final reap. The start-of-rollback reap bounds the common case: the gap from the record to it
    is at most about fourteen seconds (the ten-second sudo renewal plus its two kill graces and the
    spare), and about zero as root (no sudo renewal). A record the first reap could not end keeps the
    window open to the final reap, up to the rest of the rollback budget, so minutes. (The tenth-of-a-
    second polling is only within a single reap, waiting for a kill to take; it is not this window.) For
    the gap to bite, the whole id must empty and a pid wrap onto its leader within it; the cost would be
    ending one stray process, never leaving SSH open, so the simple drop is kept over a start-time guard,
    which wrongly skipped the command's own orphans. Reach is bounded too. A recorded process is always
    found, by pid and start time, even if it moves group or session. A process the record does not hold
    is caught only through the command's group or session. (`sudo -n` only means sudo never prompts; the
    terminal stays.) With a controlling terminal and use_pty (sudo's default since 1.9.14), the command
    gets its own recorded session, so a group change (setpgid) alone is caught and only setsid escapes,
    leaving that session too. As root, with !use_pty, or with no controlling terminal, the command shares
    this process's session, which ssh_tree drops as ours, so a group change escapes too: for example one
    forked after the record that regroups, or one orphaned before the record (never held) that regroups.
    Those that escape are in no id the tree holds, are not found, reaped or warned about, and SSH is not
    necessarily left closed: an escaped root command could run a firewall-cmd add after the reap and the
    final rule check, reopening SSH. Catching them needs a cgroup or a transient systemd scope, a
    follow-up."""
    processes = ssh_processes()
    tree["groups"] &= {group for _, group, _, _, _ in processes.values()}
    tree["sessions"] &= {session for _, _, session, _, _ in processes.values()}
    return sorted(pid for pid, (_, group, session, start, state) in processes.items()
                  if pid > 1 and pid != os.getpid() and state not in ("Z", "X")
                  and (tree["pids"].get(pid) == start or group in tree["groups"] or session in tree["sessions"]))


def ssh_kill(process: subprocess.Popen, grace: float) -> None:
    """End a command's whole group: SIGTERM first, which sudo passes on to the command it runs (in a
    session of its own when sudo uses a pty), then SIGKILL after `grace`. The SIGKILL reaches
    the group, which is sudo, but not a root command in a session of its own under it. Whatever of
    the command's tree still runs after that goes into SSH_LEFT, for ssh_reap. The waits are on the
    process, not its output: a root command left running may hold the pipes open."""
    try:
        tree = ssh_tree(process.pid)
    except OSError:
        tree = None
    for signum in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(process.pid, signum)
        except (ProcessLookupError, PermissionError):
            pass
        try:
            process.wait(timeout=grace)
            break
        except subprocess.TimeoutExpired:
            continue
    for stream in (process.stdin, process.stdout, process.stderr):
        try:
            if stream:
                stream.close()
        except OSError:
            pass
    try:
        left = tree is None or bool(ssh_alive(tree))
    except OSError:
        left = True
    if left:
        SSH_LEFT.append({"argv": list(process.args), "tree": tree})


# What ending a command takes besides its two graces: closing its pipes and reading /proc for what of
# it is left.
SSH_KILL_SPARE = 0.2


def ssh_slot(most: float, left: float) -> tuple[float, float] | None:
    """A timeout of at most `most` and a kill grace for a command that must be over, killed or not,
    within `left` seconds: the grace an eighth of that (at most SSH_KILL_GRACE), counted twice (SIGTERM,
    then SIGKILL), with SSH_KILL_SPARE for looking at what is left. None when that leaves too little."""
    length = min(most + 2 * SSH_KILL_GRACE + SSH_KILL_SPARE, left)
    grace = min(SSH_KILL_GRACE, length / 8)
    timeout = min(most, length - 2 * grace - SSH_KILL_SPARE)
    return (timeout, grace) if timeout >= 0.1 else None


def ssh_reap(timeout: float) -> list[str]:
    """End what SSH_LEFT holds as root (`kill`, through sudo -n unless this is root): SIGTERM, then
    SIGKILL after SSH_KILL_GRACE, then wait until none of it is left, all within `timeout`. Returns
    the commands it could not see end (the rest leave SSH_LEFT)."""
    deadline = time.monotonic() + timeout

    def alive() -> list[int] | None:
        try:
            return sorted({pid for left in SSH_LEFT if left["tree"] for pid in ssh_alive(left["tree"])})
        except OSError:
            return None
    for signum, wait in ((signal.SIGTERM, SSH_KILL_GRACE), (signal.SIGKILL, None)):
        pids = alive()
        if not pids:
            break
        given = ssh_slot(10, deadline - time.monotonic())
        if given:
            try:
                ssh_run(as_root(["kill", "-s", signum.name[3:], "--", *map(str, pids)]), timeout=given[0], grace=given[1])
            except (subprocess.TimeoutExpired, OSError):
                pass
        until = deadline if wait is None else min(deadline, time.monotonic() + wait)
        while alive() and time.monotonic() < until:
            time.sleep(0.1)
    still = []
    for left in list(SSH_LEFT):
        try:
            running = left["tree"] is None or bool(ssh_alive(left["tree"]))
        except OSError:
            running = True
        if running:
            still.append(" ".join(left["argv"]))
        else:
            SSH_LEFT.remove(left)
    return still


def root_run(argv: list[str], timeout: float | None = None, grace: float | None = None) -> subprocess.CompletedProcess:
    return ssh_run(as_root(argv), timeout=timeout, grace=grace)


def ssh_sudo() -> None:
    """Have sudo ask for the password, if it wants one, before anything changes and before any command
    is timed: the prompt waits for the person, however long they take."""
    if os.geteuid() == 0:
        return
    if sys.stdin.isatty():
        code = subprocess.call(["sudo", "-v"])
    else:
        try:
            code = ssh_run(["sudo", "-n", "-v"]).returncode
        except subprocess.TimeoutExpired:
            code = 1
    if code != 0:
        die("setup ssh needs root through sudo, which did not let it in (in a terminal it asks for your "
            "password; elsewhere it needs a password-free rule, or run this as root). Nothing was changed.", 1)


def root_step(argv: list[str], what: str, timeout: float | None = None, grace: float | None = None) -> None:
    result = root_run(argv, timeout, grace)
    if result.returncode != 0:
        output = (result.stderr or result.stdout or "").strip()
        die(f"{what} failed: `{' '.join(argv)}` (exit {result.returncode}){': ' + output if output else ''}", 1)


def warn(message: str) -> None:
    print(f"herald-os: WARNING: {message}", file=sys.stderr)


def ssh_key_problem(text: str) -> str | None:
    """Why a line is not one public key the way authorized_keys takes it (type, key, comment), or None
    when it is: several lines, options in front, a type sshd no longer takes, or key data of another
    type (pure; tested)."""
    if "\n" in text.strip() or "\r" in text:
        return "more than one line"
    fields = text.split()
    if len(fields) < 2:
        return "not a type and a key"
    if fields[0] not in SSH_KEY_TYPES:
        return "not a key type sshd takes"
    try:
        blob = base64.b64decode(fields[1], validate=True)
    except ValueError:
        return "the key is not base64"
    size = int.from_bytes(blob[:4], "big")
    if len(blob) <= 4 + size or blob[4:4 + size] != fields[0].encode():
        return "the key's data is of another type"
    return None


def ssh_key(text: str) -> str | None:
    """The key as authorized_keys takes it, or None when it is not one (pure; tested)."""
    return None if ssh_key_problem(text) else " ".join(text.split())


def ssh_key_type(text: str) -> str:
    """A key line's type, safe to log; never any of the key itself (pure; tested)."""
    first = (text.split() or [""])[0]
    return first if re.fullmatch(r"[A-Za-z0-9@._-]{1,48}", first) else "unknown"


def key_weakness(listing: str) -> str | None:
    """Why a key `ssh-keygen -lf` lists this way is not taken, or None when it is: an Ed25519 or ECDSA
    key, a security-key one, or RSA of 2048 bits or more (pure; tested)."""
    fields = listing.split()
    if len(fields) < 3 or not fields[0].isdigit() or not fields[-1].startswith("("):
        return "ssh-keygen cannot read it"
    kind = fields[-1].strip("()")
    if kind not in SSH_KEYGEN_TYPES:
        return f"{kind} keys are not taken"
    if kind == "RSA" and int(fields[0]) < RSA_MIN_BITS:
        return f"an RSA key of {fields[0]} bits is too short ({RSA_MIN_BITS} at least)"
    return None


def key_listing(key: str) -> tuple[str, str | None]:
    """`ssh-keygen -lf` for one key (bits, fingerprint, comment, type), and why it is not taken, if so."""
    if not shutil.which("ssh-keygen"):
        die("ssh-keygen is not installed (sudo dnf install openssh, or pacman -S openssh). Nothing was changed.", 127)
    result = ssh_run(["ssh-keygen", "-lf", "-"], input=key + "\n")
    listing = result.stdout.strip() if result.returncode == 0 else ""
    return listing, key_weakness(listing)


def authorized(text: str) -> list[str]:
    """The keys (type and key) an authorized_keys file lets in, with options in front of them or not;
    comments and broken lines let no one in (pure; tested)."""
    keys = []
    for line in text.splitlines():
        fields = line.split()
        if not fields or fields[0].startswith("#"):
            continue
        for at, field in enumerate(fields[:-1]):
            if field in SSH_KEY_TYPES and ssh_key(f"{field} {fields[at + 1]}"):
                keys.append(f"{field} {fields[at + 1]}")
                break
    return keys


def with_keys(text: str, keys: list[str]) -> tuple[str, list[str]]:
    """authorized_keys with `keys` added at the end, and which of them it did not have yet. The lines
    already there stay exactly as they were (pure; tested)."""
    have, added = set(authorized(text)), []
    for key in keys:
        bare = " ".join(key.split()[:2])
        if bare not in have:
            have.add(bare)
            added.append(key)
    if not added:
        return text, []
    return (text if not text or text.endswith("\n") else text + "\n") + "".join(f"{key}\n" for key in added), added


def sshd_drop_in(passwords: bool) -> str:
    """The sshd settings `setup ssh` adds (pure; tested)."""
    return (
        "# Written by `herald-os setup ssh`; `herald-os setup ssh --off` removes it.\n"
        "PermitRootLogin no\n"
        f"PasswordAuthentication {'yes' if passwords else 'no'}\n"
        "KbdInteractiveAuthentication no\n"
        "PermitEmptyPasswords no\n"
    )


def sshd_overruled(effective: str, passwords: bool) -> list[str]:
    """What `sshd -T` reports that the drop-in did not get its way on, because a file sshd reads before
    it says otherwise; a setting it does not report counts as overruled (pure; tested)."""
    values: dict[str, str] = {}
    for line in effective.splitlines():
        key, _, value = line.strip().partition(" ")
        values.setdefault(key.lower(), value.strip().lower())
    wanted = {"permitrootlogin": "no", "kbdinteractiveauthentication": "no", "permitemptypasswords": "no"}
    if not passwords:
        wanted["passwordauthentication"] = "no"
    return [f"{key} is {values.get(key, 'not reported')}, not {value}" for key, value in wanted.items() if values.get(key) != value]


# The settings the scan reports, spelled as sshd_config(5) spells them.
SSHD_NAMES = {
    "passwordauthentication": "PasswordAuthentication", "kbdinteractiveauthentication": "KbdInteractiveAuthentication",
    "challengeresponseauthentication": "ChallengeResponseAuthentication", "permitrootlogin": "PermitRootLogin",
    "permitemptypasswords": "PermitEmptyPasswords", "authenticationmethods": "AuthenticationMethods",
}


def sshd_weaker(key: str, value: str, passwords: bool) -> bool:
    """Whether a setting lets in more than the drop-in does (pure; tested)."""
    value = value.strip().strip('"').lower()
    if key == "passwordauthentication":
        return value != "no" and not passwords
    if key in ("kbdinteractiveauthentication", "challengeresponseauthentication", "permitrootlogin", "permitemptypasswords"):
        return value != "no"
    if key == "authenticationmethods":
        methods = value.replace(",", " ").split()
        return any(method.startswith("keyboard-interactive") or (method == "password" and not passwords) for method in methods)
    return False


# A setting line as sshd reads it: the keyword (any case), then whitespace or an "=" (with or without
# spaces around it), then its arguments.
SSHD_KEYWORD = re.compile(r"(\S+?)(\s*=\s*|\s+)(.*)$")


def sshd_words(text: str) -> list[str] | None:
    """Arguments split the way sshd splits them (argv_split in OpenSSH's misc.c): whitespace outside
    quotes ends a word, single or double quotes group one, a backslash escapes a quote, a backslash or
    an unquoted space, and a # that starts a word starts a comment. None when a quote is never closed
    (pure; tested)."""
    words: list[str] = []
    word: list[str] = []
    quote, started, at = "", False, 0
    while at < len(text):
        char = text[at]
        if not quote and char in " \t":
            if started:
                words.append("".join(word))
                word, started = [], False
        elif not quote and char == "#" and not started:
            break
        elif char == "\\" and at + 1 < len(text) and (text[at + 1] in "'\"\\" or (not quote and text[at + 1] == " ")):
            at += 1
            word.append(text[at])
            started = True
        elif char in "'\"" and quote in ("", char):
            quote = "" if quote else char
            started = True
        else:
            word.append(char)
            started = True
        at += 1
    if quote:
        return None
    if started:
        words.append("".join(word))
    return words


def sshd_settings(text: str) -> list[tuple[int, str, list[str] | None, bool]]:
    """Each setting in an sshd file: its line number, its keyword (lower case), its arguments (None
    when they cannot be split, as with a quote never closed), and whether they were written with "="
    or quotes, the forms an Include must not use to name nothing (pure; tested)."""
    settings = []
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parsed = SSHD_KEYWORD.match(line)
        keyword, separator, value = parsed.groups() if parsed else (line, "", "")
        settings.append((number, keyword.lower(), sshd_words(value), "=" in separator or "'" in value or '"' in value))
    return settings


def match_weakening(files: list[tuple[str, str]], passwords: bool) -> list[str]:
    """Settings under a Match block, in any of sshd's files, that let in more than the drop-in: such a
    block wins over it for the connections it matches. A Match lasts until the next one or the end of
    its file. An Include under a Match is refused outright: everything in the included file would be
    conditional, and this check reads each file on its own (pure; tested)."""
    found = []
    for name, text in files:
        match = None
        for number, keyword, args, _ in sshd_settings(text):
            if args is None:
                # An unparsable Include is sshd_files's to report; any other line, this one's.
                if keyword != "include":
                    found.append(f"{name} line {number}: {keyword} has a quote that is never closed, so it cannot be read the way sshd reads it")
                continue
            value = " ".join(args)
            if keyword == "match":
                match = value
            elif match is not None and keyword == "include":
                found.append(f"{name} line {number}: Include {value} under Match {match}, which setup ssh does not check "
                             "(move the Include above the first Match)")
            elif match is not None and sshd_weaker(keyword, value, passwords):
                found.append(f"{name} line {number}: {SSHD_NAMES.get(keyword, keyword)} {value} under Match {match}")
    return found


# Lists what an Include pattern matches, as root (only root may list Fedora's sshd_config.d): the
# pattern is an argument, expanded by the shell's globbing alone (IFS empty, so no splitting, and no
# other expansion of its text), and the names come back NUL-separated, whatever they contain.
SSHD_GLOB = 'IFS=; for f in $1; do if [ -e "$f" ] || [ -L "$f" ]; then printf "%s\\0" "$f"; fi; done'


def sshd_include(pattern: str) -> tuple[list[str], str | None]:
    """The files an Include pattern names, sorted, or why they could not be listed."""
    full = pattern if pattern.startswith("/") else str(SSHD_CONFIG.parent / pattern)
    result = root_run(["env", "LC_ALL=C", "sh", "-c", SSHD_GLOB, "sh", full])
    if result.returncode != 0:
        return [], f"cannot list Include {pattern}: {(result.stderr or '').strip() or 'exit ' + str(result.returncode)}"
    return sorted(name for name in result.stdout.split("\0") if name), None


def sshd_files(path: Path | None = None, depth: int = 0) -> tuple[list[tuple[str, str]], list[str]]:
    """sshd_config and every file it includes, read as root (Fedora keeps them root's alone), and why
    any of them could not be read: a file this cannot read is one it cannot vouch for."""
    path = path or SSHD_CONFIG
    result = root_run(["cat", "--", str(path)])
    if result.returncode != 0:
        return [], [f"cannot read {path}: {(result.stderr or '').strip() or 'exit ' + str(result.returncode)}"]
    files, problems = [(str(path), result.stdout)], []
    for number, keyword, args, strict in sshd_settings(result.stdout):
        if keyword != "include":
            continue
        if args is None:
            problems.append(f"{path} line {number}: an Include with a quote that is never closed, which cannot be followed")
            continue
        if not args:
            problems.append(f"{path} line {number}: an Include that names no file")
            continue
        if depth >= 16:
            # sshd's own limit (READCONF_MAX_DEPTH); deeper, sshd refuses the config anyway.
            problems.append(f"{path}: Includes nest deeper than 16 files")
            break
        for pattern in args:
            if pattern.startswith("~"):
                # sshd expands ~ only in ssh_config. In sshd_config it neither expands it nor puts
                # /etc/ssh in front of it, so the path is taken relative to sshd's working folder:
                # whatever file was meant would go unchecked.
                problems.append(f"{path} line {number}: Include {pattern} starts with ~, which sshd does not expand in sshd_config")
                continue
            names, problem = sshd_include(pattern)
            if problem:
                problems.append(problem)
            elif not names and strict:
                # sshd lets an Include match nothing; written with "=" or quotes, which a person types
                # to name one file, it more likely means this check is reading the line wrongly.
                problems.append(f"{path} line {number}: Include {pattern} matches no file")
            for name in names:
                more, trouble = sshd_files(Path(name), depth + 1)
                files += more
                problems += trouble
    return files, problems


def file_state(path: Path) -> str:
    """"present" for a regular file, "absent", or "tampered" for a link or anything else in its place;
    a link is never followed, so it cannot make someone else's file look like Herald's."""
    try:
        mode = os.lstat(path).st_mode
    except FileNotFoundError:
        return "absent"
    except OSError:
        return "unknown"
    return "present" if stat.S_ISREG(mode) else "tampered"


def read_nofollow(path: Path) -> str | None:
    """A regular file's text, or None for anything else, a link included (O_NOFOLLOW)."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return None
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        return None
    with os.fdopen(fd) as handle:
        return handle.read()


def ssh_account(name: str | None, required: bool = True) -> pwd.struct_passwd | None:
    """Whose keys: the account this runs as or, as root (the first boot, sudo), the one --user names or
    the one sudo ran from. Never root, which sshd turns away anyway."""
    if os.geteuid() != 0:
        me = pwd.getpwuid(os.getuid())
        if name and name != me.pw_name:
            die(f"--user {name}: only root sets up SSH for another account, and this runs as {me.pw_name}", 2)
        return me
    name = name or os.environ.get("SUDO_USER")
    if not name or name == "root":
        if not required:
            return None
        die("as root, say whose account SSH is for: --user <name> (root itself never signs in over SSH)", 2)
    try:
        account = pwd.getpwnam(name)
    except KeyError:
        die(f"there is no account named {name}", 1)
    if account.pw_uid == 0:
        die(f"{name} is root, which never signs in over SSH", 2)
    return account


@contextlib.contextmanager
def as_account(account: pwd.struct_passwd):
    """Files in someone's home are read and written as them, so a link they put there cannot send
    root's writes anywhere else."""
    if os.geteuid() != 0:
        yield
        return
    groups = os.getgroups()
    os.setgroups([])
    os.setegid(account.pw_gid)
    os.seteuid(account.pw_uid)
    try:
        yield
    finally:
        os.seteuid(0)
        os.setegid(0)
        os.setgroups(groups)


def ssh_dir(account: pwd.struct_passwd) -> Path:
    return Path(account.pw_dir) / ".ssh"


def read_authorized(account: pwd.struct_passwd) -> str:
    folder = ssh_dir(account)
    keys_file = folder / "authorized_keys"
    with as_account(account):
        for path in (folder, keys_file):
            try:
                info = os.lstat(path)
            except FileNotFoundError:
                continue
            except OSError as exc:
                die(f"cannot look at {path}: {exc.strerror}. It must be {account.pw_name}'s own (sudo chown -R {account.pw_name}: {folder}). Nothing was changed.", 1)
            if stat.S_ISLNK(info.st_mode):
                die(f"{path} is a link, which sshd does not trust either: make it a real {'folder' if path == folder else 'file'} and run this again. Nothing was changed.", 1)
            if info.st_uid != account.pw_uid:
                owner = next((entry.pw_name for entry in pwd.getpwall() if entry.pw_uid == info.st_uid), str(info.st_uid))
                die(f"{path} belongs to {owner}, not {account.pw_name}, and sshd ignores keys there too. "
                    f"`sudo chown -R {account.pw_name}: {folder}` gives it back; then run this again. Nothing was changed.", 1)
        try:
            return keys_file.read_text() if keys_file.exists() else ""
        except OSError as exc:
            die(f"cannot read {keys_file}: {exc}. Nothing was changed.", 1)
    return ""


def write_authorized(account: pwd.struct_passwd, text: str | None, written: list | None = None,
                     timeout: float | None = None, grace: float | None = None) -> None:
    """~/.ssh 0700 and authorized_keys 0600, both the account's own: sshd ignores keys anyone else can
    change. The new text goes through a new file and a rename, so the file is never half written.
    `written` gets an entry the moment the new file is in place, before anything after it can fail."""
    folder = ssh_dir(account)
    keys_file = folder / "authorized_keys"
    with as_account(account):
        if text is not None:
            folder.mkdir(mode=0o700, exist_ok=True)
            fd, name = tempfile.mkstemp(dir=folder, prefix=".authorized_keys.")
            with os.fdopen(fd, "w") as out:
                out.write(text)
            os.chmod(name, 0o600)
            os.replace(name, keys_file)
            if written is not None:
                written.append(keys_file)
        if folder.is_dir():
            folder.chmod(0o700)
        if keys_file.is_file():
            keys_file.chmod(0o600)
    if folder.is_dir() and shutil.which("restorecon"):
        # SELinux: a file written elsewhere and moved in keeps the wrong label, and sshd cannot read it.
        if root_run(["restorecon", "-R", str(folder)], timeout, grace).returncode != 0:
            warn(f"restorecon -R {folder} failed; with SELinux enforcing, sshd may not read the keys")


def github_keys(user: str) -> list[str]:
    if not GITHUB_USER.match(user):
        die(f"--github {user}: not a GitHub user name. Nothing was changed.", 2)
    url = f"https://github.com/{user}.keys"
    result = sh([*GITHUB_CURL, url], timeout=SSH_TIMEOUT)
    if result.returncode != 0:
        die(f"could not read {url} (curl exit {result.returncode}). Nothing was changed.", 1)
    if len(result.stdout.encode()) > GITHUB_MAX_BYTES:
        die(f"{url} is larger than a key list can be (1 MiB). Nothing was changed.", 1)
    keys = []
    for number, line in enumerate(result.stdout.splitlines(), 1):
        if not line.strip():
            continue
        problem = ssh_key_problem(line)
        if problem:
            print(f"    {url} line {number}: skipping a key of type {ssh_key_type(line)}: {problem}")
        else:
            keys.append(" ".join(line.split()))
    if not keys:
        die(f"{user} has no SSH keys on GitHub ({url}). Nothing was changed.", 1)
    return [key if len(key.split()) > 2 else f"{key} github:{user}" for key in keys]


def given_keys(opts: dict) -> list[tuple[str, str]]:
    """Every key --key, --keys-file and --github give, each with where it came from and its
    `ssh-keygen -lf` line, checked before anything changes."""
    keys: list[tuple[str, str]] = []
    for text in opts["keys"]:
        key = ssh_key(text)
        if not key:
            die(f"--key {text[:60]!r}: not an SSH public key (one line: type, key, comment, such as the contents of ~/.ssh/id_ed25519.pub). Nothing was changed.", 2)
        keys.append((key, f"--key {key[:40]}…"))
    for file in opts["files"]:
        try:
            lines = Path(file).read_text().splitlines()
        except OSError as exc:
            die(f"--keys-file {file}: {exc}. Nothing was changed.", 1)
        for number, line in enumerate(lines, 1):
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            key = ssh_key(line)
            if not key:
                die(f"{file} line {number}: not an SSH public key. Nothing was changed.", 2)
            keys.append((key, f"{file} line {number}"))
    checked = []
    for key, label in keys:
        listing, weakness = key_listing(key)
        if weakness:
            die(f"{label}: {weakness}. Nothing was changed.", 2)
        checked.append((key, listing))
    for user in opts["github"]:
        taken = []
        for key in github_keys(user):
            listing, weakness = key_listing(key)
            if weakness:
                bits = listing.split()[0] if listing[:1].isdigit() else "unknown"
                print(f"    github.com/{user}.keys: skipping a key of type {ssh_key_type(key)} ({bits} bits): {weakness}")
            else:
                taken.append((key, listing))
        if not taken:
            die(f"none of {user}'s SSH keys on GitHub are ones sshd should take (Ed25519, ECDSA, a security key, or RSA of {RSA_MIN_BITS} bits or more). Nothing was changed.", 1)
        checked += taken
    return checked


def sshd_command() -> str:
    found = shutil.which("sshd") or shutil.which("sshd", path="/usr/sbin:/usr/bin")
    if not found:
        die("the OpenSSH server is not installed (sudo dnf install openssh-server, or pacman -S openssh). Nothing was changed.", 127)
    return found


def sshd_probes(account: pwd.struct_passwd) -> list[str | None]:
    return [
        None,
        f"user={account.pw_name},host=localhost,addr=127.0.0.1",
        f"user={account.pw_name},host=x,addr={SSH_PROBE_ADDRESS}",
        f"user=root,host=x,addr={SSH_PROBE_ADDRESS}",
    ]


def sshd_configure(account: pwd.struct_passwd, passwords: bool, sshd: str) -> list[str]:
    """The drop-in, and then sshd's own word, for every connection it is asked about, that its settings
    are in effect, and no Match block in its files that lets in more; otherwise the drop-in is taken
    back (or the earlier one put back) and SSH stays as it was. Returns the ports sshd listens on."""
    # Fedora makes the host keys when sshd first starts, and `sshd -t` needs them now.
    if root_run(["systemctl", "start", "sshd-keygen.target"]).returncode != 0:
        root_step(["ssh-keygen", "-A"], "Making the SSH host keys")
    before = read_nofollow(SSHD_DROP_IN)
    install_file(sshd_drop_in(passwords), SSHD_DROP_IN)
    files, problems = sshd_files()
    problems, ports = problems + match_weakening(files, passwords), []
    test = root_run([sshd, "-t"])
    if test.returncode != 0:
        problems.append((test.stderr or test.stdout or "").strip() or f"sshd -t exit {test.returncode}")
    else:
        for probe in sshd_probes(account):
            effective = root_run([sshd, "-T", *(["-C", probe] if probe else [])])
            where = f"for {probe}" if probe else "by default"
            if effective.returncode != 0:
                problems.append(f"sshd -T {where}: {(effective.stderr or effective.stdout or '').strip() or effective.returncode}")
                continue
            problems += [f"{problem} {where}" for problem in sshd_overruled(effective.stdout, passwords)]
            if probe is None:
                ports = sorted({line.split()[1] for line in effective.stdout.splitlines() if line.split()[:1] == ["port"]}, key=int)
    if problems:
        if before is None:
            root_run(["rm", "-f", str(SSHD_DROP_IN)])
        else:
            install_file(before, SSHD_DROP_IN)
        die(
            f"sshd would let in more than {SSHD_DROP_IN} allows ({'; '.join(problems)}), so SSH stays as it was. "
            "Another file sets it first (/etc/ssh/sshd_config before its Include line, an earlier file in "
            "/etc/ssh/sshd_config.d, or a Match block): `sudo sshd -T -C user=root,host=x,addr=203.0.113.1` "
            "shows what is in effect.",
            1,
        )
    return ports or ["22"]


def install_file(text: str, dest: Path, timeout: float | None = None, grace: float | None = None) -> None:
    """A root-owned 0644 file written through sudo, labelled for SELinux."""
    fd, name = tempfile.mkstemp(prefix="herald-os-", suffix=dest.suffix)
    try:
        with os.fdopen(fd, "w") as out:
            out.write(text)
        root_step(["install", "-D", "-m", "0644", name, str(dest)], f"Writing {dest}", timeout, grace)
    finally:
        os.unlink(name)
    if shutil.which("restorecon"):
        root_run(["restorecon", str(dest)], timeout, grace)


def unit_loaded(unit: str) -> bool:
    result = ssh_run(["systemctl", "show", "-p", "LoadState", "--value", unit])
    return result.returncode == 0 and result.stdout.strip() == "loaded"


def unit_state(unit: str, timeout: float | None = None) -> tuple[str, str]:
    """(is-enabled, is-active) as systemctl prints them; neither needs root."""
    enabled = ssh_run(["systemctl", "is-enabled", unit], timeout).stdout.strip()
    active = ssh_run(["systemctl", "is-active", unit], timeout).stdout.strip()
    return enabled or "unknown", active or "unknown"


def firewalld_running() -> bool:
    return bool(shutil.which("firewall-cmd")) and ssh_run(["systemctl", "is-active", "--quiet", "firewalld"]).returncode == 0


def firewall_zone() -> tuple[str, str] | None:
    """("firewall-cmd", zone) while firewalld runs, ("firewall-offline-cmd", zone) when it is installed
    and stopped, else None. The default zone is the one Herald OS's connections use."""
    if firewalld_running():
        zone = root_run(["firewall-cmd", "--get-default-zone"])
        return ("firewall-cmd", zone.stdout.strip()) if zone.returncode == 0 and zone.stdout.strip() else None
    if shutil.which("firewall-offline-cmd"):
        zone = root_run(["firewall-offline-cmd", "--get-default-zone"])
        return ("firewall-offline-cmd", zone.stdout.strip()) if zone.returncode == 0 and zone.stdout.strip() else None
    return None


def ssh_limit_rules(ports: list[str]) -> str:
    """The per-source limit as an nftables file that replaces the table each time it loads (pure; tested)."""
    dports = "{ " + ", ".join(ports) + " }"
    over = f"limit rate over {SSH_LIMIT_RATE} burst 4 packets"
    return (
        "# Written by `herald-os setup ssh`; `herald-os setup ssh --off` removes it.\n"
        f"# New SSH connections over {SSH_LIMIT_RATE} from one IPv4 address or IPv6 /64 are dropped.\n"
        f"table inet {SSH_LIMIT_TABLE}\n"
        f"delete table inet {SSH_LIMIT_TABLE}\n"
        f"table inet {SSH_LIMIT_TABLE} {{\n"
        "\tset sources4 {\n\t\ttype ipv4_addr\n\t\tsize 65535\n\t\tflags dynamic,timeout\n\t\ttimeout 5m\n\t}\n"
        "\tset sources6 {\n\t\ttype ipv6_addr\n\t\tsize 65535\n\t\tflags dynamic,timeout\n\t\ttimeout 5m\n\t}\n"
        "\tchain input {\n"
        "\t\ttype filter hook input priority filter - 10; policy accept;\n"
        f"\t\ttcp dport {dports} ct state new add @sources4 {{ ip saddr {over} }} counter drop\n"
        f"\t\ttcp dport {dports} ct state new add @sources6 {{ ip6 saddr and ffff:ffff:ffff:ffff:: {over} }} counter drop\n"
        "\t}\n"
        "}\n"
    )


def ssh_limit_unit(nft: str) -> str:
    """The unit that loads the limit at every boot (pure; tested)."""
    return (
        "# Written by `herald-os setup ssh`; `herald-os setup ssh --off` removes it.\n"
        "[Unit]\n"
        "Description=Herald OS: at most 4 new SSH connections a minute from each address\n"
        "Wants=network-pre.target\n"
        "Before=network-pre.target sshd.service sshd.socket\n"
        "\n"
        "[Service]\n"
        "Type=oneshot\n"
        "RemainAfterExit=yes\n"
        f"ExecStart={nft} -f {SSH_LIMIT_RULES}\n"
        f"ExecStop={nft} delete table inet {SSH_LIMIT_TABLE}\n"
        "\n"
        "[Install]\n"
        "WantedBy=multi-user.target\n"
    )


def nft_command() -> str | None:
    return shutil.which("nft") or shutil.which("nft", path="/usr/sbin:/usr/bin")


def ssh_limit_requirement() -> str:
    """The drop-in that makes sshd.service and sshd.socket need the limit (pure; tested)."""
    return (
        "# Written by `herald-os setup ssh`; `herald-os setup ssh --off` removes it.\n"
        "# No sshd without the per-address rate limit: if it fails, sshd does not start.\n"
        "[Unit]\n"
        f"Requires={SSH_LIMIT_UNIT.name}\n"
        f"After={SSH_LIMIT_UNIT.name}\n"
    )


def ssh_limit_on(ports: list[str]) -> None:
    nft = nft_command()
    if not nft:
        die("nft (nftables) is not installed, so SSH cannot be rate-limited per address (sudo dnf install nftables).", 127)
    install_file(ssh_limit_rules(ports), SSH_LIMIT_RULES)
    install_file(ssh_limit_unit(nft), SSH_LIMIT_UNIT)
    for path in SSH_LIMIT_REQUIRED:
        install_file(ssh_limit_requirement(), path)
    running = unit_state(SSH_LIMIT_UNIT.name)[1] == "active"
    root_step(["systemctl", "daemon-reload"], "Reloading systemd")
    root_step(["systemctl", "enable", SSH_LIMIT_UNIT.name], "Enabling the SSH rate limit")
    # From here a table may be live, so the rollback must deal with it even if the load is cut short.
    SSH_LOADED.append(True)
    if running:
        # Restarting the unit would restart sshd too (it Requires= it). nft -f swaps the table in one
        # transaction instead, so there is never a moment without it; the counts start over.
        root_step([nft, "-f", str(SSH_LIMIT_RULES)], "Reloading the SSH rate limit")
    else:
        root_step(["systemctl", "restart", SSH_LIMIT_UNIT.name], "Loading the SSH rate limit")
    if root_run([nft, "list", "table", "inet", SSH_LIMIT_TABLE]).returncode != 0:
        die(f"the rate limit did not load (nft list table inet {SSH_LIMIT_TABLE}), so sshd is not started. `journalctl -u {SSH_LIMIT_UNIT.name}` says why.", 1)


def ssh_limit_off() -> None:
    # sshd's requirement goes first: with it gone, stopping the limit stops nothing else.
    required = [path for path in SSH_LIMIT_REQUIRED if os.path.lexists(path)]
    for path in required:
        root_step(["rm", "-f", str(path)], f"Removing {path}")
    if required:
        root_run(["systemctl", "daemon-reload"])
    if unit_loaded(SSH_LIMIT_UNIT.name):
        root_step(["systemctl", "disable", "--now", SSH_LIMIT_UNIT.name], "Stopping the SSH rate limit")
    nft = nft_command()
    if nft and root_run([nft, "list", "table", "inet", SSH_LIMIT_TABLE]).returncode == 0:
        root_step([nft, "delete", "table", "inet", SSH_LIMIT_TABLE], "Removing the SSH rate limit")
    removed = [path for path in (SSH_LIMIT_UNIT, SSH_LIMIT_RULES) if os.path.lexists(path)]
    for path in removed:
        root_step(["rm", "-f", str(path)], f"Removing {path}")
    if SSH_LIMIT_UNIT in removed:
        root_run(["systemctl", "daemon-reload"])


def firewall_open() -> str:
    found = firewall_zone()
    if not found or found[0] != "firewall-cmd":
        return "no firewall is running, so nothing was opened"
    _, zone = found
    for permanent in ([], ["--permanent"]):
        root_step(["firewall-cmd", *permanent, f"--zone={zone}", f"--add-rich-rule={SSH_RICH_RULE}"], "Opening SSH in the firewall")
    if root_run(["firewall-cmd", f"--zone={zone}", "--query-service=ssh"]).returncode == 0:
        return f"the firewall zone {zone} let SSH in already, by its own ssh service"
    return f"open in the firewall zone {zone}"


def firewall_save() -> str:
    """firewalld's rule, saved with firewall-offline-cmd while firewalld is stopped."""
    zone = root_run(["firewall-offline-cmd", "--get-default-zone"])
    name = zone.stdout.strip() if zone.returncode == 0 else ""
    if not name:
        die("firewall-offline-cmd cannot tell the default zone, so SSH's rule could not be saved; sshd is not started.", 1)
    root_step(["firewall-offline-cmd", f"--zone={name}", f"--add-rich-rule={SSH_RICH_RULE}"], "Saving SSH's firewall rule")
    return f"saved in the firewall zone {name} for when firewalld starts (it is not running now)"


def firewall_close() -> str:
    found = firewall_zone()
    if not found:
        return "no firewall to change"
    tool, zone = found
    for permanent in ([], ["--permanent"]) if tool == "firewall-cmd" else ([],):
        root_step([tool, *permanent, f"--zone={zone}", f"--remove-rich-rule={SSH_RICH_RULE}"], "Closing SSH in the firewall")
    if root_run([tool, f"--zone={zone}", "--query-service=ssh"]).returncode == 0:
        return f"Herald OS's rule is gone, but the firewall zone {zone} still lets SSH in by itself, which setup ssh did not add (sudo firewall-cmd --permanent --zone={zone} --remove-service=ssh closes it)"
    return f"closed in the firewall zone {zone}"


def ssh_sessions() -> list[str]:
    """The logind sessions sshd opened, the caller's own last; no root needed to list them."""
    listed = ssh_run(["loginctl", "list-sessions", "--no-legend"])
    found = []
    for line in listed.stdout.splitlines() if listed.returncode == 0 else []:
        fields = line.split()
        if not fields:
            continue
        service = ssh_run(["loginctl", "show-session", fields[0], "-p", "Service", "--value"])
        if service.returncode == 0 and service.stdout.strip() == "sshd":
            found.append(fields[0])
    mine = os.environ.get("XDG_SESSION_ID")
    return sorted(found, key=lambda session: session == mine)


def end_sessions(sessions: list[str]) -> None:
    for session in sessions:
        if root_run(["loginctl", "terminate-session", session]).returncode != 0:
            warn(f"SSH session {session} did not end; sudo loginctl terminate-session {session}")


def host_fingerprints() -> list[str]:
    lines = []
    for public in sorted(SSH_HOST_KEYS.glob("ssh_host_*_key.pub")):
        result = ssh_run(["ssh-keygen", "-lf", str(public)])
        if result.returncode == 0 and result.stdout.strip():
            lines.append(result.stdout.strip())
    return lines


def addresses() -> list[str]:
    result = ssh_run(["ip", "-o", "addr", "show", "scope", "global"])
    found = []
    for line in result.stdout.splitlines() if result.returncode == 0 else []:
        fields = line.split()
        if len(fields) > 3 and fields[2] in ("inet", "inet6"):
            found.append(fields[3].split("/", 1)[0])
    return found


# The units the rollback answers for, sshd's first: if time or anything else runs short, those are
# the ones that must end up closed. The socket goes before the service, so it cannot start it again.
SSH_ROLLBACK_UNITS = ("sshd.socket", "sshd.service", SSH_LIMIT_UNIT.name)
# How a unit was before `on`, read strictly: it was running only if systemctl said exactly one of
# these, and enabled only if exactly one of those. Anything else (failed, unknown, an empty or
# timed-out answer, linked, linked-runtime, static, masked, not-found, ...) counts as closed, so
# whatever this run may have started or enabled is stopped or disabled again.
SSH_OPEN_ACTIVE = ("active", "reloading", "activating")
SSH_OPEN_ENABLED = ("enabled", "enabled-runtime", "indirect", "generated", "alias")
# How it is after: closed only when systemctl plainly says so. Anything else (unknown after a
# timeout, activating, reloading, failed, ...) counts as open, and gets stopped or disabled. A static
# unit has nothing to disable (it starts only when something else pulls it in), so it is not listed
# as disabled; before `on`, static still counts as not enabled (SSH_OPEN_ENABLED).
SSH_CLOSED_ACTIVE = ("inactive",)
SSH_CLOSED_ENABLED = ("disabled", "masked", "not-found", "static")


def ssh_snapshot() -> dict:
    """What `on` may change, as it is before: the files, the units, the table and the firewall rule."""
    before: dict = {
        "files": {path: read_nofollow(path) for path in (SSHD_DROP_IN, SSH_LIMIT_RULES, SSH_LIMIT_UNIT, *SSH_LIMIT_REQUIRED)},
        "units": {unit: unit_state(unit) for unit in SSH_ROLLBACK_UNITS},
        "table": False,
        "rules": {},
    }
    nft = nft_command()
    if nft:
        before["table"] = root_run([nft, "list", "table", "inet", SSH_LIMIT_TABLE]).returncode == 0
    found = firewall_zone()
    if found:
        tool, zone = found
        for permanent in ([], ["--permanent"]) if tool == "firewall-cmd" else ([],):
            query = root_run([tool, *permanent, f"--zone={zone}", f"--query-rich-rule={SSH_RICH_RULE}"])
            before["rules"][(tool, zone, tuple(permanent))] = query.returncode == 0
    return before


# The whole rollback gets this long, wall clock, since it runs with signals ignored: a hard cap, with
# killing a command that hangs counted in. Each command may take what is left at that moment (with a
# timeout of at most SSH_TIMEOUT), less what is held back: a share of the budget (SSH_ROLLBACK_LAST,
# or an eighth of the budget when that is less) for each of sshd's two units' stop and disable that
# has not come yet, one for taking out the keys this run added, and two for the end (ending what this
# run left running, and the last look at the firewall). What there is no time left for is skipped and
# reported.
SSH_ROLLBACK_BUDGET = 300
SSH_ROLLBACK_LAST = 15
# How long renewing sudo's time at the start of the rollback may take (its timeout), out of the budget.
SSH_SUDO_RENEW = 10
# The units that must end up closed, whatever the time.
SSH_ESSENTIAL_UNITS = ("sshd.service", "sshd.socket")


def ssh_no_table(result: subprocess.CompletedProcess) -> bool:
    """Whether nft plainly said the table is not there, rather than failing for another reason."""
    return result.returncode not in (0, None) and "No such file or directory" in (result.stderr or "")


def ssh_rollback(before: dict, keys_out=None) -> tuple[list[str], list[str]]:
    """Put back what `on` changed since `before`: what it put back, and what it could not (a command
    that failed, hung or was refused by sudo, a step it ran out of time for), for the message. Each
    step is tried whatever the others do: a rollback that stops halfway is the state this is here to
    avoid. `keys_out(timeout, grace, undone, trouble)` takes the keys this run added back out, inside
    the same budget, once sshd is closed."""
    undone: list[str] = []
    skipped: list[str] = []
    troubles: list[str] = []

    def trouble(message: str) -> None:
        warn(message)
        troubles.append(message)
    deadline = time.monotonic() + SSH_ROLLBACK_BUDGET
    share = min(SSH_ROLLBACK_LAST, SSH_ROLLBACK_BUDGET / 8)
    held = {"essential": 2 * len(SSH_ESSENTIAL_UNITS), "keys": 1 if keys_out else 0, "end": 2}

    def free(essential: bool = False) -> float:
        """What is left of the budget less what is held back; an essential step may use its own share."""
        return deadline - time.monotonic() - share * (sum(held.values()) - (1 if essential else 0))

    def slot(most: float, essential: bool = False, parts: int = 1) -> tuple[float, float] | None:
        """(timeout, grace) for each of `parts` commands, or None when there is no time left for them."""
        return ssh_slot(most, free(essential) / parts)

    def run(argv: list[str], essential: bool = False) -> subprocess.CompletedProcess:
        # A command that hangs or cannot run is reported here and passed over, so the steps after it
        # still happen; one there is no time left for is skipped. Either comes back with no exit code
        # (None): not done, and already accounted for.
        given = slot(ssh_limit(None), essential)
        if given is None:
            skipped.append(" ".join(argv))
            return subprocess.CompletedProcess(argv, None, "", "")
        timeout, grace = given
        try:
            return root_run(argv, timeout, grace)
        except (subprocess.TimeoutExpired, OSError) as exc:
            why = f"did not finish within {timeout:.0f} s" if isinstance(exc, subprocess.TimeoutExpired) else f"failed ({exc})"
            trouble(f"`{' '.join(argv)}` {why} while putting things back")
            return subprocess.CompletedProcess(argv, None, "", "")

    def state(unit: str) -> tuple[str, str]:
        # Each of the two questions gets what is left at that moment; with no time to ask, the answer
        # is unknown, which counts as open.
        answers = []
        for question in ("is-enabled", "is-active"):
            given = slot(ssh_limit(None))
            try:
                answer = ssh_run(["systemctl", question, unit], given[0], grace=given[1]).stdout.strip() if given else ""
            except (subprocess.TimeoutExpired, OSError):
                answer = ""
            answers.append(answer or "unknown")
        return answers[0], answers[1]

    def attempt(argv: list[str], what: str, essential: bool = False) -> None:
        result = run(argv, essential)
        if result.returncode == 0:
            undone.append(what)
        elif result.returncode is not None:
            refusal = (result.stderr or "").strip().splitlines()[-1:]
            trouble(f"could not put back {what}: `{' '.join(argv)}` failed" + (f" ({refusal[0]})" if refusal else ""))

    # sudo may have forgotten the password by now; renew its time while it still remembers.
    renew = slot(SSH_SUDO_RENEW)
    if os.geteuid() != 0 and renew:
        try:
            ssh_run(["sudo", "-n", "-v"], timeout=renew[0], grace=renew[1])
        except (subprocess.TimeoutExpired, OSError):
            pass
    # A command this run killed but that went on running as root could still change things after
    # they are put back; it is ended first, so what the rollback reads is how things stay.
    ssh_reap(max(0.0, min(ssh_limit(None) + 2 * SSH_KILL_GRACE, free())))
    # Fail closed, on each count apart: a unit that was not plainly running before is stopped unless it
    # is plainly stopped now, and one that was not plainly enabled before is disabled unless it is
    # plainly disabled now. A state systemctl could not report in time is not plainly anything.
    for unit in SSH_ROLLBACK_UNITS:
        essential = unit in SSH_ESSENTIAL_UNITS
        enabled, active = before["units"][unit]
        now_enabled, now_active = state(unit)
        if active not in SSH_OPEN_ACTIVE and now_active not in SSH_CLOSED_ACTIVE:
            attempt(["systemctl", "stop", unit], f"{unit} stopped", essential)
        held["essential"] -= essential
        if enabled not in SSH_OPEN_ENABLED and now_enabled not in SSH_CLOSED_ENABLED:
            attempt(["systemctl", "disable", unit], f"{unit} disabled", essential)
        held["essential"] -= essential
        if active != "failed" and state(unit)[1] == "failed":
            attempt(["systemctl", "reset-failed", unit], f"{unit}'s failure cleared")
    if keys_out:
        held["keys"] = 0
        given = slot(ssh_limit(None))
        if given is None:
            skipped.append("taking the added keys back out")
        else:
            keys_out(*given, undone, trouble)
    nft = nft_command()
    # A table that was not there before goes unless nft plainly says it is not there now: a listing
    # that failed otherwise (sudo refused, it timed out) says nothing either way.
    # A table that was not there before this run is dealt with only when this run reached loading one;
    # otherwise there is nothing of its to remove, and a listing sudo refuses would read as a false
    # "may still be loaded". In the C locale, so "No such file or directory" is nft's words in any language.
    in_c = ["env", "LC_ALL=C"]
    if nft and not before["table"] and SSH_LOADED and not ssh_no_table(run([*in_c, nft, "list", "table", "inet", SSH_LIMIT_TABLE])):
        delete = [nft, "delete", "table", "inet", SSH_LIMIT_TABLE]
        deleted = run([*in_c, *delete])
        if deleted.returncode == 0:
            undone.append(f"the table inet {SSH_LIMIT_TABLE} removed")
        elif deleted.returncode is not None and not ssh_no_table(deleted):
            refusal = (deleted.stderr or "").strip().splitlines()[-1:]
            trouble(f"the table inet {SSH_LIMIT_TABLE} may still be loaded"
                    + (f" ({refusal[0]})" if refusal else "")
                    + f"; remove it with: {'' if os.geteuid() == 0 else 'sudo '}{shlex.join(delete)}")
    restored: set[Path] = set()
    for path, text in before["files"].items():
        if read_nofollow(path) == text and (text is not None or not os.path.lexists(path)):
            continue
        if text is None:
            attempt(["rm", "-f", str(path)], f"{path} removed")
            continue
        # Two commands (install, restorecon), so each gets half of what is left.
        given = slot(ssh_limit(None), parts=2)
        if given is None:
            skipped.append(f"putting back {path}")
            continue
        try:
            install_file(text, path, *given)
            restored.add(path)
            undone.append(f"{path} put back")
        except (SystemExit, OSError, subprocess.TimeoutExpired):
            trouble(f"could not put back {path}")
    run(["systemctl", "daemon-reload"])
    # A table that was there before is loaded again from the file just put back, in one transaction
    # as the in-place reload does, when that file changed or the table is gone.
    if nft and before["table"] and before["files"][SSH_LIMIT_RULES] is not None and (
        SSH_LIMIT_RULES in restored or run([nft, "list", "table", "inet", SSH_LIMIT_TABLE]).returncode != 0
    ):
        attempt([nft, "-f", str(SSH_LIMIT_RULES)], f"the table inet {SSH_LIMIT_TABLE} loaded again from {SSH_LIMIT_RULES}")
    # A rule that was not there before goes unless the query plainly says it is absent (exit 1): one it
    # could not ask about may be there. The rules are asked about again at the very end, so an add whose
    # command was killed but finished late is taken out too. Before that last look, every command this
    # run killed has to have ended (ended as root, in what is held back for the end, less one share for
    # the look itself, and at most as long as one command may take):
    # firewalld answers its D-Bus calls one at a time, in order, so once the command that sent an add
    # has ended, a query sent after it sees the rule if it was added at all. No `firewall-cmd --reload`:
    # it would also throw away runtime changes that are not this run's.
    for final in (False, True):
        if final:
            held["end"] = 0
            running = ssh_reap(max(0.0, min(ssh_limit(None) + 2 * SSH_KILL_GRACE, free() - share)))
            for command in running:
                again = [("" if os.geteuid() == 0 else "sudo ") + shlex.join([tool, *permanent, f"--zone={zone}", f"--remove-rich-rule={SSH_RICH_RULE}"])
                         for (tool, zone, permanent), had in before["rules"].items() if not had]
                trouble(f"`{command}` was still running as root when the rollback ended, so it may still change things"
                        + (f"; if SSH is open in the firewall after it ends, close it with: {'; '.join(again)}" if again else ""))
        for (tool, zone, permanent), had in before["rules"].items():
            if had:
                continue
            query = run([tool, *permanent, f"--zone={zone}", f"--query-rich-rule={SSH_RICH_RULE}"])
            if query.returncode == 1 or (final and query.returncode != 0):
                continue
            attempt([tool, *permanent, f"--zone={zone}", f"--remove-rich-rule={SSH_RICH_RULE}"],
                    f"the firewall rule in {zone}{' (saved)' if permanent or tool != 'firewall-cmd' else ''} removed{' (it came late)' if final else ''}")
    if skipped:
        trouble(f"ran out of time ({SSH_ROLLBACK_BUDGET} s) putting things back; skipped: {'; '.join(skipped)}")
    return undone, troubles

# Signals that stop `on` partway: like Ctrl+C, they go through the rollback, and the command then
# exits as a process killed by them would (143 for TERM, 129 for HUP).
SSH_STOPS = (signal.SIGTERM, signal.SIGHUP)


# The signal that stopped `on`: the first whose handler runs, which decides the exit code. Two signals
# pending at once have their Python handlers run in signal-number order, lowest first (HUP 1, INT 2,
# TERM 15), so the lower-numbered one wins; the order they were really sent in cannot be recovered and
# is not relied on. A signal that arrives after another has been handled is ignored.
SSH_STOP: dict = {"by": None}

# True when herald-os runs as its own process (set where it starts), not imported. A signal that stops
# `on` then decides the process's exit code, so INT, TERM and HUP stay blocked from the end of `on`
# until the process has exited: the handlers put back there (SIGTERM's default ends the process at once)
# would otherwise let a later signal replace that code in the moments before the exit.
SSH_OWN_PROCESS = False


def ssh_ignored(signum: int, frame) -> None:
    """INT, TERM and HUP while `on` is stopping: nothing. A Python handler that does nothing rather
    than SIG_IGN, because a signal that arrived before the switch to SIG_IGN would make Python raise
    "ignored due to race condition" wherever it next checks, the rollback included."""


def ssh_stopped(signum: int, frame) -> None:
    # The first handler to run records the code, before anything else, and switches INT, TERM and HUP
    # to do nothing from this moment, so a second signal cannot land between here and the rollback,
    # which goes on ignoring them until it is done.
    if SSH_STOP["by"] is not None:
        return
    SSH_STOP["by"] = signum
    ssh_signals({each: ssh_ignored for each in (signal.SIGINT, *SSH_STOPS)})
    if signum == signal.SIGINT:
        raise KeyboardInterrupt
    print(f"herald-os: stopped by {signal.Signals(signum).name}; putting back what this run changed", file=sys.stderr)
    raise SystemExit(128 + signum)


def ssh_signals(handlers: dict) -> dict:
    """Set these handlers and return the ones they replace. Outside the main thread, where signal()
    cannot be used, it sets nothing and returns nothing."""
    previous: dict = {}
    for signum, handler in handlers.items():
        try:
            previous[signum] = signal.signal(signum, handler)
        except (ValueError, OSError):
            break
    return previous


NO_LIMIT = (
    "THERE IS NO RATE LIMIT: nft is not installed, so nothing slows down password or key guessing "
    "against sshd, from any address. Install nftables (sudo dnf install nftables) and run this again."
)
NO_FIREWALL = (
    "firewalld is not running, so nothing stands between sshd and every network this computer joins. "
    "SSH turns on anyway because --no-firewall was given; `sudo systemctl enable --now firewalld` and "
    "running this again closes everything else."
)


def ssh_on(opts: dict) -> int:
    account = ssh_account(opts["user"])
    keys = given_keys(opts)
    sshd = sshd_command()
    firewall = firewalld_running()
    # --offline-firewall (the first boot): firewalld is installed and enabled but not up yet, so its
    # rule is saved with firewall-offline-cmd and applies once it starts; the rate limit is there first.
    offline = not firewall and opts["offline_firewall"] and bool(shutil.which("firewall-offline-cmd"))
    if not firewall and not offline and not opts["no_firewall"]:
        die("firewalld is not running" + (" and firewall-offline-cmd is not installed" if opts["offline_firewall"] else "")
            + ", so SSH would be open to every network with nothing else closed. "
            "Start it (sudo systemctl enable --now firewalld) and run this again, or add --no-firewall to turn SSH on "
            "without one. Nothing was changed.", 1)
    for path in (SSHD_DROP_IN, SSH_LIMIT_RULES, SSH_LIMIT_UNIT, *SSH_LIMIT_REQUIRED):
        if file_state(path) == "tampered":
            die(f"{path} is a link or not a regular file, which setup ssh never writes: something else put it there. "
                "Look at it, remove it (herald-os setup ssh --off does), and run this again. Nothing was changed.", 1)
    nft = nft_command()
    if (firewall or offline) and not nft:
        die("nft (nftables) is not installed, so SSH cannot be rate-limited per address (sudo dnf install nftables). Nothing was changed.", 127)
    current = read_authorized(account)
    updated, added = with_keys(current, [key for key, _ in keys])
    keys_file = ssh_dir(account) / "authorized_keys"
    if not authorized(updated) and not opts["passwords"]:
        die(
            f"not turning SSH on: {account.pw_name} has no SSH key in {keys_file}, and password logins stay off. "
            "Give one with --key '<public key>' or --github <user>, or sign in with the account's password "
            "instead with --passwords. Nothing was changed.",
            1,
        )
    if not firewall and not offline:
        warn(NO_FIREWALL)
    for key, listing in keys:
        print(f"    key {listing}: {'adding' if key in added else 'there already'}")
    # From here on, a step that fails takes back everything this run changed, keys included, so a
    # failed `on` leaves SSH as it found it (no requirement on a limit that never loaded, no half-open
    # firewall). SIGTERM and SIGHUP stop it the same way as Ctrl+C, through the rollback.
    ssh_sudo()
    SSH_LEFT.clear()
    SSH_LOADED.clear()
    SSH_STOP["by"] = None
    stops = ssh_signals({signum: ssh_stopped for signum in (signal.SIGINT, *SSH_STOPS)})
    try:
        before = ssh_snapshot()
        with as_account(account):
            had_folder, had_keys_file = ssh_dir(account).is_dir(), keys_file.is_file()
        wrote_keys: list = []
        try:
            write_authorized(account, updated if added else None, wrote_keys)
            ports = sshd_configure(account, opts["passwords"], sshd)
            if nft:
                ssh_limit_on(ports)
                limit = f"at most {SSH_LIMIT_RATE.replace('/', ' a ')} new connections from each address"
            else:
                # A requirement left from an earlier `on` would keep sshd from starting at all.
                ssh_limit_off()
                limit = "NO RATE LIMIT (nft is not installed)"
            opened = firewall_open() if firewall else firewall_save() if offline else "none running (--no-firewall)"
            root_step(["systemctl", "enable", "sshd.service"], "Enabling sshd")
            root_step(["systemctl", "reload-or-restart", "sshd.service"], "Starting sshd")
        except BaseException:
            # Whatever stopped it (a refusal, a signal, a file error, a command that timed out), what this
            # run changed goes back before the exception goes on as it was. Another signal must not cut
            # that short, so INT, TERM and HUP are ignored until it is done.
            ignored = ssh_signals({signum: ssh_ignored for signum in (signal.SIGINT, *SSH_STOPS)})

            def keys_out(timeout: float, grace: float, undone: list, trouble) -> None:
                put_back: list = []
                try:
                    if had_keys_file:
                        write_authorized(account, current, put_back, timeout, grace)
                    else:
                        with as_account(account):
                            keys_file.unlink(missing_ok=True)
                            put_back.append(keys_file)
                            if not had_folder:
                                ssh_dir(account).rmdir()
                    undone.append(f"the {len(added)} key(s) added to {keys_file} taken out")
                except (SystemExit, OSError, subprocess.TimeoutExpired):
                    if put_back:
                        # The keys are out; only what came after (restorecon, removing ~/.ssh) did not finish.
                        undone.append(f"the {len(added)} key(s) added to {keys_file} taken out")
                        trouble(f"the keys are out of {keys_file}, but tidying {ssh_dir(account)} after did not finish")
                    else:
                        trouble(f"could not take the added keys back out of {keys_file}")
            try:
                undone, troubles = ssh_rollback(before, keys_out if wrote_keys else None)
                put = "; ".join(undone) or "nothing"
                if troubles:
                    print(f"herald-os: the rollback is incomplete, so SSH may not be as it was before this run. "
                          f"Check: {'; '.join(troubles)}. Put back: {put}. `herald-os setup ssh --status` shows "
                          "what is in place; `herald-os setup ssh --off` turns SSH off and removes its settings.", file=sys.stderr)
                else:
                    print(f"herald-os: SSH is as it was before this run; put back: {'; '.join(undone) or 'nothing had changed yet'}.", file=sys.stderr)
            finally:
                ssh_signals(ignored)
            raise
    finally:
        if SSH_OWN_PROCESS and SSH_STOP["by"] is not None:
            signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGINT, *SSH_STOPS})
        ssh_signals(stops)
        SSH_STOP["by"] = None
    count = len(authorized(updated))
    print(f"SSH is on for {account.pw_name}: {'keys or the password' if opts['passwords'] else 'keys only, no passwords'}, never root.")
    print(f"    keys: {count} in {keys_file}" + (f" ({len(added)} added)" if added else ""))
    print(f"    firewall: {opened}; {limit}")
    fingerprints = host_fingerprints()
    if fingerprints:
        print("    this computer's host keys (check them the first time you connect):")
        for line in fingerprints:
            print(f"      {line}")
    for address in addresses():
        print(f"    ssh {account.pw_name}@{address}")
    print("    To turn it off again: herald-os setup ssh --off")
    if offline:
        warn("firewalld is not running yet: SSH's rule is saved for when it starts, and until then the rate limit is all that stands between sshd and the network")
    elif not firewall:
        warn(NO_FIREWALL)
    if not nft:
        warn(NO_LIMIT)
    return 0


def ssh_off(opts: dict) -> int:
    account = ssh_account(opts["user"], required=False)
    sessions = ssh_sessions()
    end = opts["end_sessions"]
    if sessions and not end and sys.stdin.isatty():
        yours = " (yours too, last)" if os.environ.get("XDG_SESSION_ID") in sessions else ""
        end = input(f"End the {len(sessions)} SSH session(s) open now{yours}? [y/N] ").strip().lower() in ("y", "yes")
    ssh_sudo()
    for unit in SSH_UNITS:
        if unit_loaded(unit):
            root_step(["systemctl", "disable", "--now", unit], f"Stopping {unit}")
    if os.path.lexists(SSHD_DROP_IN):
        root_step(["rm", "-f", str(SSHD_DROP_IN)], f"Removing {SSHD_DROP_IN}")
    ssh_limit_off()
    firewall = firewall_close()
    print("SSH is off: sshd is stopped and disabled, and its Herald OS settings and rate limit are gone.")
    print(f"    firewall: {firewall}")
    if account:
        print(f"    {ssh_dir(account) / 'authorized_keys'} is left as it is; its keys let no one in while SSH is off.")
    if sessions and not end:
        print(f"    {len(sessions)} SSH session(s) are still open ({', '.join(sessions)}); "
              "herald-os setup ssh --off --end-sessions ends them, or sudo loginctl terminate-session <id>.")
    elif sessions:
        print(f"    ending {len(sessions)} SSH session(s)")
        sys.stdout.flush()
        end_sessions(sessions)
    return 0


def ssh_state(account: pwd.struct_passwd | None) -> dict:
    """Whether SSH is on and how, read without root where that is possible; None where it cannot tell."""
    enabled, active = unit_state("sshd.service")
    socket_enabled, socket_active = unit_state("sshd.socket")
    limit_enabled, limit_active = unit_state(SSH_LIMIT_UNIT.name)
    drop_in_state = file_state(SSHD_DROP_IN)
    drop_in = read_nofollow(SSHD_DROP_IN) if drop_in_state == "present" else None
    passwords = None
    if drop_in is not None:
        passwords = any(line.split()[:2] == ["PasswordAuthentication", "yes"] for line in drop_in.splitlines())
    firewall: dict | None = None
    if firewalld_running():
        zone = ssh_run(["firewall-cmd", "--get-default-zone"])
        name = zone.stdout.strip() if zone.returncode == 0 else ""
        firewall = {"zone": name or None, "rule": None, "service": None}
        if name:
            for key, query in (("rule", f"--query-rich-rule={SSH_RICH_RULE}"), ("service", "--query-service=ssh")):
                code = ssh_run(["firewall-cmd", f"--zone={name}", query]).returncode
                firewall[key] = {0: True, 1: False}.get(code)
    keys = None
    if account:
        try:
            with as_account(account):
                keys_file = ssh_dir(account) / "authorized_keys"
                keys = len(authorized(keys_file.read_text())) if keys_file.is_file() and not keys_file.is_symlink() else 0
        except OSError:
            keys = None
    rate_limit = limit_enabled == "enabled" and limit_active == "active"
    required = all(file_state(path) == "present" for path in SSH_LIMIT_REQUIRED)
    warnings = []
    if required and limit_active != "active":
        warnings.append(f"sshd requires the rate limit ({SSH_LIMIT_UNIT.name}), which is {limit_active}, so sshd cannot start "
                        "until it loads: herald-os setup ssh loads it again, herald-os setup ssh --off removes SSH's settings")
    if (active == "active" or socket_active == "active") and limit_active != "active":
        warnings.append("sshd is running without the per-address rate limit")
    if drop_in_state in ("tampered", "unknown"):
        warnings.append(f"{SSHD_DROP_IN} is {'a link or not a regular file' if drop_in_state == 'tampered' else 'unreadable'}, which setup ssh never writes")
    return {
        "on": enabled == "enabled" or active == "active" or socket_enabled == "enabled" or socket_active == "active",
        "enabled": enabled == "enabled",
        "running": active == "active",
        "socket": socket_enabled == "enabled" or socket_active == "active",
        "dropIn": drop_in_state,
        "passwords": passwords,
        "firewall": firewall,
        "rateLimit": rate_limit,
        "limitRequired": required,
        "warnings": warnings,
        "sessions": len(ssh_sessions()),
        "user": account.pw_name if account else None,
        "keys": keys,
    }


# --status --json always prints these keys and "error" (null, or why there is no state), so a reader
# needs one schema; the state's keys are null when it could not be read.
SSH_STATE_KEYS = ("on", "enabled", "running", "socket", "dropIn", "passwords", "firewall", "rateLimit", "limitRequired", "warnings", "sessions", "user", "keys")


def ssh_json(state: dict | None = None, error: str | None = None) -> str:
    return json.dumps({**{key: None for key in SSH_STATE_KEYS}, **(state or {}), "error": error})


def ssh_status(opts: dict) -> int:
    account = ssh_account(opts["user"], required=False)
    state = ssh_state(account)
    if opts["json"]:
        print(ssh_json(state))
        return 0
    how = "running" if state["running"] else "enabled, not running" if state["enabled"] else "its socket listens" if state["socket"] else ""
    print(f"SSH: {'on (' + how + ')' if state['on'] else 'off'}")
    if state["dropIn"] == "present":
        print(f"    sign-in: {'keys or a password' if state['passwords'] else 'keys only'}, never root ({SSHD_DROP_IN})")
    elif state["dropIn"] in ("tampered", "unknown"):
        print(f"    sign-in: WARNING: {SSHD_DROP_IN} is {'a link or not a regular file' if state['dropIn'] == 'tampered' else 'unreadable'}, "
              "which setup ssh never writes; it is not counted (herald-os setup ssh --off removes it)")
    else:
        print("    sign-in: sshd's own settings (herald-os setup ssh has not set it up)")
    if state["user"]:
        print(f"    keys: {'unknown' if state['keys'] is None else state['keys']} for {state['user']}")
    firewall = state["firewall"]
    if firewall is None:
        print("    firewall: not running")
    elif firewall["rule"] is None and firewall["service"] is None:
        print(f"    firewall: zone {firewall['zone'] or 'unknown'}; whether SSH gets in needs root (sudo herald-os setup ssh --status)")
    else:
        door = "open (Herald OS's rule)" if firewall["rule"] else "open (the zone's own ssh service)" if firewall["service"] else "closed"
        print(f"    firewall: SSH {door} in zone {firewall['zone']}")
    print(f"    rate limit: {'at most ' + SSH_LIMIT_RATE.replace('/', ' a ') + ' new connections from each address' if state['rateLimit'] else 'none'}"
          + ("; sshd needs it to start" if state["limitRequired"] else ""))
    print(f"    sessions: {state['sessions']} open over SSH")
    for warning in state["warnings"]:
        print(f"    WARNING: {warning}")
    return 0


def ssh_args(args: list[str]) -> dict:
    opts: dict = {"keys": [], "github": [], "files": [], "user": None, "passwords": False, "off": False, "status": False, "json": False, "no_firewall": False, "offline_firewall": False, "end_sessions": False}
    values = {"--key": "keys", "--github": "github", "--keys-file": "files"}
    flags = {"--passwords": "passwords", "--off": "off", "--status": "status", "--json": "json", "--no-firewall": "no_firewall", "--offline-firewall": "offline_firewall", "--end-sessions": "end_sessions"}
    seen: set[str] = set()
    at = 0
    while at < len(args):
        name, equals, value = args[at].partition("=")
        if name in values or name == "--user":
            if not equals:
                at += 1
                if at >= len(args):
                    die(f"{name} needs a value\n  {SSH_USAGE}", 2)
                value = args[at]
            if name == "--user":
                if "--user" in seen:
                    die(f"setup ssh: --user given twice\n  {SSH_USAGE}", 2)
                if not ACCOUNT_NAME.match(value):
                    die(f"setup ssh: --user {value!r} is not an account name\n  {SSH_USAGE}", 2)
                if value == "root":
                    die("setup ssh: --user root: root never signs in over SSH", 2)
                opts["user"] = value
            else:
                opts[values[name]].append(value)
        elif args[at] in flags:
            if args[at] in seen:
                die(f"setup ssh: {args[at]} given twice\n  {SSH_USAGE}", 2)
            opts[flags[args[at]]] = True
        else:
            die(f"setup ssh: unknown argument {args[at]!r}\n  {SSH_USAGE}", 2)
        seen.add(name if name in values or name == "--user" else args[at])
        at += 1
    if opts["no_firewall"] and opts["offline_firewall"]:
        die(f"setup ssh: --no-firewall and --offline-firewall exclude each other\n  {SSH_USAGE}", 2)
    gives = opts["keys"] or opts["github"] or opts["files"] or opts["passwords"] or opts["no_firewall"] or opts["offline_firewall"]
    if (
        (opts["off"] and (opts["status"] or gives))
        or (opts["status"] and gives)
        or (opts["json"] and not opts["status"])
        or (opts["end_sessions"] and not opts["off"])
    ):
        die(f"setup ssh: those arguments do not go together\n  {SSH_USAGE}", 2)
    return opts


def setup_ssh(args: list[str]) -> int:
    """Turn SSH on for keys only (or passwords, when asked), off again, or say how it is. With --json,
    whatever happens, stdout gets one JSON object, an error included."""
    if "--json" not in args:
        return setup_ssh_run(args)
    said = io.StringIO()
    try:
        with contextlib.redirect_stderr(said):
            return setup_ssh_run(args)
    except SystemExit as stopped:
        if stopped.code in (0, None):
            raise
        message = said.getvalue().strip().removeprefix("herald-os: ")
        print(ssh_json(error=message or f"exit {stopped.code}"))
        raise


def setup_ssh_run(args: list[str]) -> int:
    opts = ssh_args(args)
    try:
        return setup_ssh_act(opts)
    except KeyboardInterrupt:
        # Ctrl+C: what it means to say (what was put back) is said already; no traceback.
        raise SystemExit(130) from None


def setup_ssh_act(opts: dict) -> int:
    try:
        if opts["status"]:
            return ssh_status(opts)
        if opts["off"]:
            return ssh_off(opts)
        return ssh_on(opts)
    except subprocess.TimeoutExpired as exc:
        command = " ".join(exc.cmd) if isinstance(exc.cmd, (list, tuple)) else str(exc.cmd)
        die(f"setup ssh stopped: `{command}` did not finish within {exc.timeout:.0f} s and was stopped. "
            "Find out why it hangs and run this again; herald-os setup ssh --status shows what is in place.", 124)
    except OSError as exc:
        # Anything the checks above did not foresee (a file that cannot be read or written) ends here,
        # said plainly, rather than as a traceback.
        die(f"setup ssh stopped: {exc.strerror or exc}{' (' + str(exc.filename) + ')' if exc.filename else ''}. "
            "Fix that and run it again; herald-os setup ssh --status shows what is in place.", 1)
    return 1


OSTREE_BOOTED = Path("/run/ostree-booted")
OS_RELEASES = (Path("/etc/os-release"), Path("/usr/lib/os-release"))
IMAGE_SHELL = Path("/usr/share/herald-os/app/resources/app.asar")


def is_image() -> bool:
    """The Herald OS image (bootc): updates replace the whole system and can be undone. Another bootc
    or ostree system (Silverblue, Bazzite, Bluefin) is the person's own, and never gets bootc from here."""
    if not OSTREE_BOOTED.exists():
        return False
    for path in OS_RELEASES:
        try:
            lines = path.read_text(errors="replace").splitlines()
        except OSError:
            continue
        if any(line.strip() in ("IMAGE_ID=herald-os", 'IMAGE_ID="herald-os"') for line in lines):
            return True
    # Images built before os-release named them: only the image puts the shell under /usr/share.
    return IMAGE_SHELL.is_file()


def image_switch(channel: str) -> int:
    """Follow the image tag for a channel (stable for releases, edge for main)."""
    status = sh(["sudo", "bootc", "status", "--format", "json"], timeout=60)
    if status.returncode != 0:
        detail = (status.stderr or "").strip().splitlines()
        die("could not read the current image (bootc status failed"
            + (f": {detail[-1]}" if detail else "") + "); the channel is unchanged.", 1)
    try:
        current = json.loads(status.stdout)["spec"]["image"]["image"]
    except (ValueError, KeyError, TypeError):
        current = None
    if not isinstance(current, str) or not current:
        die("could not tell which image this system follows (unexpected `bootc status` output); "
            "the channel is unchanged.", 1)
    # A reference is repo[:tag][@digest]; a ':' before the last '/' is a registry port, not a tag.
    repo = current.split("@", 1)[0]
    if ":" in repo.rsplit("/", 1)[-1]:
        repo = repo.rsplit(":", 1)[0]
    target = f"{repo}:{channel}"
    if target == current:
        return 0
    print(f"==> following {target}")
    return subprocess.call(["sudo", "bootc", "switch", target])


def rollback() -> int:
    if not is_image():
        # A release tarball keeps the version its last update replaced in /opt/herald-os.previous.
        tarball = shutil.which("herald-os-tarball")
        if tarball and Path("/opt/herald-os.previous/resources/app.asar").is_file():
            return subprocess.call(["sudo", *([] if sys.stdin.isatty() else ["-n"]), tarball, "rollback"])
        die("rollback is for the Herald OS image and the release tarball; on this system, use your package manager's history", 2)
    code = subprocess.call(["sudo", "bootc", "rollback"])
    if code == 0:
        notify("Rollback ready", "Restart to use the previous version of Herald OS; this one stays in the boot menu.")
    return code


def firmware(args: list[str]) -> int:
    if not shutil.which("fwupdmgr"):
        die("fwupd is not installed (sudo dnf install fwupd)", 127)
    action = args[0] if args else "check"
    subprocess.call(["fwupdmgr", "refresh", "--force"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if action == "check":
        result = sh(["fwupdmgr", "get-updates", "--json"], timeout=120)
        try:
            devices = [d for d in json.loads(result.stdout or "{}").get("Devices", []) if d.get("Releases")]
        except ValueError:
            devices = []
        if not devices:
            print("Firmware is up to date")
            return 0
        for device in devices:
            print(f"{device.get('Name')}: {device['Releases'][0].get('Version')} available")
        return 0
    if action == "update":
        # Some updates apply on the next restart; fwupd says which.
        return subprocess.call(["fwupdmgr", "update", "--assume-yes", "--no-reboot-check"])
    die("firmware [check|update]", 2)
    return 2


RESET_HELPER = Path("/usr/libexec/herald-os/reset-helper")


def reset_disk_note(encrypted: bool | None) -> str:
    """What a reset leaves on the disk, said plainly; None when it cannot be told (pure; tested)."""
    if encrypted is None:
        return ("Herald OS could not tell whether the disk is encrypted. If it is not, a reset deletes the files "
                "but is not a secure erase: someone with the disk and recovery tools may get some of them back.")
    if encrypted:
        return ("The disk is encrypted, and its password stays the current one until whoever sets it up next "
                "chooses their own in setup: tell it to them, as they type it once to start the computer.")
    return ("This disk is not encrypted: a reset deletes the files, but it is not a secure erase. Someone with "
            "the disk and recovery tools may get some of them back. Installing again with \"Encrypt my data\" "
            "ticked protects what is written from then on.")


def reset(args: list[str]) -> int:
    if not RESET_HELPER.exists():
        die("reset is for the Herald OS image", 2)
    if not sys.stdin.isatty():
        die("reset needs a terminal: it asks you to confirm and for your password", 2)
    user = os.environ.get("USER", "")
    print(f"This erases {user}'s files, apps and settings on this computer, then restarts into setup.")
    print("Herald OS itself stays. Back up anything you want to keep first.")
    try:
        encrypted: bool | None = bool(disk_devices())
    except DiskUnknown:
        encrypted = None
    print(reset_disk_note(encrypted))
    if input("Type ERASE to continue: ").strip() != "ERASE":
        print("Nothing was changed.")
        return 1
    return subprocess.call(["sudo", str(RESET_HELPER), "schedule", user])


# ---------------------------------------------------------------------------------------------
# Omarchy: Herald OS as an app inside it (herald-os-app), wearing Omarchy's theme, in its menu, on
# its own keys. Herald never overwrites a file Omarchy or the person owns: it adds one marked line
# to theirs, or prints what to add. Omarchy 4 (Lua Hyprland config, its menu JSONC, state under
# ~/.local/state) and Omarchy 3 (hyprland.conf, ~/.config/omarchy/current) are both handled.
OMARCHY_SHARE = HOME / ".local" / "share" / "omarchy"
OMARCHY_PACKAGE = Path("/usr/share/omarchy")
OMARCHY_HOOKS = HOME / ".config" / "omarchy" / "hooks"
OMARCHY_MENU = HOME / ".config" / "omarchy" / "extensions" / "omarchy-menu.jsonc"
# Where the active theme is linked: Omarchy 4, then Omarchy 3.
OMARCHY_CURRENT = (HOME / ".local" / "state" / "omarchy" / "current", HOME / ".config" / "omarchy" / "current")
HYPR_DIR = HOME / ".config" / "hypr"
HERALD_HYPR = HYPR_DIR / "herald-os.conf"
HYPR_SOURCE = "source = ~/.config/hypr/herald-os.conf  # herald-os"
HERALD_HYPR_LUA = HYPR_DIR / "herald-os.lua"
HYPR_REQUIRE = 'require("hypr.herald-os")  -- herald-os'
APP_DESKTOP = APPS_DIR / "herald-os-app.desktop"
THEME_HOOK = "#!/bin/sh\n# Herald OS follows the Omarchy theme (herald-os omarchy remove takes this out).\nexec herald-os theme omarchy >/dev/null 2>&1\n"
HOOK_DISPATCHER = (
    "#!/bin/sh\n# herald-os: runs every hook in theme-set.d with the theme's name.\n"
    'for hook in "$(dirname "$0")"/theme-set.d/*; do [ -x "$hook" ] && "$hook" "$@"; done\n'
)
# Omarchy's menu parser drops whole-line // comments only: a comment after a row breaks the whole file.
MENU_MARK = "  // Herald OS (herald-os omarchy remove takes it out):"
MENU_LINE = '  "herald-os": {"icon": "󰚩", "label": "Herald OS", "action": "herald-os-app", "description": "Hermes as your desktop"},'
HYPR_LUA_BINDS = """-- Herald OS (written by `herald-os omarchy install`; `herald-os omarchy remove` takes it out).
o.bind("SUPER + ALT + H", "Herald OS", "herald-os-app")
o.bind("SUPER + ALT + A", "Ask Hermes about this window", "herald-os ask")
o.bind("SUPER + ALT + C", "Hermes command bar", "herald-os command")
o.bind("SUPER + ALT + V", "Talk to Hermes", "herald-os voice")
o.bind("SUPER + ALT + X", "Dictate into the focused app", "herald-os dictate")
o.bind("SUPER + ALT + E", "Emoji", "herald-os emoji")
o.bind("SUPER + ALT + M", "Hermes missions", "herald-os page missions")
"""
HYPR_BINDS = """# Herald OS (written by `herald-os omarchy install`; `herald-os omarchy remove` takes it out).
# Super+Alt+H, then: Return opens Herald OS, A asks about this window, C opens the command bar,
# V talks to Hermes, X dictates into the focused app, E picks an emoji, M shows Missions.
bindd = SUPER ALT, H, Herald OS keys, submap, herald
submap = herald
bindd = , Return, Open Herald OS, exec, herald-os-app
bindd = , A, Ask Hermes about this window, exec, herald-os ask
bindd = , C, Hermes command bar, exec, herald-os command
bindd = , V, Talk to Hermes, exec, herald-os voice
bindd = , X, Dictate into the focused app, exec, herald-os dictate
bindd = , E, Emoji, exec, herald-os emoji
bindd = , M, Missions, exec, herald-os page missions
"""
HYPR_BINDS += "".join(f"bind = , {key}, submap, reset\n" for key in ("Return", "A", "C", "V", "X", "E", "M", "escape"))
HYPR_BINDS += "submap = reset\n"


def omarchy_root() -> Path | None:
    """Omarchy itself: $OMARCHY_PATH, Omarchy 4's package (/usr/share/omarchy), or Omarchy 3's checkout."""
    roots = [Path(os.environ["OMARCHY_PATH"])] if os.environ.get("OMARCHY_PATH") else []
    return next((root for root in (*roots, OMARCHY_PACKAGE, OMARCHY_SHARE) if (root / "bin").is_dir() or (root / "themes").is_dir()), None)


def is_omarchy() -> bool:
    return omarchy_root() is not None


def omarchy_app_mode() -> bool:
    """Herald runs inside Omarchy (Hyprland), not as its own niri session."""
    return is_omarchy() and compositor() == "hyprland"


def omarchy_tool(name: str) -> str | None:
    root = omarchy_root()
    return shutil.which(name) or (str(root / "bin" / name) if root and (root / "bin" / name).exists() else None)


def omarchy_current_theme() -> str:
    """The active theme's name: Omarchy 4 stages a copy as current/theme and writes the name beside
    it in theme.name; Omarchy 3 links the theme's own folder as current/theme."""
    for base in OMARCHY_CURRENT:
        if (base / "theme").exists():
            named = base / "theme.name"
            name = named.read_text(errors="replace").strip() if named.is_file() else ""
            return name or (base / "theme").resolve().name
    return ""


def omarchy_theme(sub: str, name: str) -> int:
    if sub == "set":
        tool = omarchy_tool("omarchy-theme-set")
        if not tool:
            die("omarchy-theme-set is missing; set the theme from Omarchy's menu", 127)
        return subprocess.call([tool, name])
    if sub == "current":
        print(omarchy_current_theme())
        return 0
    root = omarchy_root()
    for base in (HOME / ".config" / "omarchy" / "themes", *([root / "themes"] if root else [])):
        if base.is_dir():
            for theme in sorted(p.name for p in base.iterdir() if p.is_dir()):
                print(theme)
    return 0


def omarchy_runs_hook_dirs() -> bool:
    """Omarchy 4's omarchy-hook runs hooks/<name>.d/ itself; Omarchy 3 ran only hooks/<name>."""
    tool = omarchy_tool("omarchy-hook")
    try:
        return bool(tool) and ".d" in Path(tool).read_text(errors="replace")
    except OSError:
        return False


def split_jsonc_comment(line: str) -> tuple[str, str]:
    """A JSONC line as (code, // comment), ignoring // inside strings (pure)."""
    quoted = False
    for i, char in enumerate(line):
        if char == '"' and (i == 0 or line[i - 1] != "\\"):
            quoted = not quoted
        elif not quoted and line.startswith("//", i):
            return line[:i], line[i:]
    return line, ""


def menu_with_herald(text: str) -> str | None:
    """Omarchy 4's menu JSONC (an object of dotted ids) with Herald's row added before its closing
    brace, or None when it is already there or the file is not such an object (pure; tested)."""
    if '"herald-os"' in text:
        return None
    lines = text.rstrip().splitlines()
    close = len(lines) - 1
    if close < 0 or split_jsonc_comment(lines[close])[0].strip() != "}" or split_jsonc_comment(lines[0])[0].strip()[:1] not in ("{", ""):
        return None
    # The entry before ours needs its comma.
    previous = next((i for i in range(close - 1, -1, -1) if split_jsonc_comment(lines[i])[0].strip()), None)
    if previous is not None:
        code, comment = split_jsonc_comment(lines[previous])
        if not code.rstrip().endswith((",", "{")):
            lines[previous] = code.rstrip() + "," + (f"  {comment}" if comment else "")
    return "\n".join([*lines[:close], MENU_MARK, MENU_LINE, *lines[close:]]) + "\n"


def menu_without_herald(text: str) -> str:
    """The menu JSONC with Herald's row taken out again (pure; tested)."""
    ours = (MENU_MARK.strip(), MENU_LINE.strip())
    return "\n".join(line for line in text.splitlines() if line.strip() not in ours) + "\n"


def without_line(text: str, line: str) -> str:
    return "\n".join(existing for existing in text.splitlines() if existing.strip() != line).rstrip("\n") + "\n"


def omarchy_status() -> dict[str, bool]:
    lua, conf = HYPR_DIR / "hyprland.lua", HYPR_DIR / "hyprland.conf"
    lua_keys = HERALD_HYPR_LUA.exists() and lua.exists() and HYPR_REQUIRE in lua.read_text(errors="replace")
    conf_keys = HERALD_HYPR.exists() and conf.exists() and HYPR_SOURCE in conf.read_text(errors="replace")
    status = {
        "app entry": APP_DESKTOP.exists(),
        "theme hook": (OMARCHY_HOOKS / "theme-set.d" / "herald-os").exists(),
        "keys": lua_keys or conf_keys,
    }
    # Only Omarchy 4 has a menu Herald can add to.
    if OMARCHY_MENU.exists():
        status["menu entry"] = '"herald-os"' in OMARCHY_MENU.read_text(errors="replace")
    return status


def omarchy_install() -> int:
    if not is_omarchy():
        die("this is not an Omarchy install (no /usr/share/omarchy or ~/.local/share/omarchy)", 1)
    notes: list[str] = []
    APPS_DIR.mkdir(parents=True, exist_ok=True)
    APP_DESKTOP.write_text(
        "[Desktop Entry]\nName=Herald OS\nComment=The AI-native desktop, as an app\nExec=herald-os-app\n"
        "Icon=herald-os\nType=Application\nCategories=System;Utility;\nTerminal=false\nStartupWMClass=herald-os\n"
    )
    # Theme hook: Omarchy runs theme-set.d itself on 4; on 3 a small dispatcher does.
    hooks = OMARCHY_HOOKS / "theme-set.d"
    hooks.mkdir(parents=True, exist_ok=True)
    (hooks / "herald-os").write_text(THEME_HOOK)
    (hooks / "herald-os").chmod(0o755)
    dispatcher = OMARCHY_HOOKS / "theme-set"
    if omarchy_runs_hook_dirs():
        if dispatcher.exists() and dispatcher.read_text(errors="replace") == HOOK_DISPATCHER:
            dispatcher.unlink()
    elif not dispatcher.exists():
        dispatcher.write_text(HOOK_DISPATCHER)
        dispatcher.chmod(0o755)
    elif "theme-set.d" not in dispatcher.read_text(errors="replace"):
        notes.append(f'Your {dispatcher} hook exists; add this line so Herald follows themes:\n  for hook in ~/.config/omarchy/hooks/theme-set.d/*; do [ -x "$hook" ] && "$hook" "$@"; done')
    # The menu: Omarchy 4's JSONC extensions (Omarchy 3 had none; Applications lists Herald there).
    if OMARCHY_MENU.exists():
        updated = menu_with_herald(OMARCHY_MENU.read_text(errors="replace"))
        if updated is not None:
            OMARCHY_MENU.write_text(updated)
        elif '"herald-os"' not in OMARCHY_MENU.read_text(errors="replace"):
            notes.append(f"Add this row to {OMARCHY_MENU}:\n{MENU_LINE}")
    # Keys: Lua on Omarchy 4, hyprland.conf on Omarchy 3.
    HYPR_DIR.mkdir(parents=True, exist_ok=True)
    lua, conf = HYPR_DIR / "hyprland.lua", HYPR_DIR / "hyprland.conf"
    if lua.exists():
        HERALD_HYPR_LUA.write_text(HYPR_LUA_BINDS)
        if HYPR_REQUIRE not in lua.read_text(errors="replace"):
            with lua.open("a") as handle:
                handle.write(f"\n{HYPR_REQUIRE}\n")
        keys = "Super+Alt+H"
    elif conf.exists():
        HERALD_HYPR.write_text(HYPR_BINDS)
        if HYPR_SOURCE not in conf.read_text(errors="replace"):
            with conf.open("a") as handle:
                handle.write(f"\n{HYPR_SOURCE}\n")
        keys = "Super+Alt+H then Return"
    else:
        keys = "Applications"
        notes.append(f"No Hyprland config in {HYPR_DIR}; Herald's keys were not added.")
    relay("theme-omarchy", [], quiet=True)
    print(f"Herald OS is set up inside Omarchy: open it from the Omarchy menu, Applications or {keys}.")
    for note in notes:
        print(note)
    return 0


def omarchy_remove() -> int:
    for path in (APP_DESKTOP, OMARCHY_HOOKS / "theme-set.d" / "herald-os", HERALD_HYPR, HERALD_HYPR_LUA):
        path.unlink(missing_ok=True)
    dispatcher = OMARCHY_HOOKS / "theme-set"
    if dispatcher.exists() and dispatcher.read_text(errors="replace") == HOOK_DISPATCHER:
        dispatcher.unlink()
    if OMARCHY_MENU.exists():
        text = OMARCHY_MENU.read_text(errors="replace")
        if text.startswith("// Added by Herald OS"):
            # An earlier Herald OS wrote this whole file.
            OMARCHY_MENU.unlink()
        elif MENU_LINE.strip() in text or MENU_MARK.strip() in text:
            OMARCHY_MENU.write_text(menu_without_herald(text))
    for config, line in ((HYPR_DIR / "hyprland.conf", HYPR_SOURCE), (HYPR_DIR / "hyprland.lua", HYPR_REQUIRE)):
        if config.exists() and line in config.read_text(errors="replace"):
            config.write_text(without_line(config.read_text(errors="replace"), line))
    print("Herald OS is out of Omarchy's theme hook, menu and keys.")
    return 0


def omarchy_cmd(args: list[str]) -> int:
    action = args[0] if args else "status"
    if action == "install":
        return omarchy_install()
    if action == "remove":
        return omarchy_remove()
    if action == "status":
        if not is_omarchy():
            print("not Omarchy")
            return 1
        for name, done in omarchy_status().items():
            print(f"{name:<11} {'yes' if done else 'no'}")
        return 0
    die("omarchy install | remove | status", 2)
    return 2


# ---------------------------------------------------------------------------------------------
BAR_USAGE = (
    "bar [list] | bar show|hide <item> | bar move <item> first|last|<n>|before <item>|after <item> "
    "| bar clock [12h|24h|system] [seconds|no-seconds] [date short|long|none] | bar reset"
)


def bar_args(args: list[str]) -> tuple[str, dict]:
    """`herald-os bar …` as a registry command and its arguments (pure; tested)."""
    action = args[0] if args else "list"
    rest = args[1:]
    if action == "list" and not rest:
        return "bar.layout", {}
    if action in ("show", "hide") and len(rest) == 1:
        return f"bar.{action}", {"item": rest[0]}
    if action == "move" and len(rest) == 3 and rest[1] in ("before", "after"):
        return "bar.move", {"item": rest[0], rest[1]: rest[2]}
    if action == "move" and len(rest) == 2 and (rest[1] in ("first", "last") or rest[1].isdigit()):
        return "bar.move", {"item": rest[0], "position": rest[1]}
    if action == "clock" and rest:
        clock: dict = {}
        tokens = [token.lower() for token in rest]
        while tokens:
            token = tokens.pop(0)
            if token in ("12h", "12", "24h", "24", "system"):
                clock["hours"] = token.removesuffix("h")
            elif token in ("seconds", "no-seconds"):
                clock["seconds"] = token == "seconds"
            elif token == "date" and tokens and tokens[0] in ("short", "long", "none"):
                clock["date"] = tokens.pop(0)
            else:
                die(BAR_USAGE, 2)
        return "bar.clock", clock
    if action == "reset" and not rest:
        return "bar.reset", {}
    die(BAR_USAGE, 2)
    return "", {}


def bar_cmd(args: list[str]) -> int:
    """The menu bar's items and clock, through the shell's registry (the same commands as Settings)."""
    command, payload = bar_args(args)
    reply = run_os_wait(command, payload)
    if command != "bar.layout":
        print(reply.get("summary") or "done")
        return 0
    data = reply.get("data") or {}
    for item in data.get("items", []):
        state = "pinned" if item.get("pinned") else "shown" if item.get("shown") else "hidden"
        print(f"  {item.get('id', '?'):<14} {state:<7} {item.get('label', '')}")
    clock = data.get("clock") or {}
    print(f"  clock: {clock.get('hours', 'system')} hours, seconds {'on' if clock.get('seconds') else 'off'}, date {clock.get('date', 'short')}")
    return 0


def menu_check() -> int:
    """What the control menu makes of ~/.config/herald-os/menu.json (your own entries)."""
    reply = relay("menu-check", [])
    if not reply.get("ok"):
        die(reply.get("error") or "the shell rejected the command", 1)
    entries = reply.get("entries", [])
    print(f"{reply.get('file', 'menu.json')}: {len(entries)} {'entry' if len(entries) == 1 else 'entries'}")
    for entry in entries:
        print(f"  {entry.get('group', 'yours'):<9} {entry.get('kind', ''):<10} {entry.get('label', '')}")
    for problem in reply.get("errors", []):
        print(f"  problem: {problem}")
    return 1 if reply.get("errors") else 0


PLUGIN_ACTIONS = ("list", "add", "enable", "disable", "update", "remove")


def plugin_cmd(args: list[str]) -> int:
    """Widget plugins (ADR-019), through the running shell so Settings > Plugins sees the same state."""
    action = args[0] if args else "list"
    target = args[1] if len(args) > 1 else ""
    if action == "dir":
        print(CONFIG_DIR / "plugins")
        return 0
    if action not in PLUGIN_ACTIONS or (action != "list" and not target):
        die("plugin list [--json] | plugin add <git-url> | plugin enable|disable|update|remove <id> | plugin dir", 2)
    if action == "enable":
        # The person turns a plugin on after reading what it may do; scripts and agents cannot.
        listing = relay("plugin", ["list"])
        found = next((plugin for plugin in listing.get("plugins", []) if plugin.get("id") == target), None)
        if not found:
            die(f"no plugin {target!r} (herald-os plugin list)", 1)
        if found.get("errors"):
            die(f"{target} cannot load: " + "; ".join(found["errors"]), 1)
        if not sys.stdin.isatty():
            die("turning a plugin on asks you first; run this in a terminal, or use Settings > Plugins", 2)
        print(f"Turn on {found.get('name') or target}? It will be able to:")
        for line in found.get("grants", []):
            print(f"  - {line}")
        if input("Turn it on? [y/N] ").strip().lower() not in ("y", "yes"):
            print("left off")
            return 1
    reply = relay("plugin", [action, target], timeout=180 if action in ("add", "update") else 15)
    if not reply.get("ok"):
        die(reply.get("error") or "the shell rejected the command", 1)
    if action == "list":
        plugins = reply.get("plugins", [])
        if "--json" in args:
            print(json.dumps(plugins, indent=2))
            return 0
        if not plugins:
            print(f"no plugins (herald-os plugin add <git-url>, or make a folder in {CONFIG_DIR / 'plugins'})")
        for plugin in plugins:
            state = "broken" if plugin.get("errors") else "on" if plugin.get("enabled") else "off"
            print(f"  {plugin.get('id', '?'):<24} {state:<7} {', '.join(plugin.get('placement', [])):<20} {plugin.get('name', '')}")
        return 0
    if action in ("add", "update"):
        plugin = reply.get("plugin", {})
        name = f"{plugin.get('name') or target} {plugin.get('version', '')}".strip()
        print(f"{name} installed, turned off (herald-os plugin enable {plugin.get('id', '')})" if action == "add" else f"{name} updated")
        return 0
    print(f"{target}: {action}d")
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"-h", "--help", "help"}:
        print(__doc__.strip())
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd == "commands":
        if "--json" in args:
            print(json.dumps([{"name": k, "help": v} for k, v in COMMANDS.items()], indent=2))
        else:
            width = max(len(k) for k in COMMANDS)
            for name, text in COMMANDS.items():
                print(f"  {name.ljust(width)}  {text}")
        return 0
    if cmd not in COMMANDS:
        die(f"unknown command {cmd!r} (see `herald-os commands`)", 2)

    if cmd == "channel":
        marker = CONFIG_DIR / "channel"
        if args:
            if args[0] not in ("stable", "edge"):
                die("channel stable|edge", 2)
            # The marker changes only once the switch worked, so a failed switch keeps the old channel.
            if is_image() and image_switch(args[0]) != 0:
                die(f"could not switch the image's channel (bootc switch); is the {args[0]} tag published? "
                    "You are still on the previous channel.", 1)
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            marker.write_text(args[0] + "\n")
        print(marker.read_text().strip() if marker.exists() else "stable")
        return 0
    if cmd == "rollback":
        return rollback()
    if cmd == "firmware":
        return firmware(args)
    if cmd == "restart":
        return restart_cmd(args)
    if cmd == "reset":
        return reset(args)
    if cmd == "omakase":
        tool = shutil.which("herald-os-omakase")
        if not tool:
            die("herald-os-omakase is not installed", 127)
        return subprocess.call([tool, *(args or ["install"])])
    if cmd == "menu" and args[:1] == ["check"]:
        return menu_check()
    if cmd == "hermes-command":
        install = hermes_install()
        if not install or ("--managed" in args and install[0] != "managed"):
            return 1
        print("\n".join(install[1]))
        return 0
    if cmd in OVERLAY or cmd in {"page", "open", "launch", "notify", "voice", "dictate", "state", "update-available", "panel"}:
        reply = relay(cmd, args)
        if cmd == "state":
            print(json.dumps(reply, indent=2))
        if not reply.get("ok", False):
            die(reply.get("error") or "the shell rejected the command", 1)
        return 0
    if cmd == "install":
        if len(args) >= 2 and args[0] == "app":
            return install_app(" ".join(args[1:]))
        if len(args) >= 3 and args[0] == "webapp":
            return install_webapp(args[1], args[2], args[3] if len(args) > 3 else None)
        if args and args[0] not in ("app", "webapp"):
            return catalog(["install", *args])
        die("install <catalog-id> | install app <name> | install webapp <name> <url> [icon-url]", 2)
    if cmd == "remove":
        if len(args) >= 2 and args[0] == "app":
            return remove_app(" ".join(args[1:]))
        if len(args) >= 2 and args[0] == "webapp":
            return remove_webapp(" ".join(args[1:]))
        if args and args[0] not in ("app", "webapp"):
            return catalog(["remove", *args])
        die("remove <catalog-id> | remove app <name> | remove webapp <name>", 2)
    if cmd == "catalog":
        return catalog(args or ["list"])
    if cmd == "windows":
        return catalog(["windows", *args])
    if cmd == "webapp-open":
        if len(args) < 2:
            die("webapp-open <url> <name>", 2)
        return webapp_open(args[0], " ".join(args[1:]))
    if cmd == "update":
        return update("--check" in args)
    if cmd == "theme":
        sub = args[0] if args else "current"
        if sub == "omarchy":
            # Omarchy's theme-set hook: Herald's colours follow Omarchy's theme.
            reply = relay("theme-omarchy", [], quiet=True)
            if not reply.get("ok"):
                die(reply.get("error") or "the Herald OS shell is not running", 1)
            print(reply.get("theme", ""))
            return 0
        if omarchy_app_mode() and sub in ("list", "current", "set"):
            # Inside Omarchy, Omarchy owns themes; Herald follows through the hook.
            return omarchy_theme(sub, " ".join(args[1:]))
        if sub == "list":
            return theme_list()
        if sub == "current":
            return theme_current()
        if sub == "set":
            return theme_set(" ".join(args[1:]))
        if sub == "install" and len(args) == 2:
            return theme_install(args[1])
        if sub == "new" and len(args) >= 2:
            image = Path(args[1]).expanduser().resolve()
            if not image.is_file():
                die(f"no such image: {args[1]}", 1)
            return run_os("theme.generate", {"image": str(image), **({"name": " ".join(args[2:])} if len(args) > 2 else {})})
        die("theme list | theme set <name> | theme current | theme new <image> [name] | theme install <git-url>", 2)
    if cmd == "font":
        return font(args)
    if cmd == "wallpaper":
        return wallpaper(args[0] if args else "default")
    if cmd == "reminder":
        return reminder(args)
    if cmd == "notice":
        return notice(args[0] if args else "")
    if cmd == "screenshot":
        return screenshot()
    if cmd == "capture":
        return capture(args)
    if cmd == "ocr":
        return ocr()
    if cmd == "crash":
        return crash(args)
    if cmd == "toggle":
        return toggle(args)
    if cmd == "screensaver":
        reply = relay("screensaver", [])
        return 0 if reply.get("ok") else 1
    if cmd == "idle":
        return idle_cmd(args)
    if cmd == "keymap":
        return keymap_cmd(args)
    if cmd == "plugin":
        return plugin_cmd(args)
    if cmd == "bar":
        return bar_cmd(args)
    if cmd == "branding":
        return branding_cmd(args)
    if cmd == "weather":
        return weather_cmd(args)
    if cmd == "omarchy":
        return omarchy_cmd(args)
    if cmd == "setup":
        return setup(args)
    if cmd == "event":
        return event_cmd(args)
    if cmd == "hook":
        return hook_cmd(args)
    if cmd == "canvas":
        return canvas_cmd(args)
    if cmd == "docs":
        return docs_cmd(args)
    if cmd == "sheets":
        return sheets_cmd(args)
    if cmd == "slides":
        return slides_cmd(args)
    if cmd == "calc":
        return calc_cmd(args)
    if cmd == "os":
        if not args:
            die("os <command.id> [json args]", 2)
        try:
            payload = json.loads(args[1]) if len(args) > 1 else {}
        except json.JSONDecodeError:
            die("os: the arguments must be a JSON object", 2)
        return run_os(args[0], payload if isinstance(payload, dict) else {})
    if cmd == "lock":
        return lock()
    if cmd == "password":
        if args[:1] == ["--disk-root"]:
            return disk_root(args[1:])
        if args[:1] == ["--disk"]:
            return disk_password(args[1:])
        if args:
            die(f"password | {DISK_USAGE}", 2)
        return password()
    if cmd == "suspend":
        return suspend()
    if cmd == "wm":
        if not args:
            die("wm needs an action (niri's names, mapped to dispatchers on Hyprland)", 2)
        return wm(*args)
    if cmd == "debug":
        return debug()
    die(f"{cmd} is not implemented", 2)
    return 2


if __name__ == "__main__":
    SSH_OWN_PROCESS = True
    sys.exit(main(sys.argv[1:]))
