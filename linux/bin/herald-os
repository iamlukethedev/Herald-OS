#!/usr/bin/env python3
"""Herald OS command center.

Everything hotkeys and menus do is available here, so people and agents drive the system the same
way. Shell-facing commands are relayed to the running shell over its control socket; system chores
call the tools directly.

  Hermes        ask [text] | command | applications | menu | page <id> | open <window> | launch <app>
  Software      install app <name|flatpak-id> | install webapp <name> <url> [icon-url]
                remove app <name> | remove webapp <name> | update [--check]
  Style         theme list | theme set <name> | theme current | theme new <image> [name]
                theme install <git-url> | font list | font set <family> [--mono] | wallpaper <image>
                plugin list | plugin add <git-url> | plugin enable|disable|update|remove <id>
                bar list | bar show|hide <item> | bar move <item> <where> | bar clock 24h [seconds] | bar reset
                branding set [--logo <image>] [--lock <image>] [--name <text>] | branding reset
  Trigger       reminder <duration> <message> | reminder list | reminder clear
                notice time|battery|weather | screenshot | ocr | clipboard | notify <title> [body]
  Capture       capture screenshot [region|window|screen] | capture record [region] [audio] | capture stop
                capture region --ask | capture color | capture qr | capture text
                capture transcode <file> [gif|mp4|webm] | capture share <file>
  Canvas        canvas open [file] | canvas new [name] [WxH] | canvas status | canvas layers [project] | canvas history
                canvas text <words> [--x --y --size --font --color --align] | canvas resize <WxH> [--anchor <a>]
                canvas crop <x> <y> <w> <h> | canvas crop --ratio 4:5 [--angle <deg>] | canvas preview [project]
                canvas export <file> | canvas undo|redo [--steps <n>] | canvas auto [tone|contrast|color]
                canvas align <edges> [--layers a,b] [--to canvas|layers|selection] | canvas distribute <mode> --layers a,b,c
                canvas guides [list|clear] | canvas guides add|remove <axis> <pos> | canvas guides add --margins <m> [--columns <n>]
                canvas filter <kind> [--amount --radius --threshold --angle --distance --strength] [--layer <l>]
                canvas mask <layer> reveal|hide|invert|apply|enable|disable|remove|link|unlink|reveal-selection|hide-selection
                canvas remove-background [layer] [--cutout] | canvas fill <x> <y> <w> <h> [--layer <l>] [--new-layer]
  Docs          docs open [file] | docs new [name] [--template <t>] [--path <file>] [--content <markdown>|-] | docs list
                docs read [document] [--part markdown|text|outline|selection] [--heading <h>] | docs find <text>
                docs write <markdown>|- [--at end|start|selection|marked|after|heading] [--heading <h>] [--mode <m>]
                docs replace <find> <replacement> [--first] | docs format [--at <what>] [--style <s>] [--bold] [--color <c>]
                docs table <json-rows> | docs image <file> [--width <px>] | docs insert-range [range] [--workbook <w>]
                docs save [document] [--to <file>] [--overwrite] | docs pdf [document] [--to <file>] | docs undo|redo [--steps <n>]
  Sheets        sheets open [file] | sheets new [name] [--template <t>] [--path <file>] | sheets list | sheets read [range]
                sheets find <text> | sheets write <range> <value...> | sheets write <range> <json-rows>
                sheets fill <range> [formula] | sheets format <range> <json> | sheets sort <range> --by <column> [--descending]
                sheets filter <range> --by <column> --values <json> | sheets filter --clear | sheets freeze <rows> [columns]
                sheets add-sheet [name] | sheets rename-sheet <sheet> <name> | sheets remove-sheet <sheet>
                sheets replace <find> <replacement> [--first] | sheets clean <range> dedupe|trim|numbers|dates|split|case
                sheets save [workbook] [--to <file>] [--overwrite] | sheets pdf [workbook] | sheets undo|redo [--steps <n>]
  Slides        slides open [file] | slides new [name] [--theme <t>] [--slides <json>|-] | slides list | slides read [deck]
                slides add-slide [title] [--layout <l>] [--body <text>|-] [--notes <text>] | slides notes <slide> <text>|-
                slides set-slide <slide> [--title <t>] [--body <text>|-] [--layout <l>] [--hidden|--shown] [--background <c>]
                slides move <slide> <number|first|last> | slides remove <slide> | slides theme <name> | slides replace <find> <with>
                slides from-doc [document] [--level <n>] [--notes] | slides insert-range [range] [--workbook <w>] [--slide <s>]
                slides save [deck] [--to <file>] [--overwrite] | slides pdf [deck] [--to <file>] | slides undo|redo [--steps <n>]
  Crashes       crash list | crash diagnose [pid|name] | crash mute <name> [off]
  Events        event <name> [key=value ...] | hook list | hook install <event> <script> | hook dir
  System        lock | suspend | power | wm <niri action...> | state | debug | commands [--json]
                panel wifi|bluetooth|audio|display|power|clock: the menu bar's quick panels
                toggle nightlight|dnd|idle|screensaver [on|off] | screensaver | idle show|set ...
                os <command.id> [json args]: run any Herald OS command (the same ones Hermes uses)
"""

from __future__ import annotations

