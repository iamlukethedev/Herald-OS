#!/usr/bin/env bash
# The NVIDIA GPU, and what the Herald OS image does with it (ADR-029). Two notices, each said once:
#
# - switch: the default image drives an NVIDIA GPU with nouveau, which runs the screen but has no
#   CUDA, so local models get no GPU. The NVIDIA image (ghcr.io/iamlukethedev/herald-os-nvidia) has
#   NVIDIA's driver: says how to switch.
# - secure-boot: on the NVIDIA image with Secure Boot on, the kernel only loads the driver once
#   Universal Blue's signing key is enrolled. When the driver is not loaded, says how to enroll it.
#
# Anywhere but on the Herald OS image, or with nothing to say, says nothing.
#
#   herald-os-gpu-check                   print the notice (the first boot writes it to the journal)
#   herald-os-gpu-check --notify          also show it as a notification, once each (herald-os-session)
#   herald-os-gpu-check switch [channel]  switch to the NVIDIA image, once /boot has room for it:
#                                         bootc switch, or rpm-ostree rebase where packages are layered
set -euo pipefail

SYSFS="${HERALD_OS_SYSFS:-/sys}"
MODULES="${HERALD_OS_MODULES:-/usr/lib/modules}"
OS_RELEASE="${HERALD_OS_OS_RELEASE:-/usr/lib/os-release}"
ARCH="${HERALD_OS_ARCH:-$(uname -m)}"
STATE="${HERALD_OS_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/herald-os}"
NVIDIA_IMAGE=ghcr.io/iamlukethedev/herald-os-nvidia
KEY=/etc/pki/akmods/certs/akmods-ublue.der
# The UEFI global variable: four bytes of attributes, then 1 while Secure Boot is on.
SECURE_BOOT="$SYSFS/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c"
BOOT="${HERALD_OS_BOOT:-/boot}"
# An NVIDIA deployment's kernel and initramfs take about 352 MiB of /boot (docs/LINUX.md), and the
# system keeps up to three deployments: a 2 GiB /boot holds them (df shows a little less than 2 GiB).
BOOT_FREE_MIN=$((400 * 1024 * 1024))
BOOT_SIZE_MIN=$((1800 * 1024 * 1024))

herald_image() { grep -Eqx 'IMAGE_ID="?herald-os"?' "$OS_RELEASE" 2>/dev/null; }

# A display controller (PCI class 0x03xxxx: VGA, 3D or other) from NVIDIA (vendor 0x10de).
nvidia_gpu() {
  local dev vendor class
  for dev in "$SYSFS"/bus/pci/devices/*; do
    vendor="$(cat "$dev/vendor" 2>/dev/null)" || continue
    class="$(cat "$dev/class" 2>/dev/null)" || continue
    [[ "$vendor" == 0x10de && "$class" == 0x03* ]] && return 0
  done
  return 1
}

nvidia_driver() { compgen -G "$MODULES/*/extra/nvidia/nvidia.ko*" >/dev/null; }
nvidia_loaded() { [[ -d "$SYSFS/module/nvidia" ]]; }
secure_boot() { [[ "$(od -An -t u1 -j 4 -N 1 "$SECURE_BOOT" 2>/dev/null | tr -d ' ')" == 1 ]]; }

# Prints the notice; with --notify, also shows it, unless this one was shown before.
notice() {
  local kind="$1" title="$2" body="$3"
  echo "$title: $body"
  [[ "$NOTIFY" == 1 ]] || return 0
  [[ ! -f "$STATE/gpu-notice-$kind" ]] || return 0
  # Shown by the session before there were two notices.
  [[ "$kind" != switch || ! -f "$STATE/gpu-check-done" ]] || return 0
  herald-os notify "$title" "$body" || return 0
  mkdir -p "$STATE"
  : >"$STATE/gpu-notice-$kind"
}

current_channel() {
  local channel
  channel="$(herald-os channel 2>/dev/null || true)"
  [[ "$channel" == stable || "$channel" == edge ]] || channel=stable
  echo "$channel"
}

# Whether the booted deployment has packages layered, removed or replaced through rpm-ostree:
# bootc refuses to switch those ("Deployment contains local rpm-ostree modifications"). When the
# status cannot be read, bootc is tried, and says so itself.
layered() {
  local status
  command -v rpm-ostree >/dev/null || return 1
  status="$(rpm-ostree status --json 2>/dev/null)" || return 1
  python3 -c '
import json, sys
booted = [d for d in json.loads(sys.argv[1]).get("deployments", []) if d.get("booted")]
keys = ("requested-packages", "requested-local-packages", "requested-base-removals",
        "requested-base-local-replacements", "requested-base-remote-replacements")
sys.exit(0 if booted and any(booted[0].get(key) for key in keys) else 1)' "$status"
}

switch() {
  local channel="${1:-$(current_channel)}" size avail target
  [[ "$channel" == stable || "$channel" == edge ]] || { echo "usage: herald-os-gpu-check switch [stable|edge]" >&2; exit 2; }
  herald_image || { echo "this is not the Herald OS image: nothing to switch" >&2; exit 2; }
  [[ "$ARCH" == x86_64 ]] || { echo "the NVIDIA image is x86_64 only" >&2; exit 2; }
  read -r size avail < <(df -B1 --output=size,avail "$BOOT" | tail -n 1)
  if (( avail < BOOT_FREE_MIN )); then
    echo "$BOOT has $((avail / 1048576)) MiB free, and the NVIDIA image's kernel and initramfs need about 352 MiB (docs/LINUX.md, \"Space in /boot\"): nothing was changed" >&2
    exit 1
  fi
  if (( size < BOOT_SIZE_MIN )); then
    echo "WARNING: $BOOT is $((size / 1048576)) MiB; the NVIDIA image needs a 2 GiB /boot to keep three deployments (the running one, the one to go back to and an update)" >&2
  fi
  target="$NVIDIA_IMAGE:$channel"
  if layered; then
    echo "==> packages are layered on this system, so rpm-ostree switches it: $target"
    sudo rpm-ostree rebase "ostree-unverified-registry:$target"
  else
    echo "==> switching to $target"
    sudo bootc switch "$target"
  fi
  echo "Restart to start the NVIDIA image. With Secure Boot on, enroll Universal Blue's key after that (docs/LINUX.md, \"The NVIDIA image\")."
}

NOTIFY=0
case "${1:-}" in
  --notify) NOTIFY=1 ;;
  switch) shift; switch "$@"; exit ;;
  "") ;;
  *) echo "usage: herald-os-gpu-check [--notify | switch [stable|edge]]" >&2; exit 2 ;;
esac

if [[ "$ARCH" != x86_64 ]] || ! herald_image || ! nvidia_gpu; then
  exit 0
fi

if ! nvidia_driver; then
  notice switch "NVIDIA graphics found" "This computer has an NVIDIA GPU, which this Herald OS image drives without CUDA, so local models do not use it. The NVIDIA image has NVIDIA's driver: run \`herald-os-gpu-check switch $(current_channel)\` in a terminal (it checks /boot has room first), restart, then, with Secure Boot on, enroll Universal Blue's key once (docs/LINUX.md, \"The NVIDIA image\")."
elif ! nvidia_loaded && secure_boot; then
  notice secure-boot "The NVIDIA driver did not load" "Secure Boot is on, and it loads the driver only once Universal Blue's key is enrolled; until then the NVIDIA GPU is not used. Run \`sudo mokutil --import $KEY\` in a terminal, choose a one-time password, restart, and in MOK Manager pick Enroll MOK, Continue, Yes, type that password, then Reboot (docs/LINUX.md, \"The NVIDIA image\")."
fi
