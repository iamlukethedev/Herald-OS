[Unit]
Description=Herald OS: first-boot setup (the session user, the home folder, Hermes Agent)
# Once per machine; `herald-os reset` removes the stamp to run it again.
ConditionPathExists=!/var/lib/herald-os/firstboot-done
Wants=network-online.target systemd-homed.service systemd-userdbd.service sssd.service firewalld.service
# The accounts it looks for: systemd-homed's, and SSSD's or LDAP's, are only there once their
# services are up. On a system without them, these name nothing. firewalld first, so SSH, when an
# unattended install gave keys, opens in a running firewall.
After=network-online.target systemd-homed.service systemd-userdbd.service sssd.service firewalld.service
Before=greetd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/herald-os/firstboot.sh system
StandardOutput=journal+console
TimeoutStartSec=45min
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
