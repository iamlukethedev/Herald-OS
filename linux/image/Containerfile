# Herald OS Linux as a bootable container image (ADR-018): Fedora bootc with the Herald OS session,
# the CLIs and the prebuilt shell. Updates replace the whole image (bootc upgrade) and the previous
# one stays in the boot menu. Built by .github/workflows/image.yml; locally, from the repo root, with
# the shell tarball for the same architecture next to it:
#
#   podman build -f linux/image/Containerfile --build-arg SHELL_TARBALL=herald-os-linux.tar.gz -t herald-os .
#
# The NVIDIA image (x86_64 only, ADR-029) is the same image with NVIDIA's driver on top:
#
#   podman build -f linux/image/Containerfile --build-arg SHELL_TARBALL=herald-os-linux.tar.gz \
#     --target herald-os-nvidia -t herald-os-nvidia .
#
# Its kernel modules are Universal Blue's prebuilt nvidia-open akmods, signed with their key. They
# are built for one kernel, so FEDORA_BOOTC and AKMODS_TAG must name the same one: the workflow pins
# the base by digest and picks the akmods tag for its kernel (main-44-<kernel>); nvidia.sh refuses a
# mismatch. The default image never pulls the akmods images.
ARG FEDORA_BOOTC=quay.io/fedora/fedora-bootc:44
ARG AKMODS_TAG=main-44

FROM ghcr.io/ublue-os/akmods:${AKMODS_TAG} AS akmods
FROM ghcr.io/ublue-os/akmods-nvidia-open:${AKMODS_TAG} AS akmods-nvidia

FROM ${FEDORA_BOOTC} AS herald-os

ARG SHELL_TARBALL=herald-os-linux.tar.gz
COPY linux /tmp/herald-os/linux
COPY ${SHELL_TARBALL} /tmp/herald-os/shell.tar.gz

RUN bash /tmp/herald-os/linux/image/packages.sh --image /tmp/herald-os/shell.tar.gz \
 && dnf clean all \
 && rm -rf /tmp/herald-os /var/cache/* /var/log/* /var/lib/dnf

LABEL org.opencontainers.image.title="Herald OS" \
      org.opencontainers.image.description="An AI-native desktop built around Hermes Agent" \
      org.opencontainers.image.source="https://github.com/iamlukethedev/Herald-OS" \
      org.opencontainers.image.licenses="MIT" \
      containers.bootc="1"

RUN bootc container lint

FROM herald-os AS herald-os-nvidia

COPY linux/image/nvidia.sh linux/image/kargs-nvidia.toml /tmp/herald-os/
RUN --mount=type=bind,from=akmods,src=/rpms/ublue-os,dst=/tmp/akmods \
    --mount=type=bind,from=akmods-nvidia,src=/rpms,dst=/tmp/akmods-nvidia \
    bash /tmp/herald-os/nvidia.sh /tmp/akmods /tmp/akmods-nvidia \
 && dnf clean all \
 && rm -rf /tmp/herald-os /var/cache/* /var/log/* /var/lib/dnf

LABEL org.opencontainers.image.title="Herald OS (NVIDIA)" \
      org.opencontainers.image.description="An AI-native desktop built around Hermes Agent, with NVIDIA's driver and CUDA"

RUN bootc container lint

# Last, so a build without --target is the default image.
FROM herald-os
