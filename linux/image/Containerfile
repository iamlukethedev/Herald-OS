# Herald OS Linux as a bootable container image (ADR-018): Fedora bootc with the Herald OS session,
# the CLIs, desktop control and the prebuilt shell. Updates replace the whole image (bootc upgrade)
# and the previous one stays in the boot menu. Built by .github/workflows/image.yml; locally, from
# the repo root, with the shell tarball for the same architecture next to it:
#
#   podman build -f linux/image/Containerfile --build-arg SHELL_TARBALL=herald-os-linux.tar.gz -t herald-os .
#
# The NVIDIA image is this one with NVIDIA's driver on top: linux/image/Containerfile.nvidia, which
# also says how its build pins FEDORA_BOOTC.
ARG FEDORA_BOOTC=quay.io/fedora/fedora-bootc:44
ARG FEDORA=quay.io/fedora/fedora:44

# Desktop control (third_party/agent-desktop, docs/LINUX.md): built from the vendored crates with an
# empty CARGO_HOME, so the build reads nothing from the network once Fedora's Rust is installed.
FROM ${FEDORA} AS desktop-control
RUN dnf -y install --setopt=install_weak_deps=False rust cargo && dnf clean all
COPY third_party/agent-desktop /src
WORKDIR /src
ENV CARGO_HOME=/tmp/cargo-home
RUN cargo build --release --frozen --offline

FROM ${FEDORA_BOOTC}

ARG SHELL_TARBALL=herald-os-linux.tar.gz
COPY linux /tmp/herald-os/linux
COPY ${SHELL_TARBALL} /tmp/herald-os/shell.tar.gz

RUN bash /tmp/herald-os/linux/image/packages.sh --image /tmp/herald-os/shell.tar.gz \
 && dnf clean all \
 && rm -rf /tmp/herald-os /var/cache/* /var/log/* /var/lib/dnf

# Off PATH: only the bridge's desktop tool runs them. The clipboard helper must sit next to the main
# binary, owned by root and writable by nobody else.
COPY --from=desktop-control --chown=root:root --chmod=0755 \
     /src/target/release/agent-desktop /src/target/release/agent-desktop-linux-clipboard-owner \
     /usr/libexec/herald-os/

LABEL org.opencontainers.image.title="Herald OS" \
      org.opencontainers.image.description="An AI-native desktop built around Hermes Agent" \
      org.opencontainers.image.source="https://github.com/iamlukethedev/Herald-OS" \
      org.opencontainers.image.licenses="MIT" \
      containers.bootc="1"

RUN bootc container lint
